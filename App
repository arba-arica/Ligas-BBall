async function enviarSolicitud(e) {
  e.preventDefault();
  var errEl = document.getElementById('sol-error');
  var btn   = document.getElementById('sol-btn');
  errEl.style.display = 'none';
  btn.disabled = true; btn.textContent = 'Enviando...';
  try {
    var res = await api('crearSolicitud', {
      nombre:          document.getElementById('sol-nombre').value.trim(),
      email:           document.getElementById('sol-email').value.trim(),
      telefono:        document.getElementById('sol-tel').value.trim(),
      ciudad:          document.getElementById('sol-ciudad').value.trim(),
      deporte:         document.getElementById('sol-deporte').value.trim() || 'Basquetbol',
      descripcion:     document.getElementById('sol-desc').value.trim(),
      cant_categorias: parseInt(document.getElementById('sol-cats').value)||1,
    });
    if (res.success) {
      document.getElementById('sol-email-confirm').textContent = document.getElementById('sol-email').value;
      document.getElementById('sol-form-wrap').style.display = 'none';
      document.getElementById('sol-success').style.display = 'block';
    } else {
      errEl.textContent = res.message || 'Error al enviar';
      errEl.style.display = 'block';
    }
  } catch(err) {
    errEl.textContent = 'Error de conexion';
    errEl.style.display = 'block';
  } finally {
    btn.disabled = false; btn.textContent = 'ENVIAR SOLICITUD';
  }
}

