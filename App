function abrirEditarSancion(id,enc){var s=JSON.parse(decodeURIComponent(enc));var tipos=['Amonestación','Suspensión','Expulsión','Multa','Otra'];openInlineModal('<div class="modal-title">Editar sanción</div><div class="f-group"><label class="f-label">Jugador</label><input class="f-input" id="es-jugador" value="'+(s.jugador_nombre||'')+'"></div><div class="f-group"><label class="f-label">Tipo</label><select class="f-select" id="es-tipo">'+tipos.map(function(t){return'<option'+(t===s.tipo?' selected':'')+'>'+t+'</option>';}).join('')+'</select></div><div class="f-group"><label class="f-label">Descripción</label><textarea class="f-input" id="es-desc" rows="2">'+(s.descripcion||'')+'</textarea></div><div class="f-group"><label class="f-label">Fecha término</label><input class="f-input" id="es-fin" type="date" value="'+(s.fecha_fin||'')+'"></div><button class="f-submit" onclick="guardarEditarSancion(\''+id+'\')">GUARDAR</button>');}
