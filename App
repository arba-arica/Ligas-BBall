async function enviarSolicitud() {
  const nombre   = document.getElementById('sol-nombre').value.trim();
  const email    = document.getElementById('sol-email').value.trim();
  const telefono = document.getElementById('sol-telefono').value.trim();
  const ciudad   = document.getElementById('sol-ciudad').value.trim();
  const liga     = document.getElementById('sol-liga').value.trim();
  const temporada= document.getElementById('sol-temporada').value.trim();
  const plan     = 'por_ligas';
  const cantLigas = parseInt(document.getElementById('sol-cant-ligas').value) || 1;
  // Recolectar datos de cada liga
  const ligasDetalle = [];
  for (let i = 1; i <= Math.min(cantLigas, 10); i++) {
    ligasDetalle.push({
      nombre:    document.getElementById('sol-lg-nombre-' + i)?.value.trim() || '',
      categoria: document.getElementById('sol-lg-cat-' + i)?.value.trim() || '',
      equipos:   parseInt(document.getElementById('sol-lg-eq-' + i)?.value) || 0,
    });
  }
  const categoria = ligasDetalle.map(l => l.categoria).filter(Boolean).join(', ');
  const equipos   = ligasDetalle.reduce((s, l) => s + l.equipos, 0);
  const errEl    = document.getElementById('sol-error');

  if (!nombre || !email || !ciudad || !liga) {
    errEl.textContent = 'Completa los campos obligatorios (nombre, email, ciudad y nombre de liga)';
    errEl.style.display = 'block'; return;
  }
  errEl.style.display = 'none';

  const btn = document.getElementById('sol-btn');
  btn.textContent = 'Enviando...';
  btn.disabled = true;

  try {
    const tipo = document.getElementById('sol-tipo')?.value || 'sub_admin';
    const res = await fetch(NETLIFY_FN, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action: 'crearSolicitud',
        nombre, email, telefono, ciudad, liga,
        categoria, equipos,
        temporada, plan, tipo: 'sub_admin',
        cantLigas, ligasDetalle,
      }),
    });
    const json = await res.json();
    if (json && json.success) {
      // Mostrar confirmación
      document.getElementById('solicitud-form').innerHTML = `
        <div style="text-align:center;padding:20px 0">
          <div style="width:60px;height:60px;background:rgba(34,197,94,0.15);border:2px solid rgba(34,197,94,0.4);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div style="font-family:'Archivo Black',sans-serif;font-size:20px;color:#fff;margin-bottom:8px">¡Solicitud enviada!</div>
          <div style="font-size:13px;color:rgba(255,255,255,.5);line-height:1.6;margin-bottom:20px">
            Revisaremos tu solicitud y te contactaremos a <strong style="color:#f97316">${email}</strong> para confirmar el acceso.
          </div>
          <button onclick="hideSplashForm()" style="padding:12px 28px;border-radius:12px;background:#f97316;border:none;color:#fff;font-family:'Archivo Black',sans-serif;font-size:14px;cursor:pointer">
            Volver al inicio
          </button>
        </div>`;
    } else {
      errEl.textContent = json.message || 'Error al enviar. Intenta nuevamente.';
      errEl.style.display = 'block';
      btn.textContent = 'ENVIAR SOLICITUD';
      btn.disabled = false;
    }
  } catch(e) {
    errEl.textContent = 'Error de conexión. Intenta nuevamente.';
    errEl.style.display = 'block';
    btn.textContent = 'ENVIAR SOLICITUD';
    btn.disabled = false;
  }
}

// Cargar ciudades con ligas activas desde Supabase
async function loadCiudadesActivas() {
  try {
    const { data, error } = await _supa.from('ciudades')
      .select('id, nombre, slug')
      .eq('activo', true)
      .order('orden');
    if (error || !data || !data.length) return;
    // Verificar cuáles tienen ligas
    const { data: ligas } = await _supa.from('ligas')
      .select('id_ciudad')
      .eq('EstadoTorneo', 'Activo');
    const conLiga = new Set((ligas||[]).map(l => l.id_ciudad));
    const activas = data.filter(c => conLiga.has(c.id));
    if (!activas.length) return;
    const grid = document.getElementById('city-grid');
    const wrap = document.getElementById('city-grid-wrap');
    if (!grid || !wrap) return;
    grid.innerHTML = activas.map(c => `
      <div onclick="selectCity('${c.slug}')"
           style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:14px 12px;cursor:pointer;text-align:left;transition:all .2s"
           onmouseover="this.style.borderColor='rgba(249,115,22,0.4)'"
           onmouseout="this.style.borderColor='rgba(255,255,255,0.1)'">
        <div style="font-family:'Archivo Black',sans-serif;font-size:15px;color:#fff">${c.nombre}</div>
        <div style="font-size:10px;font-weight:700;color:#f97316;margin-top:6px;letter-spacing:.5px;text-transform:uppercase">● Ver ligas</div>
      </div>
    `).join('');
    wrap.style.display = 'block';
  } catch(e) {}
}


