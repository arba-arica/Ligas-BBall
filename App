<script>
const SUPA_URL='https://bhnmdkfvfpvvddqalazl.supabase.co';
const SUPA_ANON='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJobm1ka2Z2ZnB2dmRkcWFsYXpsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg4NDQ0NDUsImV4cCI6MjA5NDQyMDQ0NX0.6KSs8JsZG2Dt70XePy2bOrTnWazju3Y--d7OXIZg9xw';
const FN='/.netlify/functions/admin';
let SESSION=null,TORNEO_ACTUAL=null,CATEGORIAS=[],EQUIPOS={};
var CAT_ACTUAL=null,_torneoId=null,_catsCache=null;

async function supa(t,p){p=p||'';const r=await fetch(SUPA_URL+'/rest/v1/'+t+p,{headers:{apikey:SUPA_ANON,Authorization:'Bearer '+SUPA_ANON}});return r.json();}
async function api(action,data){data=data||{};const body=Object.assign({action},data);if(SESSION&&SESSION.token)body.token=SESSION.token;const r=await fetch(FN,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});return r.json();}
function toggleTheme(){
  var dark=document.documentElement.getAttribute('data-theme')==='dark';
  document.documentElement.setAttribute('data-theme',dark?'light':'dark');
  try{localStorage.setItem('ap_theme',dark?'light':'dark');}catch(e){}
  var btn=document.querySelector('.pub-nav-btns .btn-ghost');
  if(btn)btn.textContent=dark?'\u263D':'\u2600';
}
(function(){try{var t=localStorage.getItem('ap_theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();
function toast(msg,type){type=type||'';var el=document.getElementById('toast');el.textContent=msg;el.className='toast show '+type;setTimeout(function(){el.classList.remove('show');},3200);}
function openModal(id){document.getElementById(id).classList.add('open');document.body.style.overflow='hidden';}
function closeModal(id){document.getElementById(id).classList.remove('open');document.body.style.overflow='';}
function handleOverlay(e,id){if(e.target===document.getElementById(id))closeModal(id);}
document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.modal-overlay.open').forEach(function(m){m.classList.remove('open');});});
function openInlineModal(html){var o=document.getElementById('inline-modal-overlay');if(!o){o=document.createElement('div');o.id='inline-modal-overlay';o.className='modal-overlay';o.onclick=function(e){if(e.target===o)closeInlineModal();};document.body.appendChild(o);}o.innerHTML='<div class="modal" style="position:relative"><button class="modal-close" onclick="closeInlineModal()">✕</button>'+html+'</div>';o.classList.add('open');document.body.style.overflow='hidden';}
function closeInlineModal(){var o=document.getElementById('inline-modal-overlay');if(o){o.classList.remove('open');document.body.style.overflow='';}}
function showView(id){document.getElementById('pub-view').style.display=id==='pub-view'?'flex':'none';document.getElementById('torneo-view').style.display=id==='torneo-view'?'flex':'none';document.getElementById('panel-view').style.display=id==='panel-view'?'flex':'none';}
function esc(s){return(s||'').replace(/'/g,"\\'").replace(/"/g,'&quot;');}
function confirmAction(msg,cb){if(confirm(msg))cb();}
function setMain(html){document.getElementById('panel-main').innerHTML=html;}
function pbnClick(panelId,btn,navId){
  document.querySelectorAll('#'+navId+' .pbn-btn').forEach(function(b){b.classList.remove('active');});
  btn.classList.add('active');
  if(panelId==='p-mas'){
    var masHtml='<div class="modal-title" style="margin-bottom:16px">Mas opciones</div>'
      +'<div style="display:grid;gap:8px">'
      +'<button class="f-submit" style="margin:0" onclick="closeInlineModal();showPanel(\'p-fixture\',null)">Fixture</button>'
      +'<button class="f-submit" style="margin:0;background:var(--surface);color:var(--text);border:1px solid var(--border)" onclick="closeInlineModal();showPanel(\'p-resultados\',null)">Resultados</button>'
      +'<button class="f-submit" style="margin:0;background:var(--surface);color:var(--text);border:1px solid var(--border)" onclick="closeInlineModal();showPanel(\'p-categorias\',null)">Categorias</button>'
      +'<button class="f-submit" style="margin:0;background:var(--surface);color:var(--text);border:1px solid var(--border)" onclick="closeInlineModal();showPanel(\'p-noticias\',null)">Mensajes</button>'
      +'<button class="f-submit" style="margin:0;background:var(--surface);color:var(--text);border:1px solid var(--border)" onclick="closeInlineModal();showPanel(\'p-sanciones\',null)">Sanciones</button>'
      +'</div>';
    openInlineModal(masHtml);
    return;
  }
  showPanel(panelId,null);
