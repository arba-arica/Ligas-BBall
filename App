/* == EXCEL IMPORT/EXPORT == */
function xlsCellStr(v){
  if(v instanceof Date&&!isNaN(v)){
    // Excel entrega fechas/horas en UTC. Las celdas de solo-hora quedan ancladas
    // a la fecha época 1899-12-30/31 — en ese caso devolver HH:MM en vez de la fecha.
    var y=v.getUTCFullYear(),mo=v.getUTCMonth(),d=v.getUTCDate();
    if(y===1899&&mo===11&&(d===30||d===31)){
      var hh=String(v.getUTCHours()).padStart(2,'0'),mm=String(v.getUTCMinutes()).padStart(2,'0');
      return hh+':'+mm;
    }
    var m=String(mo+1).padStart(2,'0'),dd=String(d).padStart(2,'0');
    return y+'-'+m+'-'+dd;
  }
  return String(v||'').trim();
}
function xlsDescarga(rows, filename){
  // XLSX real usando SheetJS
  var ws = XLSX.utils.aoa_to_sheet(rows);
  // Ancho de columnas
  ws['!cols'] = [{wch:16},{wch:10},{wch:14},{wch:10},{wch:18},{wch:14},{wch:10},{wch:22},{wch:22}];
  var wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Fixture');
  XLSX.writeFile(wb, filename);
}

