  catch(err){errEl.textContent='Error de conexión';errEl.style.display='block';}
  finally{btn.disabled=false;btn.textContent='INGRESAR';}
}

async function enviarSolicitud(e){
  e.preventDefault();var errEl=document.getElementById('sol-error'),btn=document.getElementById('sol-btn');
  errEl.style.display='none';btn.disabled=true;btn.textContent='Enviando...';
  try{var json=await api('crearSolicitud',{nombre:document.getElementById('sol-nombre').value.trim(),email:document.getElementById('sol-email').value.trim(),telefono:document.getElementById('sol-tel').value.trim(),ciudad:document.getElementById('sol-ciudad').value.trim(),deporte:document.getElementById('sol-deporte').value.trim()||'Básquetbol',descripcion:document.getElementById('sol-desc').value.trim(),cant_categorias:parseInt(document.getElementById('sol-cats').value)||1});
