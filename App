async function cargarEquiposFixture(catId) {
  var je = await api('getEquiposCategoria', { categoria_id: catId });
  var eqs = je.data || [];
  var opts = eqs.map(function(e) { return '<option value="' + e.id + '">' + e.nombre + '</option>'; }).join('');
  var noEq = '<option value="">Sin equipos</option>';
  document.getElementById('fix-local').innerHTML  = opts || noEq;
  document.getElementById('fix-visita').innerHTML = opts || noEq;
  cargarPartidosFixture(catId);
}

async function cargarPartidosFixture(catId) {
  var lista = document.getElementById('fix-lista');
  if (!lista) return;
  var jp = await api('getPartidosCategoria', { categoria_id: catId });
  var partidos = jp.data || [];
  if (!partidos.length) { lista.innerHTML = '<div style="font-size:13px;color:var(--text2);padding:8px 0">Sin partidos programados.</div>'; return; }
  lista.innerHTML = '<div class="section-label" style="margin-top:12px">Partidos programados</div>'
    + partidos.map(function(p) {
      var loc = p.local ? p.local.nombre : '?';
      var vis = p.visita ? p.visita.nombre : '?';
      return '<div class="p-card" style="margin-bottom:8px">'
        + '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">'
        + '<div style="font-size:11px;color:var(--text3)">Partido ' + (p.nro_fecha||'') + ' · ' + (p.fase||'') + '</div>'
        + '<div style="display:flex;gap:6px">'
        + '<button class="btn-sm" onclick="editarPartido(this)" data-id="' + p.id + '">Editar</button>'
        + '<button class="btn-sm" style="color:var(--red)" onclick="eliminarPartido(this)" data-id="' + p.id + '">Eliminar</button>'
        + '</div></div>'
        + '<div style="display:flex;align-items:center;justify-content:space-between;font-weight:600;font-size:14px">'
        + '<span>' + loc + '</span><span style="color:var(--text3);font-size:12px">vs</span><span>' + vis + '</span>'
        + '</div>'
        + '<div style="font-size:11px;color:var(--text2);margin-top:6px">' + formatFecha(p.fecha,'corto') + (p.hora?' · '+p.hora:'') + (p.cancha?' · '+p.cancha:'')
        + (p.url_transmision ? ' · <a href="' + p.url_transmision + '" target="_blank" style="color:var(--blue)">Ver en vivo</a>' : '')
        + '</div></div>';
    }).join('');
}

async function crearPartido() {
  var catId  = document.getElementById('fix-cat').value;
  var local  = document.getElementById('fix-local').value;
  var visita = document.getElementById('fix-visita').value;
  if (!catId || !local || !visita) { toast('Selecciona categoria y equipos', 'err'); return; }
  if (local === visita) { toast('Los equipos no pueden ser iguales', 'err'); return; }
  var urlVal = (document.getElementById('fix-url').value||'').trim();
  var res = await api('crearPartido', {
    categoria_id:    catId,
    equipo_local:    local,
    equipo_visita:   visita,
    fecha:           document.getElementById('fix-fecha').value || null,
    hora:            document.getElementById('fix-hora').value  || null,
    cancha:          document.getElementById('fix-cancha').value.trim() || null,
    fase:            document.getElementById('fix-fase').value.trim() || 'Fase Regular',
    nro_fecha:       parseInt(document.getElementById('fix-nro').value)||1,
    url_transmision: urlVal || null,
  });
  toast(res.success ? 'Partido programado' : res.message, res.success ? 'ok' : 'err');
  if (res.success) cargarPartidosFixture(catId);
}

async function editarPartido(btn) {
  var id    = btn.dataset.id;
  var fecha = prompt('Nueva fecha (YYYY-MM-DD):') || null;
  var hora  = prompt('Nueva hora (HH:MM):')       || null;
  var cancha = prompt('Cancha:')                   || null;
  var url   = prompt('URL transmision (vacío = ninguna):') || null;
  var res = await api('actualizarPartido', { id: id, fecha: fecha, hora: hora, cancha: cancha, url_transmision: url, fase: 'Fase Regular', nro_fecha: 1 });
  toast(res.success ? 'Partido actualizado' : res.message, res.success ? 'ok' : 'err');
  var catId = document.getElementById('fix-cat') ? document.getElementById('fix-cat').value : null;
  if (res.success && catId) cargarPartidosFixture(catId);
}

async function eliminarPartido(btn) {
