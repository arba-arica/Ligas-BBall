function calcPrecio(nLigas) {
  if (nLigas <= 0) return { precio: 0, label: 'Sin ligas activas' };
  if (nLigas === 1) return { precio: 4990, label: '$4.990/mes' };
  if (nLigas <= 4) return { precio: 9990, label: '$9.990/mes' };
  return { precio: 14990, label: '$14.990/mes' };
}

