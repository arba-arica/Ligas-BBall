function abrirEditarNoticia(id,enc){var n=JSON.parse(decodeURIComponent(enc));openInlineModal('<div class="modal-title">Editar noticia</div><div class="f-group"><label class="f-label">Título</label><input class="f-input" id="en-titulo" value="'+esc(n.titulo||'')+'"></div><div class="f-group"><label class="f-label">Contenido</label><textarea class="f-input" id="en-contenido" rows="4">'+(n.contenido||'')+'</textarea></div><div class="f-group" style="display:flex;align-items:center;gap:8px"><input type="checkbox" id="en-pub" '+(n.publicado?'checked':'')+' style="width:16px;height:16px"><label style="font-size:13px;color:var(--text)">Publicado</label></div><button class="f-submit" onclick="guardarEditarNoticia(\''+id+'\',\''+(n.torneo_id||'')+'\')">GUARDAR</button>');}
async function guardarEditarNoticia(id,tid){var r=await api('actualizarNoticia',{id:id,titulo:document.getElementById('en-titulo').value.trim(),contenido:document.getElementById('en-contenido').value.trim(),publicado:document.getElementById('en-pub').checked});if(r.success){toast('Actualizada ✓','ok');closeInlineModal();if(tid)cargarNoticiasPanel(tid);}else toast(r.message,'err');}
async function eliminarNoticia(id,tid){confirmAction('¿Eliminar esta noticia?',async function(){var r=await api('eliminarNoticia',{id:id});if(r.success){toast('Eliminada','');cargarNoticiasPanel(tid);}else toast(r.message,'err');});}

