        + '<div id="fix-lista"></div>'
        + '</div>';
      if (catsFix.length) {
        loadEquiposFixture(catsFix[0].id);
        loadPartidosFixture(catsFix[0].id);
      }
      break;
    }

    case 'p-resultados': {
      const jtr = await api('getMiTorneo');
      const torneoRes = jtr.data;
      if (!torneoRes) { main.innerHTML = '<div class="panel-content"><div class="panel-title">Resultados</div><div style="padding:20px;color:var(--text2)">Sin torneo.</div></div>'; break; }
      const jcr = await api('getMisCategorias', { torneo_id: torneoRes.id });
      const catsRes = jcr.data || [];
      let resHtml = '';
      for (const cat of catsRes) {
        const jpr = await api('getPartidosCategoria', { categoria_id: cat.id, estado: 'programado' });
        const partidos = jpr.data || [];
        if (!partidos.length) continue;
        resHtml += '<div style="margin-bottom:20px"><div class="section-label">' + cat.nombre + '</div>';
        partidos.forEach(p => {
          const inp = (id, ph) => '<input type="number" id="' + id + '" min="0" style="width:44px;text-align:center;background:var(--bg3);border:1px solid var(--border2);border-radius:8px;padding:5px 4px;color:var(--text);font-size:15px;font-weight:700" placeholder="' + ph + '">';
          resHtml += '<div class="p-card" style="margin-bottom:10px">';
          resHtml += '<div style="font-size:11px;color:var(--text3);margin-bottom:8px">Partido ' + (p.nro_fecha||'') + ' · ' + formatFecha(p.fecha,'corto') + ' ' + (p.hora||'') + (p.cancha?' · '+p.cancha:'') + '</div>';
          resHtml += '<div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">';
          resHtml += '<div style="flex:1;font-weight:700;font-size:14px">' + (p.local?.nombre||'?') + '</div>';
          resHtml += inp('r-loc-' + p.id, '0') + '<span style="color:var(--text3);font-weight:700;font-size:18px"> - </span>' + inp('r-vis-' + p.id, '0');
          resHtml += '<div style="flex:1;font-weight:700;font-size:14px;text-align:right">' + (p.visita?.nombre||'?') + '</div>';
          resHtml += '</div>';
          // Cuartos
          resHtml += '<div style="background:var(--bg3);border-radius:10px;padding:10px;margin-bottom:10px">';
          resHtml += '<div style="font-size:10px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">Parciales por cuarto (opcional)</div>';
          resHtml += '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px">';
          ['1','2','3','4'].forEach(q => {
            resHtml += '<div style="text-align:center">';
            resHtml += '<div style="font-size:10px;color:var(--text3);margin-bottom:4px">Q' + q + '</div>';
            resHtml += '<div style="display:flex;gap:3px;justify-content:center">';
            resHtml += inp('q' + q + '-loc-' + p.id, '-') + inp('q' + q + '-vis-' + p.id, '-');
            resHtml += '</div></div>';
          });
          resHtml += '</div></div>';
          resHtml += '<button class="btn-sm btn-sm-primary" style="width:100%" onclick="cargarResultado(this)" data-id="' + p.id + '">✓ Guardar resultado final</button>';
          resHtml += '</div>';
        });
        resHtml += '</div>';
      }
      main.innerHTML = '<div class="panel-content"><div class="panel-title">Resultados</div><div class="panel-sub">Registra el resultado final y parciales por cuarto</div>'
        + (resHtml || '<div style="padding:20px;color:var(--text2)">Sin partidos programados pendientes.</div>')
        + '</div>';
      break;
    }

    case 'p-noticias': {
      const json = await api('getMiTorneo');
      const torneo = json.data;
      if (!torneo) { main.innerHTML = '<div class="panel-content"><div class="panel-title">Noticias</div><div style="padding:20px;color:var(--text2)">Sin torneo.</div></div>'; break; }
      const news = await supa('noticias', `?torneo_id=eq.${torneo.id}&order=created_at.desc`);
      main.innerHTML = `<div class="panel-content">
        <div class="panel-title">Noticias</div>
        <div class="p-card" style="margin-bottom:16px">
          <div class="f-group"><label class="f-label">Título</label><input class="f-input" id="news-titulo" type="text" placeholder="Título de la noticia"></div>
          <div class="f-group"><label class="f-label">Contenido</label><textarea class="f-input" id="news-contenido" rows="3" style="resize:none" placeholder="Contenido..."></textarea></div>
          <button class="btn-sm btn-sm-primary" onclick="crearNoticia('${torneo.id}')">Publicar noticia</button>
        </div>
        ${!(news||[]).length ? '<div style="font-size:13px;color:var(--text2)">Sin noticias.</div>' :
          (news||[]).map(n => `
          <div class="p-card" style="margin-bottom:8px">
            <div style="display:flex;justify-content:space-between;align-items:flex-start">
              <div><div style="font-weight:700;font-size:14px;color:var(--text)">${n.titulo}</div>
              <div style="font-size:12px;color:var(--text2);margin-top:4px">${n.contenido||''}</div></div>
              <button class="btn-sm btn-sm-danger" onclick="eliminarNoticia('${n.id}','${torneo.id}')">✕</button>
            </div>
          </div>`).join('')}
      </div>`;
      break;
    }

    case 'p-sanciones': {
      const jts = await api('getMiTorneo');
      const torneoSan = jts.data;
      if (!torneoSan) { main.innerHTML = '<div class="panel-content"><div class="panel-title">Sanciones</div><div style="padding:20px;color:var(--text2)">Sin torneo.</div></div>'; break; }
      const jcs = await api('getMisCategorias', { torneo_id: torneoSan.id });
      const catsSan = jcs.data || [];
      const catOptsSan = catsSan.map(c => '<option value="' + c.id + '">' + c.nombre + '</option>').join('');
      // Cargar sanciones existentes
      let sanHtml = '';
      for (const cat of catsSan) {
        const jsan = await api('getSancionesCategoria', { categoria_id: cat.id });
        const sanciones = jsan.data || [];
        if (!sanciones.length) continue;
        sanHtml += '<div style="margin-bottom:16px"><div class="section-label">' + cat.nombre + '</div>';
        sanciones.forEach(s => {
          sanHtml += '<div class="p-card" style="margin-bottom:8px">';
          sanHtml += '<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px">';
          sanHtml += '<div style="flex:1">';
          sanHtml += '<div style="font-weight:700;color:var(--text)">' + (s.jugador_nombre||'Sin nombre') + '</div>';
          sanHtml += '<div style="font-size:12px;color:var(--text2)">' + (s.tipo||'') + (s.descripcion?' · '+s.descripcion:'') + '</div>';
          if (s.fecha_fin) sanHtml += '<div style="font-size:11px;color:var(--orange);margin-top:2px">Hasta: ' + formatFecha(s.fecha_fin,'corto') + '</div>';
          if (s.fecha_apelacion) sanHtml += '<div style="font-size:11px;color:var(--blue);margin-top:2px">Apelación: ' + formatFecha(s.fecha_apelacion,'corto') + '</div>';
          sanHtml += '</div>';
          sanHtml += '<div style="display:flex;gap:6px;flex-shrink:0">';
            sanHtml += '<button class="btn-sm" onclick="editarSancionModal(this)" data-id="' + s.id + '" data-jug="' + (s.jugador_nombre||"").replace(/"/g,"&quot;") + '" data-tipo="' + (s.tipo||"") + '" data-desc="' + (s.descripcion||"") + '" data-fin="' + (s.fecha_fin||"") + '" data-apel="' + (s.fecha_apelacion||"") + '">Editar</button>';
            sanHtml += '<button class="btn-sm btn-sm-danger" onclick="eliminarSancion(this)" data-id="' + s.id + '">Eliminar</button>';
          sanHtml += '</div></div></div>';
        });
        sanHtml += '</div>';
      }
      main.innerHTML = '<div class="panel-content">'
        + '<div class="panel-title">Sanciones</div>'
        + '<div class="p-card" style="margin-bottom:16px">'
        + '<div class="f-group"><label class="f-label">Categoría</label><select class="f-select" id="san-cat">' + catOptsSan + '</select></div>'
        + '<div class="f-row"><div class="f-group"><label class="f-label">Jugador</label><input class="f-input" id="san-jug" type="text" placeholder="Nombre del jugador"></div>'
        + '<div class="f-group"><label class="f-label">Tipo</label><input class="f-input" id="san-tipo" type="text" placeholder="Ej: Técnica, Expulsión"></div></div>'
        + '<div class="f-group"><label class="f-label">Descripción</label><input class="f-input" id="san-desc" type="text" placeholder="Detalle de la sanción"></div>'
        + '<div class="f-row"><div class="f-group"><label class="f-label">Fecha fin sanción</label><input class="f-input" id="san-fin" type="date"></div>'
        + '<div class="f-group"><label class="f-label">Fecha apelación</label><input class="f-input" id="san-apel" type="date"></div></div>'
        + '<button class="btn-sm btn-sm-primary" onclick="crearSancion()">+ Registrar sanción</button>'
        + '</div>'
        + (sanHtml || '')
        + '</div>';
      break;
    }

    default:
      main.innerHTML = '<div class="panel-content"><div style="color:var(--text2)">Panel en construcción.</div></div>';
  }
}

