<script>
// ── CONFIG ────────────────────────────────────────────────────────────────────
const SUPA_URL  = 'https://bhnmdkfvfpvvddqalazl.supabase.co';
const SUPA_ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJobm1ka2Z2ZnB2dmRkcWFsYXpsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg4NDQ0NDUsImV4cCI6MjA5NDQyMDQ0NX0.6KSs8JsZG2Dt70XePy2bOrTnWazju3Y--d7OXIZg9xw';
const FN = '/.netlify/functions/admin';

// Estado de sesión
let SESSION = null; // { rol, token, nombre, org_id, ciudad }
let TORNEO_ACTUAL = null;
let CATEGORIAS = [];
let EQUIPOS = {};

// ── SUPABASE FETCH ────────────────────────────────────────────────────────────
async function supa(table, params = '') {
  const res = await fetch(`${SUPA_URL}/rest/v1/${table}${params}`, {
    headers: { apikey: SUPA_ANON, Authorization: 'Bearer ' + SUPA_ANON }
  });
  return res.json();
}

// ── API CALL ──────────────────────────────────────────────────────────────────
async function api(action, data = {}) {
  const body = { action, ...data };
  if (SESSION?.token) body.token = SESSION.token;
  const res = await fetch(FN, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  return res.json();
}

// ── TOAST ─────────────────────────────────────────────────────────────────────
function toast(msg, type = '') {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = 'toast show ' + type;
  setTimeout(() => el.classList.remove('show'), 3000);
}

// ── MODALES ───────────────────────────────────────────────────────────────────
function openModal(id) {
  document.getElementById(id).classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeModal(id) {
  document.getElementById(id).classList.remove('open');
  document.body.style.overflow = '';
}
function handleOverlay(e, id) {
  if (e.target === document.getElementById(id)) closeModal(id);
}
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.open').forEach(m => m.classList.remove('open'));
});

// ── TEMA ──────────────────────────────────────────────────────────────────────
function toggleTheme() {
  const dark = document.documentElement.getAttribute('data-theme') === 'dark';
  document.documentElement.setAttribute('data-theme', dark ? 'light' : 'dark');
  try { localStorage.setItem('ap_theme', dark ? 'light' : 'dark'); } catch(e) {}
}
(function() {
  try { const t = localStorage.getItem('ap_theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch(e) {}
})();

// ── VISTAS ────────────────────────────────────────────────────────────────────
function showView(id) {
  document.getElementById('pub-view').style.display   = id === 'pub-view'    ? 'flex'  : 'none';
  document.getElementById('torneo-view').style.display = id === 'torneo-view' ? 'flex'  : 'none';
  document.getElementById('panel-view').style.display  = id === 'panel-view'  ? 'flex'  : 'none';
}

// ── VISTA PÚBLICA — TORNEOS ───────────────────────────────────────────────────
async function loadTorneos() {
  const list = document.getElementById('torneos-list');
  try {
    const torneos = await supa('torneos', '?select=id,nombre,ciudad,deporte,temporada,descripcion,visible&visible=eq.true&estado=neq.eliminado&order=created_at.desc');
    if (!torneos || torneos.error || !torneos.length) {
      list.innerHTML = `<div style="text-align:center;padding:48px 20px">
        <div style="font-size:48px;margin-bottom:16px;opacity:.2">🏀</div>
        <div style="font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:900;color:var(--text);margin-bottom:8px">Sin torneos activos aún</div>
        <div style="font-size:13px;color:var(--text2);margin-bottom:20px">Sé el primero en publicar tu torneo</div>
        <button class="btn-solid btn-orange" onclick="openModal('modal-solicitud')" style="padding:12px 28px;font-size:14px;border-radius:12px">PUBLICAR MI LIGA →</button>
      </div>`;
      return;
    }
    list.innerHTML = torneos.map(t => `
      <div class="torneo-card" onclick="abrirTorneo('${t.id}','${esc(t.nombre)}','${esc(t.ciudad)}','${esc(t.temporada||'')}')">
        <div class="torneo-card-header">
          <div>
            <div class="torneo-nombre">${t.nombre}</div>
            <div class="torneo-ciudad">📍 ${t.ciudad} ${t.temporada ? '· ' + t.temporada : ''}</div>
          </div>
          <span class="badge badge-active">● Activo</span>
        </div>
        ${t.descripcion ? `<div style="font-size:13px;color:var(--text2);margin-bottom:10px">${t.descripcion}</div>` : ''}
        <div style="font-size:11px;color:var(--text3)">${t.deporte || 'Básquetbol'} · Toca para ver tabla y fixture →</div>
      </div>
    `).join('');
  } catch(e) {
    list.innerHTML = '<div style="text-align:center;padding:32px;color:var(--text2);font-size:13px">Error al cargar torneos</div>';
  }
}

function esc(str) { return (str||'').replace(/'/g, "\\'").replace(/"/g, '&quot;'); }

// ── VISTA TORNEO ──────────────────────────────────────────────────────────────
async function abrirTorneo(id, nombre, ciudad, temporada) {
  TORNEO_ACTUAL = { id, nombre, ciudad, temporada };
  document.getElementById('tv-nombre').textContent = nombre;
  document.getElementById('tv-ciudad').textContent = '📍 ' + ciudad + (temporada ? ' · ' + temporada : '');
  showView('torneo-view');
  // Reset tabs
  document.querySelectorAll('.tv-tab').forEach(b => b.classList.remove('active'));
  document.querySelector('.tv-tab').classList.add('active');
  ['tab-posiciones','tab-fixture','tab-resultados','tab-nomina','tab-noticias','tab-sanciones'].forEach(t => {
    document.getElementById(t).style.display = t === 'tab-posiciones' ? 'block' : 'none';
    document.getElementById(t).innerHTML = '';
  });
  await loadCategorias(id);
}

function volverPublico() {
  TORNEO_ACTUAL = null;
  showView('pub-view');
}

function showTab(tabId, btn) {
  document.querySelectorAll('.tv-tab').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  ['tab-posiciones','tab-fixture','tab-resultados','tab-nomina','tab-noticias','tab-sanciones'].forEach(t => {
    document.getElementById(t).style.display = t === tabId ? 'block' : 'none';
  });
  if (!TORNEO_ACTUAL) return;
  if (tabId === 'tab-posiciones') renderPosiciones();
  if (tabId === 'tab-fixture')    renderFixture();
  if (tabId === 'tab-resultados') renderResultados();
  if (tabId === 'tab-nomina')     renderNomina();
  if (tabId === 'tab-noticias')   renderNoticias();
  if (tabId === 'tab-sanciones')  renderSanciones();
}

async function loadCategorias(torneo_id) {
  const cats = await supa('categorias', '?torneo_id=eq.' + torneo_id + '&activo=eq.true&order=orden');
  CATEGORIAS = cats || [];
  EQUIPOS = {};
  // Llenar selector de categorías
  const sel = document.getElementById('tv-cat-select');
  if (sel) {
    if (!CATEGORIAS.length) {
      sel.innerHTML = '<option value="">Sin categorías</option>';
    } else {
      sel.innerHTML = CATEGORIAS.map(c => '<option value="' + c.id + '">' + c.nombre + '</option>').join('');
    }
  }
  // Precargar equipos de la primera categoría
  if (CATEGORIAS.length) {
    const eqs = await supa('equipos', '?categoria_id=eq.' + CATEGORIAS[0].id + '&activo=eq.true&order=nombre');
    EQUIPOS[CATEGORIAS[0].id] = eqs || [];
  }
  renderTabActual();
}

function getCatActual() {
  const sel = document.getElementById('tv-cat-select');
  if (!sel || !sel.value) return CATEGORIAS[0] || null;
  return CATEGORIAS.find(c => c.id === sel.value) || CATEGORIAS[0] || null;
}

async function cambiarCategoria(catId) {
  // Precargar equipos si no están en caché
  if (!EQUIPOS[catId]) {
    const eqs = await supa('equipos', '?categoria_id=eq.' + catId + '&activo=eq.true&order=nombre');
    EQUIPOS[catId] = eqs || [];
  }
  renderTabActual();
}

function renderTabActual() {
  const activeTab = document.querySelector('.tv-tab.active');
  if (!activeTab) return;
  const onclick = activeTab.getAttribute('onclick');
  if (onclick.includes('posiciones')) renderPosiciones();
  else if (onclick.includes('fixture'))    renderFixture();
  else if (onclick.includes('resultados')) renderResultados();
  else if (onclick.includes('nomina'))     renderNomina();
  else if (onclick.includes('noticias'))   renderNoticias();
  else if (onclick.includes('sanciones'))  renderSanciones();
}

async function renderPosiciones() {
  const el = document.getElementById('tab-posiciones');
  const cat = getCatActual();
  if (!cat) { el.innerHTML = '<div style="padding:20px;color:var(--text2);font-size:13px">Sin categorías.</div>'; return; }
  el.innerHTML = '<div style="padding:20px;text-align:center;color:var(--text2);font-size:13px">Cargando tabla...</div>';
  const rows = await supa('standings', '?categoria_id=eq.' + cat.id + '&order=pts.desc,dg.desc,gf.desc');
  if (!rows || !rows.length) {
    el.innerHTML = '<div style="padding:20px;color:var(--text2);font-size:13px;text-align:center">Sin partidos finalizados aún en ' + cat.nombre + '.</div>';
    return;
  }
  let h = '<div style="overflow-x:auto"><table class="st-table"><thead><tr>'
    + '<th>#</th><th>Equipo</th><th>PJ</th><th>PG</th><th>PE</th><th>PP</th><th>GF</th><th>GC</th><th>DIF</th><th>PTS</th>'
    + '</tr></thead><tbody>';
  rows.forEach((r, i) => {
    const dg = Number(r.dg) || 0;
    const rkCls = i===0?'rk-1':i===1?'rk-2':i===2?'rk-3':'';
    h += '<tr>'
      + '<td><span class="rk ' + rkCls + '">' + (i+1) + '</span></td>'
      + '<td><span class="color-dot" style="background:' + (r.color||'#475569') + '"></span>' + r.equipo_nombre + '</td>'
      + '<td>' + r.pj + '</td><td>' + r.pg + '</td><td>' + r.pe + '</td><td>' + r.pp + '</td>'
      + '<td>' + r.gf + '</td><td>' + r.gc + '</td>'
      + '<td class="' + (dg>0?'dif-pos':dg<0?'dif-neg':'') + '">' + (dg>0?'+':'') + dg + '</td>'
      + '<td><span class="pts-cell">' + r.pts + '</span></td>'
      + '</tr>';
  });
  h += '</tbody></table></div>';
  el.innerHTML = h;
}

async function renderFixture() {
  const el = document.getElementById('tab-fixture');
  const cat = getCatActual();
  if (!cat) { el.innerHTML = '<div style="padding:20px;color:var(--text2)">Sin categorías.</div>'; return; }
  el.innerHTML = '<div style="padding:20px;text-align:center;color:var(--text2);font-size:13px">Cargando fixture...</div>';
  const partidos = await supa('partidos', '?categoria_id=eq.' + cat.id
    + '&select=*,local:equipo_local(nombre,color_local),visita:equipo_visita(nombre,color_local)'
    + '&estado=neq.finalizado&order=nro_fecha,fecha,hora');
  if (!partidos || !partidos.length) {
    el.innerHTML = '<div style="padding:20px;color:var(--text2);font-size:13px;text-align:center">Sin partidos programados en ' + cat.nombre + '.</div>';
    return;
  }
  const grupos = {};
  partidos.forEach(p => { const k = 'Fecha ' + (p.nro_fecha||'') + (p.fecha?' · '+formatFecha(p.fecha):''); if(!grupos[k]) grupos[k]=[]; grupos[k].push(p); });
