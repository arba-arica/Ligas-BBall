async function crearCategoria(torneo_id) {
  const nombre = document.getElementById('cat-nombre')?.value.trim();
  if (!nombre) { toast('Ingresa el nombre de la categoría', 'err'); return; }
  const ptv = parseInt(document.getElementById('cat-ptv')?.value) || 2;
  const ptd = parseInt(document.getElementById('cat-ptd')?.value) || 1;
  const json = await api('crearCategoria', { torneo_id, nombre, pts_victoria: ptv, pts_derrota: ptd });
  toast(json.success ? '✓ Categoría creada' : json.message, json.success ? 'ok' : 'err');
  if (json.success) renderPanel('p-categorias');
}

