async function guardarStats() {
  const jugadorId = document.getElementById('st-jugador')?.value;
  const ligaId    = document.getElementById('st-liga')?.value;
  if (!jugadorId) return toast('Selecciona un jugador','err');
  if (!ligaId)    return toast('Selecciona una liga','err');
  const pts1p = parseInt(document.getElementById('st-1p')?.value) || 0;
  const pts2p = parseInt(document.getElementById('st-2p')?.value) || 0;
  const pts3p = parseInt(document.getElementById('st-3p')?.value) || 0;
  const pj    = parseInt(document.getElementById('st-pj')?.value) || 0;
  const total = pts1p + (pts2p*2) + (pts3p*3);
  showConfirmV3(
    `¿Guardar estadísticas?`,
    `${pts1p}×1P + ${pts2p}×2P + ${pts3p}×3P = ${total} PTS · ${pj} partidos`,
    async () => {
      const res = await fetch(NETLIFY_FN, {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({
          action: 'updateStats', adminPassword: adminPass,
          idJugador: jugadorId, idLiga: ligaId,
          pts1p, pts2p, pts3p, partidos: pj,
        }),
      });
      const json = JSON.parse(await res.text());
      if (json?.success) { toast('✓ Estadísticas guardadas','ok'); }
      else toast(json?.message||'Error','err');
    }, 'ok'
  );
}

