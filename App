async function loginAdmin(e){
  e.preventDefault();var errEl=document.getElementById('admin-error'),btn=document.getElementById('admin-btn');
  errEl.style.display='none';btn.disabled=true;btn.textContent='Ingresando...';
  try{var json=await api('checkLogin',{email:document.getElementById('admin-email').value.trim(),password:document.getElementById('admin-pass').value});
    if(json.success){SESSION={rol:'admin',token:json.token,nombre:json.nombre,email:json.email};closeModal('modal-login-admin');initPanel();}
    else{errEl.textContent=json.message||'Email o contraseña incorrectos';errEl.style.display='block';}}
  catch(err){errEl.textContent='Error de conexión';errEl.style.display='block';}
  finally{btn.disabled=false;btn.textContent='INGRESAR';}
}

