function generarReporteTemporada(tempId, tempNombre) {
  const nombre = tempNombre || document.getElementById('temp-nombre')?.value.trim() || 'Temporada BBALL 2026';
  // Filtrar ligas de esta temporada
  const ligasSel = D.ligas.filter(l => l.id_temporada === tempId || !l.id_temporada);
  const ligasSelIds = ligasSel.map(l => l.ID);
  if (!ligasSelIds.length) return toast('Sin ligas en esta temporada','err');
  const btn = document.getElementById('btn-reporte-temporada');
  btn.innerHTML = '<div style="width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;display:inline-block;margin-right:6px"></div> Generando PDF...';
  btn.disabled = true;

  try {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ orientation:'portrait', unit:'mm', format:'a4' });
    const fecha = new Date().toLocaleDateString('es-CL', {day:'2-digit',month:'long',year:'numeric'});
    const totalEquipos  = D.equipos.filter(e => ligasSelIds.includes(e.ID_Liga)).length;
    const totalPartidos = D.partidos.filter(p => ligasSelIds.includes(p.ID_Liga) && p.Estado==='Finalizado').length;
    const totalJugadores = D.personas.filter(p => ligasSelIds.some(lid => D.equipos.find(e=>e.ID===p.id_equipo)?.ID_Liga===lid)).length;
    const totalSanciones = D.sanciones.filter(s => ligasSelIds.includes(s.ID_Liga)).length;

    // ── PORTADA ──────────────────────────────────────────────────────────────
    doc.setFillColor(30,58,138);
    doc.rect(0,0,210,80,'F');
    doc.setTextColor(255,255,255);
    doc.setFontSize(11); doc.setFont('helvetica','normal');
    doc.text('ASOCIACIÓN DEPORTIVA REGIONAL DE BÁSQUETBOL ARICA', 105, 20, {align:'center'});
    doc.setFontSize(22); doc.setFont('helvetica','bold');
    doc.text('ACTIVA PLAY', 105, 32, {align:'center'});
    doc.setFontSize(14); doc.setFont('helvetica','normal');
    doc.text('Reporte de Cierre de Temporada', 105, 43, {align:'center'});
    doc.setFontSize(18); doc.setFont('helvetica','bold');
    doc.text(nombre, 105, 58, {align:'center'});
    doc.setFontSize(10); doc.setFont('helvetica','normal');
    doc.text(`Generado: ${fecha}`, 105, 70, {align:'center'});

    // ── RESUMEN GENERAL ───────────────────────────────────────────────────────
    doc.setTextColor(30,58,138);
    doc.setFontSize(13); doc.setFont('helvetica','bold');
    doc.text('RESUMEN GENERAL', 14, 95);
    doc.setDrawColor(30,58,138); doc.setLineWidth(0.5);
    doc.line(14, 97, 196, 97);

    doc.autoTable({
      startY: 100,
      body: [
        ['Ligas disputadas', ligasSel.length],
        ['Equipos participantes', totalEquipos],
        ['Partidos finalizados', totalPartidos],
        ['Jugadores inscritos', totalJugadores],
        ['Sanciones aplicadas', totalSanciones],
      ],
      styles: { fontSize:11, cellPadding:4 },
      columnStyles: { 0:{fontStyle:'bold',cellWidth:120}, 1:{halign:'center',fontStyle:'bold',fontSize:13,textColor:[30,58,138]} },
      alternateRowStyles: { fillColor:[239,246,255] },
    });

    // ── TABLAS DE POSICIONES ─────────────────────────────────────────────────
    doc.addPage();
    let y = 14;
    doc.setTextColor(30,58,138);
    doc.setFontSize(13); doc.setFont('helvetica','bold');
    doc.text('TABLA DE POSICIONES', 14, y); y += 4;
    doc.setLineWidth(0.5); doc.line(14, y, 196, y); y += 6;

    ligasSel.forEach(l => {
      const standings = calcStandings(l.ID);
      if (!standings.length) return;
      doc.setFontSize(10); doc.setFont('helvetica','bold');
      doc.setTextColor(30,58,138);
      doc.text(`${l.NombreFantasia} — ${l.Categoria}`, 14, y+4);
      doc.autoTable({
        startY: y+7,
        head:[['Pos','Equipo','PJ','G','P','Pts','PF','PC','Dif']],
        body: standings.map((s,i) => [i+1, s.NombreEquipo, s.PJ, s.PG, s.PP, s.Puntos, s.GF, s.GC, (s.DG>0?'+':'')+s.DG]),
        styles:{fontSize:9,cellPadding:2.5},
        headStyles:{fillColor:[30,58,138],textColor:255,fontStyle:'bold'},
        alternateRowStyles:{fillColor:[239,246,255]},
        columnStyles:{0:{halign:'center',cellWidth:12},2:{halign:'center'},3:{halign:'center'},4:{halign:'center'},5:{halign:'center',fontStyle:'bold'},6:{halign:'center'},7:{halign:'center'},8:{halign:'center'}},
      });
      y = doc.lastAutoTable.finalY + 8;
      if (y > 260) { doc.addPage(); y = 14; }
    });

    // ── RESULTADOS ───────────────────────────────────────────────────────────
    doc.addPage(); y = 14;
    doc.setTextColor(30,58,138);
    doc.setFontSize(13); doc.setFont('helvetica','bold');
    doc.text('RESULTADOS DE LA TEMPORADA', 14, y); y += 4;
    doc.setLineWidth(0.5); doc.line(14, y, 196, y); y += 6;

    ligasSel.forEach(l => {
      const partidos = D.partidos.filter(p => p.ID_Liga===l.ID && p.Estado==='Finalizado');
      if (!partidos.length) return;
      doc.setFontSize(10); doc.setFont('helvetica','bold'); doc.setTextColor(30,58,138);
      doc.text(`${l.NombreFantasia} — ${l.Categoria}`, 14, y+4);
      doc.autoTable({
        startY: y+7,
        head:[['Fecha','Local','PL','—','PV','Visita','Fase']],
        body: partidos.map(p => [
          fmtDate(p.Fecha), teamName(p.ID_EquipoLocal),
          String(p.GolesLocal??''), '-', String(p.GolesVisita??''),
          teamName(p.ID_EquipoVisita), p.Fase||'—'
        ]),
        styles:{fontSize:8.5,cellPadding:2},
        headStyles:{fillColor:[30,58,138],textColor:255,fontStyle:'bold'},
        alternateRowStyles:{fillColor:[239,246,255]},
        columnStyles:{2:{halign:'right',fontStyle:'bold'},3:{halign:'center'},4:{halign:'left',fontStyle:'bold'}},
      });
      y = doc.lastAutoTable.finalY + 8;
      if (y > 260) { doc.addPage(); y = 14; }
    });

    // ── SANCIONES ────────────────────────────────────────────────────────────
    const sanciones = D.sanciones.filter(s => ligasSelIds.includes(s.ID_Liga));
    if (sanciones.length) {
      doc.addPage(); y = 14;
      doc.setTextColor(30,58,138);
      doc.setFontSize(13); doc.setFont('helvetica','bold');
      doc.text('SANCIONES DE LA TEMPORADA', 14, y); y += 4;
      doc.setLineWidth(0.5); doc.line(14, y, 196, y); y += 6;
      doc.autoTable({
        startY: y,
        head:[['Jugador','Equipo','Liga','Tipo falta','Sanción']],
        body: sanciones.map(s => {
          const eq = D.equipos.find(e=>e.ID===s.ID_Equipo);
          const lg = D.ligas.find(l=>l.ID===s.ID_Liga);
          return [s.NombreJugador, eq?.NombreEquipo||'—', lg?.NombreFantasia||'—', s.TipoFalta||'—', s.Sancion||'—'];
        }),
        styles:{fontSize:9,cellPadding:2.5},
        headStyles:{fillColor:[220,38,38],textColor:255,fontStyle:'bold'},
        alternateRowStyles:{fillColor:[254,242,242]},
      });
    }

    // ── NÓMINAS ──────────────────────────────────────────────────────────────
    const equiposSel = D.equipos.filter(e => ligasSelIds.includes(e.ID_Liga));
    if (D.personas.length && equiposSel.length) {
      doc.addPage(); y = 14;
      doc.setTextColor(30,58,138);
      doc.setFontSize(13); doc.setFont('helvetica','bold');
      doc.text('NÓMINAS DE JUGADORES', 14, y); y += 4;
      doc.setLineWidth(0.5); doc.line(14, y, 196, y); y += 6;

      ligasSel.forEach(l => {
        const eqsLiga = D.equipos.filter(e=>e.ID_Liga===l.ID);
        eqsLiga.forEach(eq => {
          const personas = D.personas.filter(p=>p.id_equipo===eq.ID);
          if (!personas.length) return;
          doc.setFontSize(9); doc.setFont('helvetica','bold'); doc.setTextColor(30,58,138);
          doc.text(`${eq.NombreEquipo} — ${l.NombreFantasia}`, 14, y+4);
          doc.autoTable({
            startY: y+7,
            head:[['N°','Nombre','Rol','Categoría','Año nac.','RUT','Fed.']],
            body: personas.map((p,i) => [
              i+1, p.nombre_completo,
              p.rol==='jugador'?'Jugador':p.rol==='cuerpo_tecnico'?'C.Técnico':'Delegado',
              p.categoria||'—',
              p.fecha_nacimiento ? new Date(p.fecha_nacimiento).getFullYear() : '—',
              p.rut||'—', p.federado?'Sí':'No'
            ]),
            styles:{fontSize:8,cellPadding:2},
            headStyles:{fillColor:[30,58,138],textColor:255,fontStyle:'bold'},
            alternateRowStyles:{fillColor:[239,246,255]},
            columnStyles:{0:{halign:'center',cellWidth:10},4:{halign:'center'},6:{halign:'center'}},
          });
          y = doc.lastAutoTable.finalY + 6;
          if (y > 260) { doc.addPage(); y = 14; }
        });
      });
    }

    // ── TOP ANOTADORES ────────────────────────────────────────────────────────
    if (D.stats && D.stats.length) {
      const statsConPts = D.stats.map(s => {
        const p = D.personas.find(x=>x.id===s.id_jugador);
        const eq = p ? D.equipos.find(e=>e.ID===p.id_equipo) : null;
        const total = (s.pts_1p||0) + (s.pts_2p||0)*2 + (s.pts_3p||0)*3;
        return { nombre: p?.nombre_completo||'—', equipo: eq?.NombreEquipo||'—', pj: s.partidos||0, tl:s.pts_1p||0, dos:s.pts_2p||0, tres:s.pts_3p||0, total };
      }).filter(s=>s.total>0).sort((a,b)=>b.total-a.total).slice(0,20);

      if (statsConPts.length) {
        doc.addPage(); y = 14;
        doc.setTextColor(30,58,138);
        doc.setFontSize(13); doc.setFont('helvetica','bold');
        doc.text('TOP ANOTADORES', 14, y); y += 4;
        doc.setLineWidth(0.5); doc.line(14, y, 196, y); y += 6;
        doc.autoTable({
          startY: y,
          head:[['Pos','Jugador','Equipo','PJ','TL','2P','3P','Total PTS','Prom']],
          body: statsConPts.map((s,i) => [
            i+1, s.nombre, s.equipo, s.pj, s.tl, s.dos, s.tres, s.total,
            s.pj>0 ? (s.total/s.pj).toFixed(1) : '—'
          ]),
          styles:{fontSize:9,cellPadding:2.5},
          headStyles:{fillColor:[30,58,138],textColor:255,fontStyle:'bold'},
          alternateRowStyles:{fillColor:[239,246,255]},
          columnStyles:{0:{halign:'center',cellWidth:12},3:{halign:'center'},4:{halign:'center'},5:{halign:'center'},6:{halign:'center'},7:{halign:'center',fontStyle:'bold'},8:{halign:'center'}},
        });
      }
    }

    // ── PIÉ DE PÁGINA EN TODAS LAS PÁGINAS ───────────────────────────────────
    const totalPags = doc.getNumberOfPages();
    for (let i = 1; i <= totalPags; i++) {
      doc.setPage(i);
      doc.setFontSize(8); doc.setFont('helvetica','normal');
      doc.setTextColor(150,150,150);
      doc.text(`ACTIVA PLAY · ${nombre} · contacto@activaplay.cl`, 14, 290);
      doc.text(`Pág. ${i} / ${totalPags}`, 196, 290, {align:'right'});
      doc.setDrawColor(200,200,200); doc.setLineWidth(0.3);
      doc.line(14, 287, 196, 287);
    }

    const nombreArchivo = `BBALL_Reporte_${nombre.replace(/\s+/g,'_').replace(/[^a-zA-Z0-9_]/g,'')}_${new Date().getFullYear()}.pdf`;
    doc.save(nombreArchivo);
    toast('✓ Reporte descargado','ok');
  } catch(e) {
    toast('Error: ' + e.message,'err');
  } finally {
    btn.innerHTML = '📄 Generar reporte de temporada';
    btn.disabled = false;
  }
}
