      html += `<div class="sched-card${isProximo?' proximo':''}">
        <div class="sched-top">
          <span class="sched-num${isProximo?' proximo-badge':''}">${isProximo?'<span class="proximo-dot"></span>':''}Partido ${p.Partidos||''}</span>
          ${p.Fase && p.Fase!=='Regular' ? `<span style="font-size:10px;font-weight:700;color:var(--orange);background:var(--orange-light);padding:2px 8px;border-radius:100px">${p.Fase}</span>` : ''}
        </div>
