async function uploadImagen(file, bucket) {
  if (!file) return null;
  if (file.size > 3 * 1024 * 1024) { toast('La imagen supera 3MB','err'); return null; }
  const ext    = file.name.split('.').pop().toLowerCase().replace(/jpeg/,'jpg') || 'jpg';
  const nombre = `img-${Date.now()}.${ext}`;
  toast('Subiendo imagen...', 'ok');
  const { data, error } = await _supa.storage.from(bucket).upload(nombre, file, {
    contentType: file.type,
    upsert: true,
  });
  if (error) {
    console.error('Storage error:', error);
    toast('Error: ' + error.message, 'err');
    return null;
  }
  const { data: urlData } = _supa.storage.from(bucket).getPublicUrl(nombre);
  console.log('URL pública:', urlData.publicUrl);
  toast('✓ Imagen subida', 'ok');
  return urlData.publicUrl;
}

function comprimirImagen(file, calidad) {
  return new Promise((resolve) => {
    const reader = new FileReader();
    reader.onload = e => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        // Máximo 1280px de ancho manteniendo proporción
        const maxW = 1280;
        const ratio = Math.min(1, maxW / img.width);
        canvas.width  = img.width  * ratio;
        canvas.height = img.height * ratio;
        canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
        canvas.toBlob(blob => resolve(blob), 'image/jpeg', calidad);
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  });
}

function previewFoto(input, imgId, previewId) {
  const file = input.files[0];
  if (!file) return;
  if (file.size > 3 * 1024 * 1024) { toast('La imagen supera 3MB','err'); input.value = ''; return; }
  const reader = new FileReader();
  reader.onload = e => {
    document.getElementById(imgId).src = e.target.result;
    document.getElementById(previewId).style.display = 'block';
  };
  reader.readAsDataURL(file);
}

