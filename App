function renderMatchCard(p) {
  const local  = p.local  || { nombre: '?', color_local: '#475569' };
  const visita = p.visita || { nombre: '?', color_local: '#475569' };
  const finalizado = p.estado === 'finalizado';
  const enVivo = p.estado === 'en_vivo';
  const locWin = finalizado && p.pts_local > p.pts_visita;
  const visWin = finalizado && p.pts_visita > p.pts_local;
  return `<div class="match-card">
    <div class="match-fase">${p.fase||'Fase Regular'} ${p.cancha ? '· ' + p.cancha : ''}</div>
    <div class="match-teams">
      <div class="match-team">
        <div class="match-team-name ${locWin?'win':''}">${local.nombre}</div>
      </div>
      <div>
        ${finalizado
          ? `<div class="match-score"><span class="${locWin?'score-win':'score-lose'}">${p.pts_local}</span> <span style="font-size:14px;color:var(--text3)">-</span> <span class="${visWin?'score-win':'score-lose'}">${p.pts_visita}</span></div>
             <div style="text-align:center;margin-top:4px"><span class="badge badge-final">Final</span></div>`
          : enVivo
          ? `<div class="match-vs"><span class="live-dot"></span>EN VIVO</div>`
          : `<div class="match-vs" style="font-size:12px">${p.hora||'--:--'}</div>
             <div style="text-align:center;margin-top:4px"><span class="badge badge-prox">${formatFecha(p.fecha,'corto')}</span></div>`}
      </div>
      <div class="match-team" style="text-align:right">
        <div class="match-team-name ${visWin?'win':''}">${visita.nombre}</div>
      </div>
    </div>
  </div>`;
}

