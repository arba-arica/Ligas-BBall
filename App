  var h='<div class="panel-content"><div class="panel-title">Solicitudes</div><div class="panel-sub">'+pend.length+' pendiente(s)</div>';
  if(!r.data.length){h+='<div class="p-card" style="text-align:center;padding:32px;color:var(--text2)">Sin solicitudes</div>';}
  else r.data.forEach(function(s){
