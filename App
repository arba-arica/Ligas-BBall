function setCantLigas(n) {
  _cantLigas = n;
  document.getElementById('sol-cant-ligas').value = n;
  // Resaltar botón activo
  [1,2,3,4,5].forEach(i => {
    const btn = document.getElementById('sl-' + i);
    if (!btn) return;
    const activo = i === n;
    btn.style.border = activo ? '1.5px solid rgba(249,115,22,0.5)' : '1px solid rgba(255,255,255,.1)';
    btn.style.background = activo ? 'rgba(249,115,22,0.12)' : '#1a1a1a';
    btn.style.color = activo ? '#f97316' : 'rgba(255,255,255,.6)';
  });
  // Actualizar precio info
  const precios = { 1:'$4.990/mes', 2:'$9.990/mes', 3:'$9.990/mes', 4:'$9.990/mes', 5:'$14.990/mes' };
  const precioEl = document.getElementById('sol-precio-ref');
  if (precioEl) precioEl.textContent = 'Precio estimado: ' + (precios[Math.min(n,5)] || '$14.990/mes');
  // Renderizar campos por liga
  renderLigasDetalle(n);
}

function renderLigasDetalle(n) {
  const cont = document.getElementById('sol-ligas-detalle');
  if (!cont) return;
  cont.innerHTML = '';
  const total = Math.min(n, 10);
  for (let i = 1; i <= total; i++) {
    const div = document.createElement('div');
    div.style.cssText = 'background:#111;border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:12px 14px';
    div.innerHTML = `
      <div style="font-size:10px;font-weight:700;color:#f97316;letter-spacing:1px;text-transform:uppercase;margin-bottom:10px">Liga \${i}</div>
      <div style="margin-bottom:8px">
        <label style="font-size:10px;color:rgba(255,255,255,.4);letter-spacing:.8px;text-transform:uppercase;display:block;margin-bottom:4px">Nombre</label>
        <input id="sol-lg-nombre-\${i}" class="f-input" type="text" placeholder="Ej: Liga Masculino A" style="margin-bottom:0">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
        <div>
          <label style="font-size:10px;color:rgba(255,255,255,.4);letter-spacing:.8px;text-transform:uppercase;display:block;margin-bottom:4px">Categoría</label>
          <input id="sol-lg-cat-\${i}" class="f-input" type="text" placeholder="Ej: Masculino, Femenino..." style="margin-bottom:0">
        </div>
        <div>
          <label style="font-size:10px;color:rgba(255,255,255,.4);letter-spacing:.8px;text-transform:uppercase;display:block;margin-bottom:4px">N° equipos</label>
          <input id="sol-lg-eq-\${i}" class="f-input" type="number" placeholder="Ej: 8" min="2" max="32" style="margin-bottom:0">
        </div>
      </div>
    `;
    cont.appendChild(div);
  }
  // Agregar ref precio
  let precioRef = document.getElementById('sol-precio-ref');
  if (!precioRef) {
    precioRef = document.createElement('div');
    precioRef.id = 'sol-precio-ref';
    precioRef.style.cssText = 'font-size:11px;color:#f97316;font-weight:700;text-align:center;padding:8px 0';
    cont.after(precioRef);
  }
  const precios = { 1:'$4.990/mes', 2:'$9.990/mes', 3:'$9.990/mes', 4:'$9.990/mes' };
  precioRef.textContent = 'Precio estimado: ' + (n >= 5 ? '$14.990/mes' : (precios[n] || '$9.990/mes'));
}

