    h+='<div class="sol-card" style="border-left-color:'+bc+'"><div class="p-card-header"><div><div class="p-card-title">'+s.nombre+'</div><div class="p-card-sub">'+s.email+(s.telefono?' · '+s.telefono:'')+'</div></div>';
