/**
 * Muestra el panel especificado y actualiza el botón activo en el sidebar.
 * @param {string} panelId El ID del panel a mostrar (ej. 'p-solicitudes').
 * @param {HTMLElement} btn El botón del sidebar que fue clickeado.
 */
function showPanel(panelId, btn) {
  // Remover la clase 'active' de todos los botones del sidebar
  document.querySelectorAll('.panel-sidebar .sb-btn').forEach(b => b.classList.remove('active'));
  // Añadir la clase 'active' al botón clickeado
  if (btn) btn.classList.add('active');

  const panelMain = document.getElementById('panel-main');
  panelMain.innerHTML = ''; // Limpiar contenido anterior

  // Renderizar el contenido del panel según el ID
  switch (panelId) {
    case 'p-solicitudes':
      renderPanelSolicitudes();
      break;
    case 'p-torneos':
      renderPanelTorneos();
      break;
    case 'p-organizadores':
      renderPanelOrganizadores();
      break;
    case 'p-metricas':
      renderPanelMetricas();
      break;
    case 'p-dashboard':
      renderPanelDashboard();
      break;
    case 'p-categorias':
      renderPanelCategorias();
      break;
    case 'p-equipos':
      renderPanelEquipos();
      break;
    case 'p-fixture':
      renderPanelFixture();
      break;
    case 'p-resultados':
      renderPanelResultados();
      break;
    case 'p-noticias':
      renderPanelNoticias();
      break;
    case 'p-sanciones':
      renderPanelSanciones();
