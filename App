var adminPass = '';
var activeAdmTab = 'tab-ligas';
var confirmCb = null;
var modalSaveCb = null;
var _cache = { data: null, ts: 0, cityId: null };

// ─── SUPABASE — LECTURA PÚBLICA ───────────────────────────────────────────────
async function fetchAllData(cityId) {
  const cacheKey = cityId || 'all';
  if (_cache.data && _cache.cityId === cacheKey && Date.now() - _cache.ts < CACHE_TTL) return _cache.data;

  // ── MODO DEMO: usar datos locales si Supabase no está configurado ──────────
  const USING_PLACEHOLDER = false; // Supabase conectado — cambiar a true para modo demo
  if (USING_PLACEHOLDER) {
    const cid = cityId || 'arica';
    const demo = DEMO_DATA[cid];
    if (!demo) return { ligas:[], equipos:[], partidos:[], sanciones:[], noticias:[], personas:[], stats:[], temporadas:[] };
    const norm = {
      ligas:     demo.ligas     || [],
      equipos:   demo.equipos   || [],
      partidos:  demo.partidos  || [],
      sanciones: demo.sanciones || [],
      noticias:  demo.noticias  || [],
      personas:  demo.personas  || [],
      stats:     [],
      temporadas:[{ id:'t1', nombre: demo.temporada }],
    };
    _cache = { data: norm, ts: Date.now(), cityId: cacheKey };
    return norm;
  }
  // ── FIN MODO DEMO ──────────────────────────────────────────────────────────

  const [rL, rE, rP, rS, rN, rPer, rSt, rTemp] = await Promise.all([
    _supa.from('ligas').select('*').order('created_at'),
    _supa.from('equipos').select('*').order('nombre_equipo'),
    _supa.from('encuentros').select('*').order('partidos'),
    _supa.from('sanciones').select('*').order('created_at', { ascending: false }),
    _supa.from('noticias').select('*').order('fecha', { ascending: false }),
    _supa.from('personas').select('*').order('nombre_completo'),
    _supa.from('stats_carrera').select('*'),
    _supa.from('temporadas').select('*').order('created_at'),
  ]);

  const norm = {
    ligas: (rL.data || []).map(r => ({
      ID: r.id, NombreDeporte: r.nombre_deporte, Categoria: r.categoria,
      NombreFantasia: r.nombre_fantasia, PuntosVictoria: r.puntos_victoria,
      PuntosEmpate: r.puntos_empate, PuntosDerrota: r.puntos_derrota,
