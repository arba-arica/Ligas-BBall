function admToggleSection(sec, btn) {
  const subEl = document.getElementById('sub-' + sec);
  const isOpen = subEl.classList.contains('open');
  // Cerrar todos
  document.querySelectorAll('.adm-submenu-inner').forEach(el => el.classList.remove('open'));
  document.querySelectorAll('.adm-icon-btn').forEach(b => b.classList.remove('active'));
  // Abrir el seleccionado si estaba cerrado
  if (!isOpen) {
    subEl.classList.add('open');
    btn.classList.add('active');
    // Activar primer subitem
    const firstItem = subEl.querySelector('.adm-sub-item');
    if (firstItem) firstItem.click();
  }
}

function admSetSection(sec, btn) {
  admToggleSection(sec, btn);
}

function admSetTab(tabId, btn) {
  _admCurrentTab = tabId;
  // Actualizar submenu activo
  document.querySelectorAll('.adm-sub-item').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  else {
    document.querySelectorAll('.adm-sub-item').forEach(b => {
      if (b.getAttribute('onclick')?.includes(`'${tabId}'`)) b.classList.add('active');
    });
  }
  // Encontrar el item para título y subtítulo
  let item = null;
  for (const sec of Object.values(ADM_SECTIONS)) {
    item = sec.items.find(i => i.id === tabId);
    if (item) break;
  }
  if (item) {
    document.getElementById('adm-main-title').textContent = item.label;
    document.getElementById('adm-main-sub').textContent   = item.sub;
  }
  // Mostrar panel correcto, ocultar el resto
  document.querySelectorAll('.adm-panel-new').forEach(p => p.style.display = 'none');
  const panel = document.getElementById(tabId);
  if (panel) panel.style.display = 'block';
  // Callbacks por tab
  if (tabId === 'tab-res-adm')      renderResAdm();
  if (tabId === 'tab-jugadores-adm') { renderJugadoresAdm(); populateEqJugadores(); }
  if (tabId === 'tab-noticias-adm')  renderNoticiasAdm();
  if (tabId === 'tab-sanciones-adm') renderSancionesAdm();
  if (tabId === 'tab-ligas')         renderLigasAdm();
  if (tabId === 'tab-equipos')       renderEquiposAdm();
  if (tabId === 'tab-partidos')      renderPartidosAdm();
  if (tabId === 'tab-usuarios-adm')  renderUsuariosAdm();
  if (tabId === 'tab-stats-adm')     setupStatsAdmin();
  if (tabId === 'tab-temporada-adm') setupTemporadaTab();
}

