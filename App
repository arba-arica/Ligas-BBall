// ── RENDER PARTIDO CARD ───────────────────────────────────────────────
function renderPartidoCard(p, finalizado) {
  const local  = p.local  || { nombre: '?' };
  const visita = p.visita || { nombre: '?' };
  const locWin = finalizado && (p.pts_local > p.pts_visita);
  const visWin = finalizado && (p.pts_visita > p.pts_local);
  let h = '<div class="match-card">';
  // Número partido + badge estado
  h += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">';
  h += '<div class="match-nro" style="margin:0">Partido N° ' + (p.nro_fecha||'') + '</div>';
  if (finalizado) {
    h += '<span class="match-badge badge-final">Final</span>';
  } else if (p.estado === 'en_vivo') {
    h += '<span class="match-badge badge-live" style="display:flex;align-items:center;gap:4px"><span style="width:6px;height:6px;border-radius:50%;background:var(--red);display:inline-block;animation:pulse 1s infinite"></span>En Vivo</span>';
  } else {
    h += '<span class="match-badge badge-proximo">Próximo</span>';
  }
  h += '</div>';
  // Equipos y marcador
  h += '<div class="match-teams">';
  h += '<div class="match-team-name' + (locWin?' win':'') + '">' + local.nombre + '</div>';
  if (finalizado) {
    h += '<div class="match-score-box">' + (p.pts_local||0) + '–' + (p.pts_visita||0) + '</div>';
  } else {
    h += '<div class="match-score-box vs">vs</div>';
  }
  h += '<div class="match-team-name right' + (visWin?' win':'') + '">' + visita.nombre + '</div>';
  h += '</div>';
  // Meta info
  h += '<div class="match-meta">';
  if (p.fecha) h += '<span>' + formatFecha(p.fecha) + '</span>';
  if (p.hora)  h += '<span class="match-meta-sep">·</span><span>' + p.hora + '</span>';
  if (p.cancha) h += '<span class="match-meta-sep">·</span><span>' + p.cancha + '</span>';
  if (p.url_transmision) {
    h += '<span class="match-meta-sep">·</span><a href="' + p.url_transmision + '" target="_blank" style="color:var(--red);display:flex;align-items:center;gap:4px;font-weight:700">';
    h += '<svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.25 8.25 0 004.83 1.56V6.81a4.85 4.85 0 01-1.06-.12z"/></svg>';
    h += 'En vivo</a>';
  }
  h += '</div>';
  h += '</div>';
  return h;
}

function compartirTorneo() {
  const url = window.location.href;
  if (navigator.share) {
    navigator.share({ title: TORNEO_ACTUAL ? TORNEO_ACTUAL.nombre : 'ACTIVA PLAY', url: url });
  } else if (navigator.clipboard) {
    navigator.clipboard.writeText(url).then(function() { toast('Link copiado', 'ok'); });
  }
}
