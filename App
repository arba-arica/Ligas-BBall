function openAdmin() {
  document.getElementById('admin-overlay').classList.add('open');
  if (adminPass && _currentUser) {
    document.getElementById('admin-login-screen').style.display = 'none';
    document.getElementById('admin-panel-full').style.display = 'flex';
  } else {
    document.getElementById('admin-login-screen').style.display = 'flex';
    document.getElementById('admin-panel-full').style.display = 'none';
  }
}
function closeAdmin() { document.getElementById('admin-overlay').classList.remove('open'); }

async function doLogin() {
  const email = (document.getElementById('admin-email').value || '').trim().toLowerCase();
  const pass  = document.getElementById('admin-pass').value;
  if (!email || !pass) return;
  const btn = document.getElementById('do-login');
  const txt = document.getElementById('login-btn-txt');
  txt.innerHTML = '<div style="width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;display:inline-block"></div> Ingresando...';
  btn.disabled = true;
  try {
    const res = await fetch(NETLIFY_FN, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'checkLogin', email, password: pass, turnstileToken: _turnstileToken || null }),
    });
    const json = JSON.parse(await res.text());
    _turnstileToken = null; // resetear token Turnstile
    if (json && json.success) {
      adminPass = pass;
      _currentUser = json.usuario;
      window._userRol = json.usuario?.rol || 'super_admin';
      document.getElementById('admin-login-screen').style.display = 'none';
      const panelFull = document.getElementById('admin-panel-full');
      panelFull.style.display = 'flex';
      // Mostrar nombre usuario y temporada activa
      const nombreEl = document.getElementById('adm-user-nombre');
      if (nombreEl) nombreEl.textContent = json.usuario.nombre;
      const tempActiva = (D.temporadas||[]).find(t=>t.estado==='activa');
      const tempBadge = document.getElementById('adm-temporada-badge');
      if (tempBadge && tempActiva) { tempBadge.textContent = tempActiva.nombre; tempBadge.style.display = 'block'; }
      // Aplicar roles
      applyRoleTabs(json.usuario.rol);
      // Mostrar solicitudes para super_admin
      if (window._userRol === 'super_admin') {
        const btnSol = document.getElementById('btn-solicitudes');
        if (btnSol) btnSol.style.display = 'flex';
        loadSolicitudes();
      }
      // Inicializar sección por defecto
      if (json.usuario.rol === 'delegado') {
        renderPanelDelegado();
      } else {
        admSetSection('torneo', document.querySelector('.adm-icon-btn[data-sec="torneo"]'));
      }
      toast(`Bienvenido, ${json.usuario.nombre}`, 'ok');
    } else {
      document.getElementById('login-error').style.display = 'block';
      setTimeout(() => document.getElementById('login-error').style.display = 'none', 2500);
    }
  } catch(e) { toast('Error de conexión: ' + e.message, 'err'); }
  finally { txt.textContent = 'Ingresar'; btn.disabled = false; }
}

