    </div>`).join('');
}

async function createJugadorDelegado() {
  const nombre = document.getElementById('del-nombre').value.trim();
  const fnac   = document.getElementById('del-fnac').value;
  const rut    = document.getElementById('del-rut').value.trim();
  const cat    = document.getElementById('del-cat').value;
  const rol    = document.getElementById('del-rol').value;
  const fed    = document.getElementById('del-fed').value;
  const eqId   = document.getElementById('del-eq-sel')?.value;
  const eq     = D.equipos.find(e => e.ID === eqId);
  const ligaId = eq?.ID_Liga;
  if (!nombre) return toast('El nombre es obligatorio','err');
  if (!eqId || !ligaId) return toast('Selecciona un equipo válido','err');
  if (rut && !rut.match(/^\d{7,8}-[\dkK]$/)) return toast('RUT inválido. Formato: 12345678-9','err');
  if (rol === 'jugador') {
    const count = D.personas.filter(p => p.id_equipo === eqId && p.rol === 'jugador' && p.categoria === cat).length;
    if (count >= 15) return toast(`Cupo completo en ${cat} (15/15)`,'err');
  }
  const btn = document.getElementById('btn-del-jugador');
  btn.innerHTML = '<div style="width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;display:inline-block;margin-right:6px"></div> Guardando...';
  btn.disabled = true;
  try {
    const res = await fetch(NETLIFY_FN, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action: 'createPersona', adminPassword: adminPass,
        nombreCompleto: nombre, fechaNacimiento: fnac || null,
        rut: rut || '', idEquipo: eqId, idLiga: ligaId,
        categoria: cat, rol, federado: fed === 'true',
      }),
    });
    const json = JSON.parse(await res.text());
    if (json?.success) {
      toast(`✓ ${nombre} agregado`,'ok');
      document.getElementById('del-nombre').value = '';
      document.getElementById('del-fnac').value   = '';
      document.getElementById('del-rut').value    = '';
      await refreshData();
      renderPanelDelegado();
    } else { toast(json?.message || 'Error al agregar','err'); }
  } catch(e) { toast('Error: ' + e.message,'err'); }
  finally {
    const b = document.getElementById('btn-del-jugador');
    if (b) { b.innerHTML = '+ Agregar jugador'; b.disabled = false; }
  }
}

