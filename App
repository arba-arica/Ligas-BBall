    equipos: (rE.data || []).map(r => ({
      ID: r.id, ID_Liga: r.id_liga, NombreEquipo: r.nombre_equipo,
      ColorUniformeLocal: r.color_uniforme_local,
      ColorUniformeVisita: r.color_uniforme_visita,
    })),
    partidos: (rP.data || []).map(r => ({
      ID: r.id, ID_Liga: r.id_liga, Partidos: r.partidos,
      Fecha: r.fecha, Hora: r.hora, Cancha: r.cancha, Fase: r.fase,
      ID_EquipoLocal: r.id_equipo_local,
      GolesLocal:  r.goles_local  !== null ? r.goles_local  : '',
      GolesVisita: r.goles_visita !== null ? r.goles_visita : '',
      ID_EquipoVisita: r.id_equipo_visita,
      Estado: r.estado, YoutubeURL: r.youtube_url,
    })),
    sanciones: (rS.data || []).map(r => ({
      ID: r.id, ID_Liga: r.id_liga, ID_Equipo: r.id_equipo,
      NombreJugador: r.nombre_jugador, TipoFalta: r.tipo_falta,
      Sancion: r.sancion, TerminoSancion: r.termino_sancion,
    })),
    noticias: (rN.data || []).map(r => ({
      ID: r.id, Fecha: r.fecha, Titulo: r.titulo,
      Descripcion: r.descripcion, ImagenURL: r.imagen_url,
      foto_url: r.foto_url, Enlace: r.enlace, me_gusta: r.me_gusta || 0,
    })),
    personas:   (rPer.data  || []),
    stats:      (rSt.data   || []),
    temporadas: (rTemp.data || []),
  };

  _cache = { data: norm, ts: Date.now() };
  return norm;
}

function invalidateCache() { _cache = { data: null, ts: 0 }; }

