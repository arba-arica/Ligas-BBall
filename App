async function supa(t,p){p=p||'';const r=await fetch(SUPA_URL+'/rest/v1/'+t+p,{headers:{apikey:SUPA_ANON,Authorization:'Bearer '+SUPA_ANON}});return r.json();}
async function api(action,data){data=data||{};const body=Object.assign({action},data);if(SESSION&&SESSION.token)body.token=SESSION.token;const r=await fetch(FN,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});return r.json();}
function toggleTheme(){
  var dark=document.documentElement.getAttribute('data-theme')==='dark';
  document.documentElement.setAttribute('data-theme',dark?'light':'dark');
  try{localStorage.setItem('ap_theme',dark?'light':'dark');}catch(e){}
  var btn=document.querySelector('.pub-nav-btns .btn-ghost');
  if(btn&&btn.textContent.trim()==='☀️'||btn&&btn.textContent.trim()==='🌙')btn.textContent=dark?'🌙':'☀️';
}
