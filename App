<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>ACTIVA PLAY — Torneos deportivos</title>
<link rel="icon" href="data:image/png;base64," type="image/png">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0a0a;--bg2:#111;--bg3:#161616;--surface:#1a1a1a;
  --border:rgba(255,255,255,.07);--border2:rgba(255,255,255,.12);
  --blue:#1d4ed8;--blue-dark:#1e3a8a;--blue-dim:rgba(29,78,216,.12);--blue-glow:rgba(29,78,216,.25);
  --orange:#f97316;--orange-dim:rgba(249,115,22,.1);
  --text:#f1f5f9;--text2:#94a3b8;--text3:#475569;
  --green:#22c55e;--red:#ef4444;--r:12px;
}
[data-theme="light"]{--bg:#f8fafc;--bg2:#fff;--bg3:#f1f5f9;--surface:#fff;--border:rgba(0,0,0,.07);--border2:rgba(0,0,0,.12);--text:#0f172a;--text2:#475569;--text3:#94a3b8;}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Source Sans 3',sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden;transition:background .25s,color .25s}
button,input,select,textarea{font-family:inherit}
a{text-decoration:none;color:inherit}
.logo{display:flex;align-items:center;gap:4px;font-family:'Oswald',sans-serif;font-size:22px;font-weight:900;letter-spacing:1.5px;color:var(--text)}
.logo-dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--blue);margin:0 4px;margin-bottom:2px;flex-shrink:0}
.logo-acc{color:var(--orange)}
.nav-logo{height:38px;width:auto;display:block}
@media(max-width:600px){.nav-logo{height:30px}}
/* PUB */
#pub-view{min-height:100svh;display:none;flex-direction:column}
.pub-nav{background:var(--bg2);border-bottom:1px solid var(--border);padding:0 16px;height:56px;display:flex;align-items:center;justify-content:center;position:sticky;top:0;z-index:50;backdrop-filter:blur(8px)}
.pub-nav-btns{display:flex;gap:8px;align-items:center}
.pub-nav-mobile-btns{display:none;position:fixed;bottom:0;left:0;right:0;z-index:90;background:var(--bg2);border-top:1px solid var(--border);padding:10px 16px max(10px,env(safe-area-inset-bottom));gap:8px;justify-content:center;align-items:center}
@media(max-width:600px){.pub-nav-btns{display:none}.pub-nav-mobile-btns{display:flex}.pub-content{padding-bottom:120px}}
.btn-ghost{padding:7px 14px;border-radius:100px;border:1px solid var(--border2);background:transparent;color:var(--text2);font-size:12px;font-weight:700;cursor:pointer;letter-spacing:.3px;transition:all .2s}
.btn-ghost:hover{border-color:var(--blue);color:var(--blue)}
.btn-solid{padding:7px 16px;border-radius:100px;background:var(--blue);border:none;color:#fff;font-size:12px;font-weight:700;cursor:pointer;letter-spacing:.3px;transition:opacity .2s}
.btn-solid:hover{opacity:.85}
.btn-orange{background:var(--orange)}
.pub-hero{background:linear-gradient(180deg,var(--blue-dim) 0%,transparent 100%);padding:28px 16px 20px;text-align:center;border-bottom:1px solid var(--border)}
.pub-hero-title{font-family:'Oswald',sans-serif;font-size:32px;font-weight:900;color:var(--text);letter-spacing:.5px;line-height:1}
.pub-hero-title span{color:var(--orange)}
.pub-hero-sub{font-size:13px;color:var(--text2);margin-top:6px}
.pub-content{flex:1;padding:20px 16px 80px;max-width:640px;margin:0 auto;width:100%}
.section-label{font-size:10px;font-weight:700;color:var(--blue);letter-spacing:2px;text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;gap:8px}
.section-label::after{content:'';flex:1;height:1px;background:var(--border)}
.torneo-card{background:var(--bg2);border:1px solid var(--border);border-radius:16px;padding:16px;margin-bottom:10px;cursor:pointer;transition:all .2s}
.torneo-card:hover{border-color:var(--blue-glow);background:var(--bg3);transform:translateX(3px)}
.torneo-card-header{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:10px}
.torneo-nombre{font-family:'Oswald',sans-serif;font-size:20px;font-weight:900;color:var(--text);letter-spacing:.3px}
.torneo-ciudad{font-size:12px;color:var(--text2);margin-top:2px}
.badge{font-size:10px;font-weight:700;padding:3px 10px;border-radius:100px;letter-spacing:.5px;text-transform:uppercase;white-space:nowrap}
.badge-active{background:rgba(34,197,94,.1);color:var(--green);border:1px solid rgba(34,197,94,.2)}
.badge-draft{background:var(--orange-dim);color:var(--orange);border:1px solid rgba(249,115,22,.2)}
/* TORNEO VIEW */
#torneo-view{display:none;min-height:100svh;flex-direction:column;background:#0a0e1f}
.tv-hero{background:#1e3a8a;padding:28px 18px 22px;text-align:center;flex-shrink:0;position:relative}
.tv-back{position:absolute;top:12px;left:12px;width:32px;height:32px;border-radius:8px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;cursor:pointer;color:#fff;font-size:16px}
.tv-temporada-lbl{font-size:11px;font-weight:700;letter-spacing:2px;color:#f97316;text-transform:uppercase;margin-bottom:4px}
.tv-torneo-nombre{font-family:'Oswald',sans-serif;font-size:26px;font-weight:900;color:#fff;letter-spacing:.5px;line-height:1.1;margin-bottom:16px}
.tv-share-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:100px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);color:#fff;font-size:12px;font-weight:700;cursor:pointer}
.tv-ligas-section{background:#1e3a8a;padding:0 18px 18px;flex-shrink:0}
.tv-ligas-label{font-size:10px;font-weight:700;letter-spacing:1.5px;color:rgba(255,255,255,.4);text-transform:uppercase;margin-bottom:10px}
.tv-ligas-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
.tv-liga-btn{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:12px;cursor:pointer;text-align:left;transition:all .15s;width:100%}
.tv-liga-btn.active{background:rgba(255,255,255,.18);border:1.5px solid #f97316}
.tv-liga-btn-name{font-size:12px;font-weight:700;color:#fff;line-height:1.3}
.tv-content{flex:1;padding:14px 16px 90px;overflow-y:auto}
.tv-navbar{position:fixed;bottom:0;left:0;right:0;z-index:50;background:var(--surface);border-top:1px solid var(--border);display:none;justify-content:space-around;padding:8px 0 max(8px,env(safe-area-inset-bottom))}
.tv-nav-btn{display:flex;flex-direction:column;align-items:center;gap:3px;border:none;background:none;cursor:pointer;color:var(--text3);font-size:9px;font-weight:700;letter-spacing:.3px;text-transform:uppercase;padding:4px 10px;min-width:52px;transition:color .2s}
.tv-nav-btn.active{color:#1e3a8a}
[data-theme="dark"] .tv-nav-btn.active{color:#93c5fd}
.tv-nav-btn svg{width:20px;height:20px}
.tv-nav-dot{width:4px;height:4px;border-radius:50%;background:#1e3a8a;margin-top:1px;opacity:0;transition:opacity .2s}
[data-theme="dark"] .tv-nav-dot{background:#93c5fd}
.tv-nav-btn.active .tv-nav-dot{opacity:1}
.tv-sec-label{font-family:'Source Sans 3',sans-serif;font-weight:700;font-size:11px;color:var(--text2);letter-spacing:1.5px;text-transform:uppercase;margin:16px 0 8px;display:flex;align-items:center;gap:8px}
.tv-sec-label::after{content:'';flex:1;height:1px;background:var(--border)}
/* PARTIDO CARD */
.mc{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:12px 14px;margin-bottom:8px}
.mc-top{background:var(--blue-dim);border-radius:8px;padding:6px 10px;display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.mc-top-info{font-size:11px;font-weight:700;color:var(--blue)}
[data-theme="dark"] .mc-top-info{color:#93c5fd}
.mc-badge{font-size:10px;font-weight:700;padding:2px 8px;border-radius:100px;letter-spacing:.5px;text-transform:uppercase}
.mc-badge-prox{background:rgba(34,197,94,.15);color:#16a34a;border:1px solid #bbf7d0}
[data-theme="dark"] .mc-badge-prox{background:rgba(34,197,94,.15);color:#86efac;border-color:rgba(34,197,94,.3)}
.mc-badge-final{background:rgba(29,78,216,.1);color:#1e3a8a;border:1px solid #bfdbfe}
[data-theme="dark"] .mc-badge-final{background:var(--blue-dim);color:#93c5fd;border-color:var(--blue-glow)}
.mc-badge-live{background:rgba(239,68,68,.1);color:#dc2626;border:1px solid #fecaca}
.mc-teams{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px;margin-bottom:10px}
.mc-team{font-family:'Oswald',sans-serif;font-size:16px;font-weight:700;color:var(--text);line-height:1.2}
.mc-team.right{text-align:right}
.mc-team.win{color:var(--blue)}
[data-theme="dark"] .mc-team.win{color:#93c5fd}
.mc-score{font-family:'Oswald',sans-serif;font-size:26px;font-weight:900;color:var(--orange);background:rgba(249,115,22,.1);padding:4px 12px;border-radius:8px;text-align:center;white-space:nowrap}
.mc-vs{font-family:'Oswald',sans-serif;font-size:14px;font-weight:700;color:var(--blue);background:var(--blue-dim);width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin:0 auto;border:1px solid var(--blue-glow)}
.mc-footer{padding-top:8px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:4px}
.mc-meta{font-size:11px;color:var(--text2);display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.mc-meta-sep{color:var(--border2)}
.mc-yt{font-size:11px;font-weight:700;color:#dc2626;display:flex;align-items:center;gap:4px;text-decoration:none}
/* TABLA */
.st-wrap{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:16px}
.st-table{width:100%;border-collapse:collapse;font-size:12px}
.st-table th{background:var(--bg3);color:var(--text2);font-size:10px;font-weight:700;padding:8px 6px;text-align:center;letter-spacing:.8px;text-transform:uppercase;border-bottom:1px solid var(--border)}
.st-table th:nth-child(2){text-align:left;padding-left:10px}
.st-table td{padding:10px 6px;text-align:center;border-bottom:1px solid var(--border);color:var(--text2);font-weight:500}
.st-table tr:last-child td{border-bottom:none}
.st-table td:nth-child(2){text-align:left;padding-left:10px;font-weight:700;font-size:13px;color:var(--text)}
.rk{font-family:'Oswald',sans-serif;font-size:15px;font-weight:900}
.rk-1{color:var(--orange)}.rk-2{color:var(--text2)}.rk-3{color:#78716c}
.pts-cell{font-family:'Oswald',sans-serif;font-size:16px;font-weight:900;color:var(--blue)}
[data-theme="dark"] .pts-cell{color:#93c5fd}
.dif-pos{color:var(--green)}.dif-neg{color:var(--red)}
.color-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:middle}
.pdf-btn-dark{width:100%;display:flex;align-items:center;gap:10px;padding:13px 16px;border-radius:12px;background:#1e3a8a;border:none;color:#fff;font-size:13px;font-weight:700;cursor:pointer;margin-bottom:6px;text-align:left;transition:opacity .2s}
.pdf-btn-dark:hover{opacity:.88}
.pdf-btn-ghost{background:transparent;border:1px solid var(--border);color:var(--text2)}
[data-theme="dark"] .pdf-btn-dark{background:var(--blue)}
.san-card{background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--red);border-radius:0 14px 14px 0;padding:12px 14px;margin-bottom:8px}
.san-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px}
.san-type{font-size:10px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--red);background:rgba(239,68,68,.1);padding:2px 8px;border-radius:100px;border:1px solid rgba(239,68,68,.2)}
.san-player{font-family:'Oswald',sans-serif;font-size:16px;font-weight:700;color:var(--text);margin-bottom:3px}
.san-detail{font-size:12px;color:var(--text2);line-height:1.5}
.club-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:12px 14px;display:flex;align-items:center;gap:10px;margin-bottom:6px}
.club-color{width:36px;height:36px;border-radius:50%;flex-shrink:0}
.club-name{font-weight:700;font-size:14px;color:var(--text)}
.news-card-tv{background:var(--surface);border:1px solid var(--border);border-radius:14px;margin-bottom:10px;overflow:hidden}
.news-card-body{padding:12px 14px}
.news-date-tv{font-size:10px;font-weight:700;color:var(--orange);letter-spacing:.5px;text-transform:uppercase;margin-bottom:4px}
.news-title-tv{font-family:'Oswald',sans-serif;font-size:17px;font-weight:900;color:var(--text);line-height:1.3;margin-bottom:4px}
.news-desc-tv{font-size:13px;color:var(--text2);line-height:1.6}
.tv-admin-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:transparent;border:1px solid var(--border);border-radius:100px;cursor:pointer;font-size:12px;font-weight:700;color:var(--text2);letter-spacing:.5px;margin-top:8px}
.tv-admin-btn:hover{border-color:var(--border2);color:var(--text)}
/* PANEL */
#panel-view{display:none;min-height:100svh;flex-direction:column}
.panel-nav{background:#0a0f1e;border-bottom:1px solid rgba(29,78,216,.2);padding:0 16px;height:52px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.panel-body{display:flex;flex:1;overflow:hidden;height:calc(100svh - 52px)}
.panel-sidebar{width:200px;background:#060d1a;display:flex;flex-direction:column;padding:8px;flex-shrink:0;overflow-y:auto;border-right:1px solid rgba(255,255,255,.05)}
.panel-main{flex:1;overflow-y:auto;background:var(--bg)}
.sb-section{font-size:9px;font-weight:700;color:rgba(255,255,255,.2);letter-spacing:2px;text-transform:uppercase;padding:10px 8px 4px}
.sb-btn{width:100%;padding:9px 10px;border-radius:8px;background:transparent;border:none;cursor:pointer;display:flex;align-items:center;gap:8px;color:rgba(255,255,255,.45);font-size:13px;font-family:inherit;text-align:left;transition:all .15s}
.sb-btn:hover{background:rgba(255,255,255,.06);color:rgba(255,255,255,.8)}
.sb-btn.active{background:rgba(29,78,216,.2);color:#fff;font-weight:600}
.sb-btn svg{width:15px;height:15px;flex-shrink:0}
.sb-badge{background:var(--orange);color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:100px;margin-left:auto}
.panel-content{padding:20px;max-width:800px}
.panel-title{font-family:'Oswald',sans-serif;font-size:24px;font-weight:900;color:var(--text);letter-spacing:.3px;margin-bottom:4px}
.panel-sub{font-size:13px;color:var(--text2);margin-bottom:20px}
.p-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:16px;margin-bottom:10px}
.p-card-header{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:12px}
.p-card-title{font-weight:700;font-size:14px;color:var(--text)}
.p-card-sub{font-size:12px;color:var(--text2);margin-top:2px}
.p-card-actions{display:flex;gap:6px;flex-shrink:0;flex-wrap:wrap}
.btn-sm{padding:5px 12px;border-radius:8px;font-size:11px;font-weight:700;border:1px solid var(--border2);background:var(--surface);color:var(--text2);cursor:pointer;transition:all .15s;letter-spacing:.3px}
.btn-sm:hover{border-color:var(--blue);color:var(--blue)}
.btn-sm-danger:hover{border-color:var(--red)!important;color:var(--red)!important}
.btn-sm-primary{background:var(--blue);border-color:var(--blue);color:#fff}
.btn-sm-primary:hover{opacity:.85;color:#fff;border-color:var(--blue)}
.metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:20px}
.metric-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px;text-align:center}
.metric-num{font-family:'Oswald',sans-serif;font-size:32px;font-weight:900;color:var(--orange)}
.metric-lbl{font-size:10px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;margin-top:2px}
.sol-card{background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--orange);border-radius:var(--r);padding:14px;margin-bottom:10px}
.sol-info{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}
.sol-info-item{background:var(--bg3);border-radius:8px;padding:8px 10px}
.sol-info-lbl{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px}
.sol-info-val{font-size:13px;font-weight:600;color:var(--text)}
.org-id-display{background:var(--blue-dim);border:1px solid var(--blue-glow);border-radius:10px;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;margin:10px 0}
.org-id-val{font-family:'Oswald',sans-serif;font-size:24px;font-weight:900;color:var(--blue);letter-spacing:4px}
.org-clave{font-size:16px;font-weight:700;color:var(--orange);letter-spacing:2px}
/* TOAST */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#1a1a1a;border:1px solid var(--border2);color:var(--text);padding:10px 20px;border-radius:100px;font-size:13px;font-weight:600;z-index:999;opacity:0;transition:opacity .25s;pointer-events:none;white-space:nowrap}
.toast.show{opacity:1}
.toast.ok{border-color:rgba(34,197,94,.4);color:var(--green)}
.toast.err{border-color:rgba(239,68,68,.4);color:var(--red)}
/* MODAL */
.modal-overlay{position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.75);display:flex;align-items:center;justify-content:center;padding:16px;opacity:0;pointer-events:none;transition:opacity .25s}
.modal-overlay.open{opacity:1;pointer-events:all}
.modal{background:var(--bg2);border:1px solid var(--border2);border-radius:20px;width:100%;max-width:420px;max-height:90svh;overflow-y:auto;padding:24px;transform:translateY(16px);transition:transform .25s;position:relative}
.modal-overlay.open .modal{transform:translateY(0)}
.modal-title{font-family:'Oswald',sans-serif;font-size:22px;font-weight:900;color:var(--text);letter-spacing:.3px;margin-bottom:4px}
.modal-sub{font-size:13px;color:var(--text2);margin-bottom:20px}
.modal-close{position:absolute;top:16px;right:16px;width:30px;height:30px;border-radius:8px;background:var(--surface);border:1px solid var(--border);cursor:pointer;color:var(--text2);font-size:16px;display:flex;align-items:center;justify-content:center}
.modal-close:hover{border-color:var(--red);color:var(--red)}
/* FORMS */
.f-group{margin-bottom:12px}
.f-label{display:block;font-size:10px;font-weight:700;color:var(--text2);letter-spacing:.8px;text-transform:uppercase;margin-bottom:5px}
.f-input{width:100%;background:var(--surface);border:1px solid var(--border2);border-radius:10px;padding:10px 14px;font-size:14px;color:var(--text);outline:none;transition:border-color .2s;font-family:'Source Sans 3',sans-serif}
.f-input:focus{border-color:var(--blue)}
.f-input::placeholder{color:var(--text3)}
textarea.f-input{resize:none}
.f-select{width:100%;background:var(--surface);border:1px solid var(--border2);border-radius:10px;padding:10px 14px;font-size:14px;color:var(--text);outline:none;cursor:pointer;appearance:none;font-family:'Source Sans 3',sans-serif}
.f-select:focus{border-color:var(--blue)}
.f-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.f-section{font-size:10px;font-weight:700;color:var(--blue);letter-spacing:1.5px;text-transform:uppercase;margin:16px 0 10px;display:flex;align-items:center;gap:8px}
.f-section::after{content:'';flex:1;height:1px;background:var(--border)}
.f-error{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.2);border-radius:8px;padding:8px 12px;font-size:12px;color:var(--red);margin-bottom:10px;display:none}
.f-submit{width:100%;padding:13px;border-radius:12px;background:var(--blue);border:none;color:#fff;font-family:'Oswald',sans-serif;font-size:16px;font-weight:700;letter-spacing:.5px;cursor:pointer;margin-top:8px;transition:opacity .2s}
.f-submit:hover{opacity:.88}
.f-submit:disabled{opacity:.5;cursor:not-allowed}
.f-submit.btn-orange-submit{background:var(--orange)}
.f-note{font-size:11px;color:var(--text3);text-align:center;margin-top:8px;line-height:1.5}
@media(max-width:600px){.panel-sidebar{width:160px}.panel-content{padding:14px}.f-row{grid-template-columns:1fr}}
