        + '<td>' + r.pj + '</td><td>' + r.pg + '</td><td>' + r.pe + '</td><td>' + r.pp + '</td>'
        + '<td>' + r.gf + '</td><td>' + r.gc + '</td>'
        + '<td class="' + (dg>0?'dif-pos':dg<0?'dif-neg':'') + '">' + (dg>0?'+':'') + dg + '</td>'
        + '<td><span class="pts-cell">' + r.pts + '</span></td></tr>';
    });
