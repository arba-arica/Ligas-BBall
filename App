async function eliminarSancion(id){var catId=document.getElementById('san-cat-sel')?document.getElementById('san-cat-sel').value:'';confirmAction('¿Eliminar esta sanción?',async function(){var r=await api('eliminarSancion',{id:id});if(r.success){toast('Eliminada','');if(catId)cargarSancionesPanel(catId);}else toast(r.message,'err');});}

/* ── PROGRAMACIÓN GENERAL ── */
async function renderProgramacion(){
  var el=document.getElementById('tab-programacion');
  if(!el)return;
  if(!TORNEO_ACTUAL){el.innerHTML='';return;}
  el.innerHTML='<div style="padding:20px;text-align:center;color:var(--text2);font-size:13px">Cargando programación...</div>';
  // Traer todos los partidos del torneo con join de nombres, para todas las categorías
  var promises=CATEGORIAS.map(function(cat){
    return fetch(SUPA_URL+'/rest/v1/partidos?torneo_id=eq.'+TORNEO_ACTUAL.id+'&categoria_id=eq.'+cat.id+'&select=id,nro_fecha,fecha,hora,cancha,fase,estado,pts_local,pts_visita,url_transmision,equipo_local,equipo_visita,local:equipo_local(nombre),visita:equipo_visita(nombre)&order=fecha,hora',
      {headers:{apikey:SUPA_ANON,Authorization:'Bearer '+SUPA_ANON,'Accept':'application/json'}})
    .then(function(r){return r.json();})
    .then(function(data){return{cat:cat,partidos:Array.isArray(data)?data:[]};})
    .catch(function(){return{cat:cat,partidos:[]};});
  });
  var results=await Promise.all(promises);
  // Agrupar todos los partidos por fecha (día)
  var porFecha={};
  results.forEach(function(res){
    res.partidos.forEach(function(p){
      var dia=p.fecha||'Sin fecha';
      if(!porFecha[dia])porFecha[dia]=[];
      porFecha[dia].push({partido:p,cat:res.cat});
    });
  });
  var dias=Object.keys(porFecha).sort();
  var h='<div class="tv-sec-label">Programación general</div>';
  if(!dias.length){h+='<div style="padding:16px;color:var(--text2);font-size:13px;text-align:center">Sin partidos programados aún.</div>';el.innerHTML=h;return;}
  dias.forEach(function(dia){
    var fechaCompleta=dia!=='Sin fecha'?new Date(dia+'T12:00:00').toLocaleDateString('es-CL',{weekday:'long',day:'2-digit',month:'long',year:'numeric'}):dia;
    h+='<div style="font-size:11px;font-weight:700;color:var(--blue);letter-spacing:1.5px;text-transform:uppercase;margin:16px 0 8px;display:flex;align-items:center;gap:8px">'+fechaCompleta+'<span style="flex:1;height:1px;background:var(--border);display:inline-block"></span></div>';
    porFecha[dia].sort(function(a,b){return(a.partido.hora||'').localeCompare(b.partido.hora||'');});
    porFecha[dia].sort(function(a,b){return(a.partido.hora||'').localeCompare(b.partido.hora||'');});
    porFecha[dia].forEach(function(item){
      var p=item.partido,cat=item.cat;
      var lN=(p.local&&p.local.nombre)||'?',vN=(p.visita&&p.visita.nombre)||'?';
      var fin=p.estado==='finalizado',enVivo=p.estado==='en_vivo';
      var lWin=fin&&(p.pts_local>p.pts_visita),vWin=fin&&(p.pts_visita>p.pts_local);
      h+='<div class="mc" style="margin-bottom:8px">';
      // Top con hora, cancha y categoría
      h+='<div class="mc-top" style="display:flex;align-items:center;justify-content:space-between">';
      h+='<span class="mc-top-info">'+(p.hora||'Sin hora')+(p.cancha?' · 📍'+p.cancha:'')+'</span>';
      h+='<span style="font-size:10px;font-weight:700;color:var(--orange);letter-spacing:.5px;text-transform:uppercase">'+cat.nombre+'</span>';
      h+='</div>';
      // Labels local/visita
      h+='<div style="display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:4px;margin-bottom:4px;padding:0 2px">';
      h+='<div style="font-size:9px;font-weight:700;color:var(--blue);letter-spacing:1px;text-transform:uppercase">🏠 Local</div>';
      h+='<div></div>';
      h+='<div style="font-size:9px;font-weight:700;color:var(--orange);letter-spacing:1px;text-transform:uppercase;text-align:right">Visita ✈️</div>';
      h+='</div>';
      // Equipos
      h+='<div class="mc-teams">';
      h+='<div class="mc-team'+(lWin?' win':'')+' ">'+lN+'</div>';
      if(fin)h+='<div class="mc-score">'+p.pts_local+'–'+p.pts_visita+'</div>';
      else if(enVivo)h+='<div class="mc-badge mc-badge-live" style="text-align:center">● EN VIVO</div>';
      else h+='<div class="mc-vs">VS</div>';
      h+='<div class="mc-team right'+(vWin?' win':'')+' ">'+vN+'</div>';
      h+='</div>';
      // Footer
      h+='<div style="padding-top:6px;border-top:1px solid var(--border);text-align:center;font-size:11px;color:var(--text2)">';
      h+='Partido N°'+(p.nro_fecha||'—')+(p.fase&&p.fase!=='Fase Regular'?' · '+p.fase:'');
      if(fin)h+=' · <span style="color:var(--green);font-weight:700">Finalizado</span>';
      h+='</div></div>';
    });
  });
  el.innerHTML=h;
}

/* ── PDF GENERATORS (print via window.print) ── */
function _pdfPrint(titulo,bodyHtml){
  var w=window.open('','_blank','width=900,height=700');
  w.document.write('<!DOCTYPE html><html><head><meta charset="UTF-8"><title>'+titulo+'</title><style>body{font-family:Arial,sans-serif;padding:24px;color:#1b263b}h1{font-size:22px;margin-bottom:4px}p{color:#6c757d;font-size:13px;margin-bottom:20px}table{width:100%;border-collapse:collapse;font-size:13px}th{background:#1d3557;color:#fff;padding:8px;text-align:left}td{padding:8px;border-bottom:1px solid #dee2e6}.score{font-weight:900;font-size:16px}.section{font-weight:700;font-size:14px;color:#1d3557;margin:16px 0 8px;border-bottom:2px solid #e0e7f0;padding-bottom:4px}@media print{button{display:none}}</style></head><body>');
  w.document.write('<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px"><div><h1>'+titulo+'</h1><p>'+(TORNEO_ACTUAL?TORNEO_ACTUAL.nombre+' · '+TORNEO_ACTUAL.ciudad:'')+'</p></div><button onclick="window.print()">🖨️ Imprimir / Guardar PDF</button></div>');
  w.document.write(bodyHtml);
  w.document.write('</body></html>');
  w.document.close();
}

async function generarPDFFixture(){
  var cat=getCatActual();if(!cat){toast('Sin categoría seleccionada','err');return;}
  var r=await fetch(SUPA_URL+'/rest/v1/partidos?categoria_id=eq.'+cat.id+'&select=*,local:equipo_local(nombre),visita:equipo_visita(nombre)&estado=neq.finalizado&order=nro_fecha,fecha,hora',{headers:{apikey:SUPA_ANON,Authorization:'Bearer '+SUPA_ANON}});
  var partidos=await r.json();
  var body='<div class="section">'+cat.nombre+' — Próximos partidos</div><table><tr><th>Fecha</th><th>Local</th><th>Visita</th><th>Día/Hora</th><th>Cancha</th></tr>';
  (partidos||[]).forEach(function(p){
    var dia=p.fecha?new Date(p.fecha+'T12:00:00').toLocaleDateString('es-CL',{weekday:'short',day:'2-digit',month:'short'}):'';
    body+='<tr><td>N°'+p.nro_fecha+'</td><td>'+((p.local&&p.local.nombre)||'?')+'</td><td>'+((p.visita&&p.visita.nombre)||'?')+'</td><td>'+dia+(p.hora?' '+p.hora:'')+'</td><td>'+(p.cancha||'—')+'</td></tr>';
  });
  body+='</table>';
  _pdfPrint('Programación — '+(cat.nombre||''),body);
}

async function generarPDFTabla(){
  var cat=getCatActual();if(!cat){toast('Sin categoría seleccionada','err');return;}
  var r=await fetch(SUPA_URL+'/rest/v1/standings?categoria_id=eq.'+cat.id+'&order=pts.desc',{headers:{apikey:SUPA_ANON,Authorization:'Bearer '+SUPA_ANON}});
  var rows=await r.json();
  var body='<div class="section">'+cat.nombre+' — Tabla de posiciones</div><table><tr><th>#</th><th>Equipo</th><th>PJ</th><th>G</th><th>E</th><th>P</th><th>GF</th><th>GC</th><th>Dif</th><th>Pts</th></tr>';
  (rows||[]).forEach(function(row,i){var dg=(row.gf||0)-(row.gc||0);body+='<tr><td>'+(i+1)+'</td><td>'+row.equipo_nombre+'</td><td>'+row.pj+'</td><td>'+row.pg+'</td><td>'+row.pe+'</td><td>'+row.pp+'</td><td>'+row.gf+'</td><td>'+row.gc+'</td><td>'+(dg>0?'+':'')+dg+'</td><td class="score">'+row.pts+'</td></tr>';});
  body+='</table>';
  _pdfPrint('Tabla de Posiciones — '+(cat.nombre||''),body);
}

