          + (s.fecha_apelacion ? '<div style="font-size:11px;color:var(--blue)">Apelacion: ' + formatFecha(s.fecha_apelacion,'corto') + '</div>' : '')
          + '</div>'
          + '<button class="btn-sm" style="color:var(--red)" onclick="eliminarSancion(this)" data-id="' + s.id + '">Eliminar</button>'
          + '</div></div>';
      });
      sanHtml += '</div>';
    }
    main.innerHTML = '<div class="panel-content"><div class="panel-title">Sanciones</div>'
      + '<div class="p-card" style="margin-bottom:16px">'
      + '<div class="f-group"><label class="f-label">Categoría</label><select class="f-select" id="san-cat">' + catOpts + '</select></div>'
      + '<div class="f-row"><div class="f-group"><label class="f-label">Jugador</label><input class="f-input" id="san-jug" type="text" placeholder="Nombre del jugador"></div>'
      + '<div class="f-group"><label class="f-label">Tipo</label><input class="f-input" id="san-tipo" type="text" placeholder="Tecnica, Expulsion..."></div></div>'
      + '<div class="f-group"><label class="f-label">Descripcion</label><input class="f-input" id="san-desc" type="text" placeholder="Detalle"></div>'
      + '<div class="f-row"><div class="f-group"><label class="f-label">Fecha fin</label><input class="f-input" id="san-fin" type="date"></div>'
      + '<div class="f-group"><label class="f-label">Fecha apelacion</label><input class="f-input" id="san-apel" type="date"></div></div>'
      + '<button class="btn-sm btn-sm-primary" onclick="crearSancion()">+ Registrar sancion</button>'
      + '</div>' + sanHtml + '</div>';

  } else {
    main.innerHTML = '<div class="panel-content"><div style="color:var(--text2)">Panel en construccion.</div></div>';
  }
}

