// ─── NOTICIA con upload + URL fallback ───────────────────────────────────────
function previewFotoNoticia(input) {
  const file = input.files[0];
  if (!file) return;
  if (file.size > 3 * 1024 * 1024) { toast('La imagen supera 3MB','err'); input.value=''; return; }
  const reader = new FileReader();
  reader.onload = e => {
    document.getElementById('nt-foto-img').src = e.target.result;
    document.getElementById('nt-foto-preview').style.display = 'block';
    document.getElementById('nt-img').value = ''; // limpiar URL si hay archivo
  };
  reader.readAsDataURL(file);
}

window.createNoticia = async function() {
  const titulo = document.getElementById('nt-titulo').value.trim();
  if (!titulo) return toast('El título es obligatorio','err');
  const btn = document.getElementById('btn-noticia');
  const btnTxt = btn.innerHTML;
  btn.innerHTML = '<div style="width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;display:inline-block;margin-right:6px"></div> Publicando...';
  btn.disabled = true;
  try {
    let fotoUrl = '';
    const fotoInput = document.getElementById('nt-foto-input');
    const urlInput  = (document.getElementById('nt-img')?.value || '').trim();
    if (fotoInput && fotoInput.files[0]) {
      toast('Subiendo imagen...','ok');
      fotoUrl = await uploadImagen(fotoInput.files[0], 'noticias') || '';
    }
    if (!fotoUrl && urlInput) fotoUrl = urlInput;
    const res = await fetch(NETLIFY_FN, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action: 'createNews', adminPassword: adminPass,
        titulo,
        descripcion: document.getElementById('nt-desc').value.trim(),
        fotoUrl, imagenUrl: fotoUrl,
        enlace: document.getElementById('nt-link')?.value.trim() || '',
      }),
    });
    const json = JSON.parse(await res.text());
    _turnstileToken = null; // resetear token Turnstile
    if (json && json.success) {
      toast('✓ Noticia publicada','ok');
      document.getElementById('nt-titulo').value = '';
      document.getElementById('nt-desc').value   = '';
      if (fotoInput) fotoInput.value = '';
      if (document.getElementById('nt-img')) document.getElementById('nt-img').value = '';
      document.getElementById('nt-foto-preview').style.display = 'none';
      await refreshData(); renderAll(); if (adminPass) renderAdmin();
    } else { toast(json?.message || 'Error al publicar','err'); }
  } catch(e) {
    toast('Error: ' + e.message,'err');
  } finally {
    btn.innerHTML = btnTxt;
    btn.disabled = false;
  }
};

// ─── JUGADOR con RUT y límite automático ─────────────────────────────────────
async function createJugador() {
  const nombre = document.getElementById('jug-nombre').value.trim();
  const fnac   = document.getElementById('jug-fnac').value;
  const rut    = document.getElementById('jug-rut').value.trim();
  const eqId   = document.getElementById('jug-equipo').value;
  const ligaId = document.getElementById('jug-liga').value;
  const cat    = document.getElementById('jug-cat').value;
  const rol    = document.getElementById('jug-rol').value;
  const fed    = document.getElementById('jug-fed').value;
  if (!nombre) return toast('El nombre es obligatorio','err');
  if (!eqId)   return toast('Selecciona un equipo','err');
  if (!ligaId) return toast('Selecciona una liga','err');
  if (rut && !rut.match(/^\d{7,8}-[\dkK]$/)) {
    return toast('RUT inválido. Formato: 12345678-9','err');
  }
  // Verificar límite de 15 jugadores por equipo
  const jugadoresEquipo = (D.personas||[]).filter(p =>
    p.id_equipo === eqId && p.rol === 'jugador'
  );
  if (rol === 'jugador' && jugadoresEquipo.length >= 15) {
    return toast('El equipo ya tiene 15 jugadores (límite máximo)','err');
  }
  showConfirmV3(`¿Agregar a ${nombre}?`, `Equipo: ${jugadoresEquipo.length}/15 jugadores`, async() => {
    closeConfirmV3();
    const res = await fetch(NETLIFY_FN, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action: 'createPersona',
        adminPassword: adminPass,
        nombreCompleto: nombre,
        fechaNacimiento: fnac || null,
        rut: rut || '',
        idEquipo: eqId, idLiga: ligaId,
        categoria: cat, rol,
        federado: fed === 'true',
      }),
    });
    const json = JSON.parse(await res.text());
    _turnstileToken = null; // resetear token Turnstile
    if (json && json.success) {
      toast(`✓ ${nombre} agregado al equipo`,'ok');
      document.getElementById('jug-nombre').value = '';
      document.getElementById('jug-fnac').value   = '';
      document.getElementById('jug-rut').value    = '';
      await refreshData();
      renderJugadores();
    } else {
      toast(json?.message || 'Error al agregar','err');
    }
  },'ok');
}

