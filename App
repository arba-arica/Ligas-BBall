// ─── HELPERS ─────────────────────────────────────────────────────────────────
function ligaObj(id) { return D.ligas.find(l => l.ID === id); }
function teamName(id) { const t = D.equipos.find(e => e.ID === id); return t ? t.NombreEquipo : '?'; }
function teamColor(id, tipo) {
  const t = D.equipos.find(e => e.ID === id);
  if (!t) return '#cbd5e1';
  return tipo === 'local' ? (t.ColorUniformeLocal || '#cbd5e1') : (t.ColorUniformeVisita || '#cbd5e1');
}
function cleanFecha(raw) {
  if (!raw) return '';
  const s = String(raw).trim();
  // Formato DD/MM/YYYY HH:MM:SS (como llega de Sheets API a veces)
  const dmy = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})/);
  if (dmy) return dmy[3] + '-' + dmy[2].padStart(2,'0') + '-' + dmy[1].padStart(2,'0');
  // Formato YYYY-MM-DD con o sin hora
  const ymd = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (ymd) return ymd[1] + '-' + ymd[2] + '-' + ymd[3];
  // Número serial de Excel/Sheets (días desde 1899-12-30)
  const num = parseFloat(s);
  if (!isNaN(num) && num > 1000) {
    const d = new Date((num - 25569) * 86400000);
    return d.toISOString().split('T')[0];
  }
  return s.split('T')[0];
}
function fmtDate(raw) {
  if (!raw) return '';
  const clean = cleanFecha(raw);
  if (!clean) return '';
  const d = new Date(clean + 'T12:00:00');
  if (isNaN(d)) return raw;
  return d.toLocaleDateString('es-CL', {
    weekday:'long', day:'numeric', month:'long', year:'numeric'
  });
}
function fmtTime(t) {
  if (!t) return '';
  const s = String(t).trim();
  // Si parece fecha (contiene / o - o T) ignorar
  if (s.includes('T') || s.match(/^\d{4}-/) || s.match(/^\d{1,2}[\/\-]\d{1,2}[\/\-]\d{4}/)) return '';
  // Extraer HH:MM
  const m = s.match(/(\d{1,2}):(\d{2})/);
  return m ? m[1].padStart(2,'0') + ':' + m[2] + ' hrs' : s;
}
function catClass(cat) { return cat==='Varones'?'cat-v':cat==='Damas'?'cat-d':'cat-m'; }
function empty(icon, txt) { return `<div class="empty"><div class="empty-icon">${icon}</div><div class="empty-text">${txt}</div></div>`; }

