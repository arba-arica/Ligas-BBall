    h+='<div class="sol-info"><div class="sol-info-item"><div class="sol-info-lbl">Ciudad</div><div class="sol-info-val">'+s.ciudad+'</div></div><div class="sol-info-item"><div class="sol-info-lbl">Deporte</div><div class="sol-info-val">'+(s.deporte||'Básquetbol')+'</div></div><div class="sol-info-item"><div class="sol-info-lbl">Categorías</div><div class="sol-info-val">'+(s.cant_categorias||1)+'</div></div><div class="sol-info-item"><div class="sol-info-lbl">Fecha</div><div class="sol-info-val">'+new Date(s.created_at).toLocaleDateString('es-CL')+'</div></div></div>';
