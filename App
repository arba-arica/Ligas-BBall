<script>
// Disponible inmediatamente para el splash screen y drawer
function enterApp() {
  const splash = document.getElementById('splash-screen');
  splash.style.transition = 'opacity .5s';
  splash.style.opacity = '0';
  setTimeout(() => splash.style.display = 'none', 500);
}
function openDrawer()  { document.getElementById('drawer-overlay').classList.add('open'); }
function closeDrawer() { document.getElementById('drawer-overlay').classList.remove('open'); }
function showSectionDrawer(secId) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.getElementById(secId).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
  closeDrawer();
}
function abrirReglamento() {
  closeDrawer();
  window.open('REGLAMENTO_URL_AQUI','_blank'); // ← reemplaza con tu URL
}
function forceRefresh() {
  const icon = document.getElementById('refresh-icon');
  icon.style.animation = 'spin .7s linear infinite';
  invalidateCache();
  fetchAllData().then(data => {
    Object.assign(D, data);
    renderAll();
    if (typeof adminPass !== 'undefined' && adminPass) renderAdmin();
    icon.style.animation = '';
    toast('✓ Datos actualizados','ok');
  }).catch(() => {
    icon.style.animation = '';
    toast('Error al actualizar','err');
  });
}
</script>
