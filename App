    + '<div style="font-size:13px;color:rgba(255,255,255,.5);margin-bottom:16px;text-transform:uppercase;letter-spacing:1px">✅ Acceso generado</div>'
    + '<div style="background:#111;border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:16px;margin-bottom:12px;text-align:left">'
    + '<div style="font-size:10px;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">ID Organizador</div>'
    + '<div style="font-family:Barlow Condensed,sans-serif;font-size:28px;font-weight:900;color:#1d4ed8;letter-spacing:4px">' + orgId + '</div>'
    + '</div>'
    + '<div style="background:#111;border:1px solid rgba(249,115,22,.2);border-radius:12px;padding:16px;margin-bottom:16px;text-align:left">'
    + '<div style="font-size:10px;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">Clave de acceso</div>'
    + '<div style="font-family:Barlow Condensed,sans-serif;font-size:28px;font-weight:900;color:#f97316;letter-spacing:4px">' + clave + '</div>'
    + '<div style="font-size:11px;color:rgba(255,255,255,.3);margin-top:4px">Email: ' + email + '</div>'
    + '</div>'
    + '<button onclick="navigator.clipboard&&navigator.clipboard.writeText('ID: ' + orgId + '\nClave: ' + clave + '').then(function(){this.textContent='Copiado ✓'}.bind(this))" style="width:100%;padding:11px;border-radius:10px;background:#1d4ed8;border:none;color:#fff;font-family:Barlow Condensed,sans-serif;font-size:15px;font-weight:700;cursor:pointer;margin-bottom:8px">COPIAR CREDENCIALES</button>'
