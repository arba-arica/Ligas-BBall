}

async function loadEquiposFixture(catId) {
  const jEq = await api('getEquiposCategoria', { categoria_id: catId });
  const eqs = jEq.data || [];
  const opts = eqs.map(e => '<option value="' + e.id + '">' + e.nombre + '</option>').join('');
  ['fix-local','fix-visita'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.innerHTML = opts || '<option value="">Sin equipos</option>';
  });
  loadPartidosFixture(catId);
}

async function loadPartidosFixture(catId) {
  const lista = document.getElementById('fix-lista');
  if (!lista) return;
  lista.innerHTML = '<div style="font-size:12px;color:var(--text2)">Cargando...</div>';
  const jPar = await api('getPartidosCategoria', { categoria_id: catId });
  const partidos = jPar.data || [];
  if (!partidos.length) { lista.innerHTML = '<div style="font-size:13px;color:var(--text2);padding:8px 0">Sin partidos programados.</div>'; return; }
  lista.innerHTML = '<div class="section-label" style="margin-top:12px">Partidos programados</div>'
    + partidos.map(p => {
      const local  = p.local  || { nombre:'?' };
      const visita = p.visita || { nombre:'?' };
      return '<div class="p-card" style="margin-bottom:8px">'
        + '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">'
        + '<div style="font-size:11px;color:var(--text3)">Partido ' + (p.nro_fecha||'') + ' · ' + (p.fase||'') + '</div>'
        + '<div style="display:flex;gap:6px">'
        + '<button class="btn-sm" onclick="editarPartidoModal(this)" data-id="' + p.id + '">Editar</button>'
        + '<button class="btn-sm btn-sm-danger" onclick="eliminarPartido(this)" data-id="' + p.id + '">Eliminar</button>'
        + '</div></div>'
        + '<div style="display:flex;align-items:center;justify-content:space-between;font-weight:600;font-size:14px">'
        + '<span>' + local.nombre + '</span><span style="color:var(--text3);font-size:12px">vs</span><span>' + visita.nombre + '</span>'
        + '</div>'
        + '<div style="font-size:11px;color:var(--text2);margin-top:6px">'
        + formatFecha(p.fecha,'corto') + (p.hora?' · '+p.hora:'') + (p.cancha?' · '+p.cancha:'')
        + (p.url_transmision ? ' · <a href="' + p.url_transmision + '" target="_blank" style="color:var(--blue)">Ver en vivo</a>' : '')
        + '</div></div>';
    }).join('');
}

async function crearPartido() {
  const catId  = document.getElementById('fix-cat')?.value;
  const local  = document.getElementById('fix-local')?.value;
  const visita = document.getElementById('fix-visita')?.value;
  if (!catId || !local || !visita) { toast('Selecciona categoría y equipos', 'err'); return; }
  if (local === visita) { toast('Los equipos no pueden ser iguales', 'err'); return; }
  const json = await api('crearPartido', {
    categoria_id:    catId,
    equipo_local:    local,
    equipo_visita:   visita,
    fecha:           document.getElementById('fix-fecha')?.value || null,
    hora:            document.getElementById('fix-hora')?.value  || null,
    cancha:          document.getElementById('fix-cancha')?.value.trim() || null,
    fase:            document.getElementById('fix-fase')?.value.trim() || 'Fase Regular',
    nro_fecha:       parseInt(document.getElementById('fix-nro')?.value) || 1,
    url_transmision: document.getElementById('fix-url')?.value.trim() || null,
  });
  toast(json.success ? '✓ Partido programado' : json.message, json.success ? 'ok' : 'err');
  if (json.success) loadPartidosFixture(catId);
}

async function eliminarPartido(btn) {
  const id = btn ? btn.dataset.id : null;
  if (!id) return;
  if (!confirm('¿Eliminar este partido?')) return;
  const json = await api('eliminarPartido', { id });
  toast(json.success ? '✓ Eliminado' : json.message, json.success ? 'ok' : 'err');
  if (json.success) {
    const catId = document.getElementById('fix-cat')?.value;
    if (catId) loadPartidosFixture(catId);
  }
}

async function cargarResultado(btn) {
  const id = btn ? btn.dataset.id : null;
  if (!id) return;
  const ptsLocal  = parseInt(document.getElementById('r-loc-'+id)?.value);
  const ptsVisita = parseInt(document.getElementById('r-vis-'+id)?.value);
  if (isNaN(ptsLocal) || isNaN(ptsVisita)) { toast('Ingresa los puntos del partido', 'err'); return; }
  const data = { id, pts_local: ptsLocal, pts_visita: ptsVisita };
  ['1','2','3','4'].forEach(function(q) {
    const ql = parseInt(document.getElementById('q'+q+'-loc-'+id)?.value);
    const qv = parseInt(document.getElementById('q'+q+'-vis-'+id)?.value);
    if (!isNaN(ql)) { data['q'+q+'_local'] = ql; data['q'+q+'_visita'] = isNaN(qv) ? 0 : qv; }
  });
  const json = await api('actualizarResultado', data);
  toast(json.success ? '✓ Resultado guardado' : json.message, json.success ? 'ok' : 'err');
  if (json.success) renderPanel('p-resultados');
}

