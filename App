  const porLiga = {};
  personas.forEach(p => {
    const eq   = D.equipos.find(e => e.ID === p.id_equipo);
    const liga = D.ligas.find(l => l.ID === p.id_liga) || (eq ? D.ligas.find(l => l.ID === eq.ID_Liga) : null);
    const ligaKey = liga ? liga.ID : 'sin';
