      </div>`;
    }).join('');
  }
  if (finalizados.length) {
    html += `<div style="font-size:10px;font-weight:700;color:var(--muted2);letter-spacing:.6px;text-transform:uppercase;margin:14px 0 8px;cursor:pointer;display:flex;align-items:center;gap:8px" onclick="toggleFinAdm()">
      Finalizados (${finalizados.length})
      <svg id="fin-adm-chv" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="transition:transform .25s"><path d="M19 9l-7 7-7-7"/></svg>
    </div>
    <div id="fin-adm-list" style="display:none">`;
    html += finalizados.map(p => {
      const liga = ligaObj(p.ID_Liga);
      return `<div class="result-row">
        <div class="result-label" style="text-align:center;margin-bottom:8px">
          <strong>${teamName(p.ID_EquipoLocal)} ${p.GolesLocal||0} — ${p.GolesVisita||0} ${teamName(p.ID_EquipoVisita)}</strong><br>
          <span style="font-size:11px;color:var(--muted)">${fmtDate(p.Fecha)} · ${liga?liga.NombreFantasia:''}</span>
        </div>
        <div style="display:flex;gap:6px;justify-content:center">
          <button class="edit-btn" onclick="openEditResultado('${p.ID}')">✏️ Editar</button>
