// ─── STANDINGS (calculado en cliente) ────────────────────────────────────────
function calcStandings(ligaId) {
  const liga = ligaObj(ligaId);
  if (!liga) return [];
  const equipos = D.equipos.filter(e => e.ID_Liga === ligaId);
  const partidos = D.partidos.filter(p => p.ID_Liga === ligaId && p.Estado === 'Finalizado');
  const standings = {};
  equipos.forEach(t => {
    standings[t.ID] = { ID:t.ID, NombreEquipo:t.NombreEquipo, PJ:0, PG:0, PE:0, PP:0, GF:0, GC:0, DG:0, Puntos:0 };
  });
  partidos.forEach(m => {
    const loc = standings[m.ID_EquipoLocal];
    const vis = standings[m.ID_EquipoVisita];
    if (!loc || !vis) return;
    const gl = parseInt(m.GolesLocal) || 0;
    const gv = parseInt(m.GolesVisita) || 0;
    loc.PJ++; vis.PJ++;
    loc.GF += gl; loc.GC += gv; loc.DG = loc.GF - loc.GC;
    vis.GF += gv; vis.GC += gl; vis.DG = vis.GF - vis.GC;
    const pV = parseInt(liga.PuntosVictoria) || 2;
    const pE = parseInt(liga.PuntosEmpate)   || 0;
    const pD = parseInt(liga.PuntosDerrota)  || 1;
    if      (gl > gv) { loc.PG++; loc.Puntos+=pV; vis.PP++; vis.Puntos+=pD; }
    else if (gl < gv) { vis.PG++; vis.Puntos+=pV; loc.PP++; loc.Puntos+=pD; }
    else              { loc.PE++; loc.Puntos+=pE; vis.PE++; vis.Puntos+=pE; }
  });
  return Object.values(standings).sort((a,b) =>
    b.Puntos - a.Puntos || b.DG - a.DG || b.GF - a.GF
  );
}

