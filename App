  doc.text('Asociación Regional de Básquetbol', 14, 15);
  doc.setFontSize(12); doc.setFont('helvetica','bold');
  doc.text(titulo, 105, 10, {align:'center'});
  doc.setFontSize(9); doc.setFont('helvetica','normal');
  doc.text(subtitulo, 105, 16, {align:'center'});
  const fecha = new Date().toLocaleDateString('es-CL');
  doc.text('Generado: ' + fecha, 196, 10, {align:'right'});
  doc.setTextColor(30, 58, 138);
}

window.downloadPDF = function(tipo) {
  const ligaSuffix = tipo === 'fixture' ? 'fixture' : tipo === 'resultados' ? 'res' : tipo === 'nomina' ? 'nomina' : 'pts';
  const ligaEl = document.getElementById('rep-liga-' + ligaSuffix);
  const eqEl   = tipo === 'puntaje' ? null : document.getElementById('rep-eq-' + ligaSuffix);
  const ligaId = ligaEl?.value || '';
  const eqId   = eqEl?.value  || '';
  const liga   = ligaId ? D.ligas.find(l => l.ID === ligaId) : null;
  const equipo = eqId   ? D.equipos.find(e => e.ID === eqId) : null;

  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ orientation:'landscape', unit:'mm', format:'a4' });
  const subtitulo = [liga?.NombreFantasia, equipo?.NombreEquipo].filter(Boolean).join(' · ') || 'Todas las categorías';

  if (tipo === 'fixture') {
    pdfHeader(doc, 'FIXTURE — PARTIDOS POR DISPUTAR', subtitulo);
    let partidos = D.partidos.filter(p => p.Estado === 'Programado');
    if (ligaId) partidos = partidos.filter(p => p.ID_Liga === ligaId);
    if (eqId)   partidos = partidos.filter(p => p.ID_EquipoLocal === eqId || p.ID_EquipoVisita === eqId);

    if (!partidos.length) {
      doc.autoTable({ startY:26, head:[['Fecha','Hora','Local','','Visita','Cancha','Fase']], body:[['Sin partidos programados','','','','','','']], styles:{fontSize:9,cellPadding:3}, headStyles:{fillColor:[30,58,138],textColor:255,fontStyle:'bold'} });
    } else if (ligaId || eqId) {
      // Con filtro — tabla simple
      const rows = partidos.map(p => [fmtDate(p.Fecha), p.Hora||'—', teamName(p.ID_EquipoLocal), 'vs', teamName(p.ID_EquipoVisita), p.Cancha||'—', p.Fase||'—']);
      doc.autoTable({ startY:26, head:[['Fecha','Hora','Local','','Visita','Cancha','Fase']], body:rows, styles:{fontSize:9,cellPadding:3}, headStyles:{fillColor:[30,58,138],textColor:255,fontStyle:'bold'}, alternateRowStyles:{fillColor:[239,246,255]}, columnStyles:{3:{halign:'center',fontStyle:'bold'}} });
    } else {
      // Sin filtro — agrupar por liga
      let startY = 26;
      D.ligas.forEach(l => {
        const pLiga = partidos.filter(p => p.ID_Liga === l.ID);
        if (!pLiga.length) return;
        doc.setFontSize(10); doc.setFont('helvetica','bold'); doc.setTextColor(30,58,138);
        doc.text(`${l.NombreFantasia} — ${l.Categoria}`, 14, startY + 4);
        const rows = pLiga.map(p => [fmtDate(p.Fecha), p.Hora||'—', teamName(p.ID_EquipoLocal), 'vs', teamName(p.ID_EquipoVisita), p.Cancha||'—', p.Fase||'—']);
        doc.autoTable({ startY: startY+7, head:[['Fecha','Hora','Local','','Visita','Cancha','Fase']], body:rows, styles:{fontSize:9,cellPadding:2.5}, headStyles:{fillColor:[30,58,138],textColor:255,fontStyle:'bold'}, alternateRowStyles:{fillColor:[239,246,255]}, columnStyles:{3:{halign:'center',fontStyle:'bold'}} });
        startY = doc.lastAutoTable.finalY + 8;
        if (startY > 170) { doc.addPage(); startY = 14; }
      });
    }
  }

  else if (tipo === 'resultados') {
    pdfHeader(doc, 'RESULTADOS', subtitulo);
    let partidos = D.partidos.filter(p => p.Estado === 'Finalizado');
    if (ligaId) partidos = partidos.filter(p => p.ID_Liga === ligaId);
    if (eqId)   partidos = partidos.filter(p => p.ID_EquipoLocal === eqId || p.ID_EquipoVisita === eqId);

    if (!partidos.length) {
      doc.autoTable({ startY:26, head:[['Fecha','Local','','','','Visita','Fase']], body:[['Sin resultados','','','','','','']], styles:{fontSize:9,cellPadding:3}, headStyles:{fillColor:[30,58,138],textColor:255,fontStyle:'bold'} });
    } else if (ligaId || eqId) {
      const rows = partidos.map(p => [fmtDate(p.Fecha), teamName(p.ID_EquipoLocal), String(p.GolesLocal??'—'), '-', String(p.GolesVisita??'—'), teamName(p.ID_EquipoVisita), p.Fase||'—']);
      doc.autoTable({ startY:26, head:[['Fecha','Local','','','','Visita','Fase']], body:rows, styles:{fontSize:9,cellPadding:3}, headStyles:{fillColor:[30,58,138],textColor:255,fontStyle:'bold'}, alternateRowStyles:{fillColor:[239,246,255]}, columnStyles:{2:{halign:'right',fontStyle:'bold'},3:{halign:'center'},4:{halign:'left',fontStyle:'bold'}} });
    } else {
      let startY = 26;
      D.ligas.forEach(l => {
        const pLiga = partidos.filter(p => p.ID_Liga === l.ID);
        if (!pLiga.length) return;
        doc.setFontSize(10); doc.setFont('helvetica','bold'); doc.setTextColor(30,58,138);
        doc.text(`${l.NombreFantasia} — ${l.Categoria}`, 14, startY + 4);
        const rows = pLiga.map(p => [fmtDate(p.Fecha), teamName(p.ID_EquipoLocal), String(p.GolesLocal??'—'), '-', String(p.GolesVisita??'—'), teamName(p.ID_EquipoVisita), p.Fase||'—']);
        doc.autoTable({ startY: startY+7, head:[['Fecha','Local','','','','Visita','Fase']], body:rows, styles:{fontSize:9,cellPadding:2.5}, headStyles:{fillColor:[30,58,138],textColor:255,fontStyle:'bold'}, alternateRowStyles:{fillColor:[239,246,255]}, columnStyles:{2:{halign:'right',fontStyle:'bold'},3:{halign:'center'},4:{halign:'left',fontStyle:'bold'}} });
        startY = doc.lastAutoTable.finalY + 8;
        if (startY > 170) { doc.addPage(); startY = 14; }
      });
    }
  }

  else if (tipo === 'puntaje') {
    pdfHeader(doc, 'TABLA DE POSICIONES', subtitulo);
    const ligas = ligaId ? D.ligas.filter(l => l.ID === ligaId) : D.ligas;
    let startY = 26;
    ligas.forEach(l => {
      const standings = calcStandings(l.ID);
      if (!standings.length) return;
      doc.setFontSize(10); doc.setFont('helvetica','bold');
      doc.setTextColor(30,58,138);
      doc.text(l.NombreFantasia + ' — ' + l.Categoria, 14, startY + 4);
      doc.autoTable({
        startY: startY + 7,
        head: [['Pos','Equipo','PJ','G','P','Pts','PF','PC','Dif']],
        body: standings.map((s,i) => [
          i+1,
          s.NombreEquipo,
          s.PJ,
          s.PG,
          s.PP,
          s.Puntos,
          s.GF,
          s.GC,
          (s.DG > 0 ? '+' : '') + s.DG
        ]),
        styles: { fontSize: 9, cellPadding: 2.5 },
        headStyles: { fillColor: [30,58,138], textColor: 255, fontStyle: 'bold' },
        alternateRowStyles: { fillColor: [239,246,255] },
        columnStyles: {
          0:{halign:'center',cellWidth:12},
          2:{halign:'center'}, 3:{halign:'center'},
          4:{halign:'center'}, 5:{halign:'center',fontStyle:'bold'},
          6:{halign:'center'}, 7:{halign:'center'}, 8:{halign:'center'}
        },
      });
      startY = doc.lastAutoTable.finalY + 10;
      if (startY > 170) { doc.addPage(); startY = 14; }
    });
  }

  else if (tipo === 'nomina') {
    // PDF nómina por equipo/liga
    pdfHeader(doc, 'NÓMINA DE JUGADORES', subtitulo);
    const equipos = eqId ? D.equipos.filter(e => e.ID === eqId)
      : ligaId ? D.equipos.filter(e => e.ID_Liga === ligaId)
      : D.equipos;
    let startY = 26;
    equipos.forEach(eq => {
      const personas = D.personas.filter(p => p.id_equipo === eq.ID);
      if (!personas.length) return;
      const ligaEq = D.ligas.find(l => l.ID === eq.ID_Liga);
      doc.setFontSize(10); doc.setFont('helvetica','bold');
      doc.setTextColor(30,58,138);
      doc.text(`${eq.NombreEquipo} — ${ligaEq?.NombreFantasia||''}`, 14, startY + 4);
      const rows = personas.map((p,i) => [
        i+1,
        p.nombre_completo,
        p.rol === 'jugador' ? 'Jugador' : p.rol === 'cuerpo_tecnico' ? 'C. Técnico' : 'Delegado',
        p.categoria || '—',
        p.fecha_nacimiento ? new Date(p.fecha_nacimiento).getFullYear() : '—',
        p.rut || '—',
        p.federado ? 'Sí' : 'No',
      ]);
      doc.autoTable({
        startY: startY + 7,
        head: [['N°','Nombre','Rol','Categoría','Año nac.','RUT','Federado']],
        body: rows,
        styles: { fontSize: 8.5, cellPadding: 2.5 },
        headStyles: { fillColor: [30,58,138], textColor: 255, fontStyle: 'bold' },
        alternateRowStyles: { fillColor: [239,246,255] },
        columnStyles: { 0:{halign:'center',cellWidth:10}, 4:{halign:'center'}, 6:{halign:'center'} },
      });
      startY = doc.lastAutoTable.finalY + 8;
      if (startY > 180) { doc.addPage(); startY = 14; }
    });
  }

  const nombres = { fixture:'Fixture', resultados:'Resultados', puntaje:'Posiciones', nomina:'Nomina' };
  doc.save(`BBALL_${nombres[tipo]}_${new Date().toISOString().split('T')[0]}.pdf`);
  toast('✓ PDF descargado','ok');
};
