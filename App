        h+='</div>';
      });
    });
  }else{h+='<div class="tv-sec-label">Próximos partidos</div><div style="padding:12px;color:var(--text2);font-size:13px;text-align:center">No hay partidos pendientes.</div>';}
  // RESULTADOS
  if(finalizados.length){
