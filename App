async function renderPosiciones() {
  const el = document.getElementById('tab-posiciones');
  const cat = getCatActual();
  if (!cat) { el.innerHTML = '<div style="padding:20px;color:var(--text2)">Sin categorías.</div>'; return; }
  el.innerHTML = '<div style="padding:20px;text-align:center;color:var(--text2);font-size:13px">Cargando tabla...</div>';
  let rows = null;
  try {
    const r = await supa('standings', '?categoria_id=eq.' + cat.id + '&order=pts.desc');
    if (r && !r.error && r.length) rows = r;
  } catch(e) {}
  let h = '<div class="tv-sec-label">Tabla de posiciones</div>';
  if (!rows || !rows.length) {
    h += '<div style="padding:16px;color:var(--text2);font-size:13px;text-align:center">Sin partidos finalizados aún.</div>';
  } else {
    // Ordenar por pts desc, diferencia de goles desc
    rows.sort(function(a,b) {
      const dga = Number(a.gf||0) - Number(a.gc||0);
      const dgb = Number(b.gf||0) - Number(b.gc||0);
      return (Number(b.pts)||0) - (Number(a.pts)||0) || dgb - dga || (Number(b.gf)||0) - (Number(a.gf)||0);
    });
    h += '<div class="st-wrap"><table class="st-table"><thead><tr><th>#</th><th>Equipo</th><th>PJ</th><th>G</th><th>E</th><th>P</th><th>GF</th><th>GC</th><th>Dif</th><th>Pts</th></tr></thead><tbody>';
    rows.forEach(function(r, i) {
      const dg = Number(r.gf||0) - Number(r.gc||0);
      const rkCls = i===0?'rk-1':i===1?'rk-2':i===2?'rk-3':'';
      h += '<tr>'
        + '<td><span class="rk ' + rkCls + '">' + (i+1) + '</span></td>'
        + '<td><span class="color-dot" style="background:' + (r.color||'#475569') + '"></span>' + r.equipo_nombre + '</td>'
        + '<td>' + r.pj + '</td><td>' + r.pg + '</td><td>' + r.pe + '</td><td>' + r.pp + '</td>'
        + '<td>' + r.gf + '</td><td>' + r.gc + '</td>'
        + '<td class="' + (dg>0?'dif-pos':dg<0?'dif-neg':'') + '">' + (dg>0?'+':'') + dg + '</td>'
        + '<td><span class="pts-cell">' + r.pts + '</span></td></tr>';
    });
    h += '</tbody></table></div>';
  }
  // Reportes
  h += '<div class="tv-sec-label">Reportes y documentos</div>';
  h += '<button class="pdf-btn-dark" onclick="pdfalert()"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>Descargar fixture PDF</button>';
  h += '<button class="pdf-btn-dark" onclick="pdfalert()"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>Descargar resultados PDF</button>';
  h += '<button class="pdf-btn-dark" onclick="pdfalert()"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>Descargar tabla de posiciones PDF</button>';
  h += '<button class="pdf-btn-dark pdf-btn-ghost" onclick="pdfalert()"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Ver reglamento del torneo</button>';
  h += '<div style="text-align:center;padding:8px 0"><button class="tv-admin-btn" onclick="pdfopenAdmin()"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M6 20v-2a6 6 0 0112 0v2"/></svg>Acceso administrador</button></div>';
  el.innerHTML = h;
}

