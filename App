        </div>
      </div>`;

    grupo.partidos.forEach(p => {
      const liga = ligaObj(p.ID_Liga);
      const cat = liga ? liga.Categoria : '';
      const isProximo = partidos.indexOf(p) === proximoIdx;
      const hora = fmtTime(p.Hora);
