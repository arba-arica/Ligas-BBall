async function accionSolicitud(id, action, btn) {
  const card = btn.closest('div[style*="border-left"]');
  btn.disabled = true;
  btn.textContent = '...';
  try {
    const res = await fetch(NETLIFY_FN, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action, id, adminPassword: adminPass }),
    });
    const json = await res.json();
    if (json.success) {
      if (action === 'aprobarSolicitud' && json.org_id) {
        toast('✓ Aprobada — ID: ' + json.org_id, 'ok');
