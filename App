  Object.entries(grupos).forEach(function([fecha, ps]) {
    h += '<div style="font-size:10px;font-weight:700;color:var(--text3);letter-spacing:1px;text-transform:uppercase;margin:12px 0 8px">' + fecha + '</div>';
    ps.forEach(function(p) { h += renderMatchCard(p); });
  });
  el.innerHTML = h;
}

