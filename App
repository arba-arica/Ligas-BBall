    var resp=await fetch(
      SUPA_URL+'/rest/v1/partidos?torneo_id=eq.'+TORNEO_ACTUAL.id
      +'&select=id,nro_fecha,fecha,hora,cancha,fase,grupo,estado,pts_local,pts_visita,url_transmision,categoria_id,equipo_local,equipo_visita,local:equipo_local(nombre),visita:equipo_visita(nombre)'
      +'&order=fecha.asc,hora.asc',
      {headers:{apikey:SUPA_ANON,Authorization:'Bearer '+SUPA_ANON,'Accept':'application/json'}}
    );
    var raw=await resp.json();
    data=Array.isArray(raw)?raw:[];
    // Fallback: si torneo_id no trae datos, buscar por categorías
    if(!data.length&&CATEGORIAS&&CATEGORIAS.length){
      var allP=[];
      for(var ci=0;ci<CATEGORIAS.length;ci++){
        var cr2=await fetch(
          SUPA_URL+'/rest/v1/partidos?categoria_id=eq.'+CATEGORIAS[ci].id
