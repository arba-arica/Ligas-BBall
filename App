              <div style="font-size:13px;font-weight:700">${p.nombre_completo}</div>
              <div style="font-size:11px;color:var(--muted)">${anio}${p.rut?' · '+p.rut:''}${fed}</div>
            </div>
            <button class="btn-del-sm" onclick="delJugador('${p.id}','${p.nombre_completo.replace(/'/g,"\\'")}')">✕</button>
          </div>`;
        }).join('')}
