#toast{position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--text);color:#fff;padding:10px 20px;border-radius:100px;font-size:13px;font-weight:700;opacity:0;transition:all .3s;z-index:500;white-space:nowrap;pointer-events:none}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#toast.ok{background:var(--green)}
#toast.err{background:var(--red)}

[data-theme=dark]{--bg:#0a0a0a;--surface:#141414;--card:#1a1a1a;--border:#262626;--border2:#333;--primary-light:rgba(249,115,22,0.12);--text:#f1f5f9;--muted:#94a3b8;--muted2:#475569}
[data-theme=dark] #app-header{background:#111!important;box-shadow:0 1px 0 rgba(249,115,22,0.2)!important}
[data-theme=dark] #main-nav{background:#0f0f0f;border-top-color:#1a1a1a}
[data-theme=dark] #drawer{background:#141414}
[data-theme=dark] .accordion-header:hover{background:#1f1f1f}
[data-theme=dark] .f-input,[data-theme=dark] .f-select{background:#1a1a1a;border-color:#333;color:#f1f5f9}
[data-theme=dark] .adm-panel-left{background:#111;border-right-color:#1a1a1a}
#header-city-chip{display:none;background:rgba(249,115,22,.15);color:#f97316;border:1px solid rgba(249,115,22,.3);border-radius:100px;padding:5px 12px;font-size:11px;font-weight:700;letter-spacing:.5px;cursor:pointer;align-items:center;gap:5px;font-family:'Archivo',sans-serif;white-space:nowrap}
#header-city-chip:hover{background:rgba(249,115,22,.25)}

#demo-banner{display:none;background:#f97316;color:#fff;text-align:center;font-size:11px;font-weight:700;letter-spacing:1px;padding:5px;text-transform:uppercase}
</style>
</head>
<body>

<!-- PANTALLA BIENVENIDA -->
<div id="splash-screen" style="position:fixed;inset:0;z-index:999;background:#0a0a0a;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;overflow:hidden">
  <div style="position:absolute;width:500px;height:500px;border-radius:50%;background:rgba(255,255,255,.05);top:-100px;right:-100px"></div>
  <div style="position:absolute;width:300px;height:300px;border-radius:50%;background:rgba(249,115,22,.06);bottom:-50px;left:-80px"></div>
  <!-- Vista principal splash -->
  <div id="splash-main" style="position:relative;z-index:1;text-align:center;max-width:380px;width:100%">
    <div style="margin-bottom:20px;animation:float 3s ease-in-out infinite">
      <svg width="72" height="72" viewBox="0 0 100 100" fill="none">
        <circle cx="50" cy="50" r="46" fill="#f97316" stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
        <path d="M50 4 C50 4 50 96 50 96" stroke="rgba(0,0,0,0.25)" stroke-width="2.5" fill="none"/>
        <path d="M4 50 C4 50 96 50 96 50" stroke="rgba(0,0,0,0.25)" stroke-width="2.5" fill="none"/>
        <path d="M15 20 C30 35 35 65 25 80" stroke="rgba(0,0,0,0.2)" stroke-width="2" fill="none"/>
        <path d="M85 20 C70 35 65 65 75 80" stroke="rgba(0,0,0,0.2)" stroke-width="2" fill="none"/>
        <ellipse cx="35" cy="30" rx="10" ry="6" fill="rgba(255,255,255,0.15)" transform="rotate(-30 35 30)"/>
      </svg>
    </div>
    <div style="font-size:10px;font-weight:700;letter-spacing:3px;color:rgba(255,255,255,.35);text-transform:uppercase;margin-bottom:6px">Básquetbol</div>
    <div style="font-family:'Archivo Black',sans-serif;font-size:40px;letter-spacing:3px;color:#fff;line-height:1;margin-bottom:6px">ACTIVA<span style="display:inline-block;width:4px;height:4px;border-radius:50%;background:#1d4ed8;margin:0 4px;margin-bottom:1px;vertical-align:middle"></span><span style="color:#f97316">PLAY</span></div>
    <div style="font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.3);margin-bottom:20px">Plataforma multi-liga · Chile</div>
    <div style="width:40px;height:3px;background:#f97316;border-radius:2px;margin:0 auto 24px"></div>

    <!-- Mensaje motivacional -->
    <div style="background:rgba(249,115,22,0.08);border:1px solid rgba(249,115,22,0.2);border-radius:16px;padding:20px 18px;margin-bottom:20px;text-align:left">
      <div style="font-family:'Archivo Black',sans-serif;font-size:17px;color:#fff;line-height:1.3;margin-bottom:8px">¿Organizas básquetbol en tu ciudad?</div>
      <div style="font-size:13px;color:rgba(255,255,255,.5);line-height:1.6;margin-bottom:14px">Publica tu liga, gestiona tu torneo y lleva el control de equipos, jugadores y resultados — todo desde el celular.</div>
      <div style="display:flex;flex-direction:column;gap:6px">
        <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:rgba(255,255,255,.6)"><span style="color:#f97316;font-size:14px">✓</span> Tablas de posiciones automáticas</div>
        <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:rgba(255,255,255,.6)"><span style="color:#f97316;font-size:14px">✓</span> Registro de jugadores y equipos</div>
        <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:rgba(255,255,255,.6)"><span style="color:#f97316;font-size:14px">✓</span> Resultados y estadísticas en tiempo real</div>
        <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:rgba(255,255,255,.6)"><span style="color:#f97316;font-size:14px">✓</span> Acceso público para hinchas y familias</div>
      </div>
    </div>

    <!-- CTA principal -->
    <button onclick="showSplashForm()" style="width:100%;padding:15px;border-radius:14px;background:#f97316;border:none;color:#fff;font-family:'Archivo Black',sans-serif;font-size:16px;letter-spacing:1px;cursor:pointer;box-shadow:0 8px 24px rgba(249,115,22,.35);margin-bottom:10px;transition:opacity .2s" onmouseover="this.style.opacity='.9'" onmouseout="this.style.opacity='1'">
      PUBLICAR MI LIGA →
    </button>

    <!-- Ligas activas (dinámico desde Supabase) -->
    <div id="city-grid-wrap" style="display:none;margin-bottom:10px">
      <div style="font-size:10px;font-weight:700;color:rgba(255,255,255,.3);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:10px;text-align:left">Ligas activas</div>
      <div id="city-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;width:100%"></div>
    </div>

    <!-- Acceso admin -->
    <button onclick="openAdminFromSplash()" style="width:100%;padding:11px;border-radius:12px;background:transparent;border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.4);font-family:'Archivo',sans-serif;font-size:12px;font-weight:700;letter-spacing:.5px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;transition:all .2s;margin-bottom:14px" onmouseover="this.style.borderColor='rgba(249,115,22,0.4)';this.style.color='rgba(249,115,22,0.8)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.12)';this.style.color='rgba(255,255,255,0.4)'">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3"/><path d="M6 20v-2a6 6 0 0112 0v2"/></svg>
      Acceso Administrador
    </button>
    <div style="font-size:10px;color:rgba(255,255,255,.15);letter-spacing:.5px">activaplay.cl</div>
  </div>

  <!-- Formulario solicitud -->
  <div id="splash-form" style="display:none;position:relative;z-index:1;width:100%;max-width:400px;max-height:90vh;overflow-y:auto">
    <div style="background:#141414;border:1px solid rgba(249,115,22,0.2);border-radius:20px;padding:28px 22px">

      <!-- Header formulario -->
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:6px">
        <button onclick="hideSplashForm()" style="background:rgba(255,255,255,.08);border:none;border-radius:8px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:rgba(255,255,255,.6);flex-shrink:0">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        </button>
        <div>
          <div style="font-family:'Archivo Black',sans-serif;font-size:17px;color:#fff">Inscribe tu liga</div>
          <div style="font-size:11px;color:rgba(255,255,255,.4);margin-top:1px">Quedarás pendiente de aprobación</div>
        </div>
      </div>

      <div style="height:1px;background:rgba(255,255,255,.06);margin:16px 0"></div>

      <!-- SECCIÓN 1: Datos personales -->
      <div style="font-size:10px;font-weight:700;color:#f97316;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:12px">1 · Tus datos</div>
      <form id="solicitud-form" onsubmit="enviarSolicitud();return false;" autocomplete="on">
        <input type="hidden" id="sol-tipo" value="sub_admin">
        <div style="margin-bottom:10px">
          <label style="font-size:10px;font-weight:700;color:rgba(255,255,255,.4);letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:5px">Nombre completo</label>
          <input id="sol-nombre" class="f-input" type="text" placeholder="Tu nombre" required autocomplete="name">
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px">
          <div>
            <label style="font-size:10px;font-weight:700;color:rgba(255,255,255,.4);letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:5px">Email</label>
            <input id="sol-email" class="f-input" type="email" placeholder="tu@email.com" required autocomplete="email">
          </div>
          <div>
            <label style="font-size:10px;font-weight:700;color:rgba(255,255,255,.4);letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:5px">Teléfono</label>
            <input id="sol-telefono" class="f-input" type="tel" placeholder="+56 9..." autocomplete="tel">
          </div>
        </div>

        <div style="height:1px;background:rgba(255,255,255,.06);margin:16px 0"></div>

        <!-- SECCIÓN 2: Torneo -->
        <div style="font-size:10px;font-weight:700;color:#f97316;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:12px">2 · Tu torneo</div>
        <div style="margin-bottom:10px">
          <label style="font-size:10px;font-weight:700;color:rgba(255,255,255,.4);letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:5px">Ciudad</label>
          <input id="sol-ciudad" class="f-input" type="text" placeholder="Ej: Santiago, Medellín, Buenos Aires..." required>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px">
          <div>
            <label style="font-size:10px;font-weight:700;color:rgba(255,255,255,.4);letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:5px">Nombre del torneo</label>
            <input id="sol-liga" class="f-input" type="text" placeholder="Ej: Apertura 2026" required>
          </div>
          <div>
            <label style="font-size:10px;font-weight:700;color:rgba(255,255,255,.4);letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:5px">Temporada</label>
            <input id="sol-temporada" class="f-input" type="text" placeholder="Ej: Mayo–Agosto 2026">
          </div>
        </div>

        <!-- Cantidad de ligas + campos dinámicos -->
        <div style="margin-bottom:10px">
          <label style="font-size:10px;font-weight:700;color:rgba(255,255,255,.4);letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:5px">¿Cuántas ligas vas a desarrollar?</label>
          <div style="display:flex;gap:8px">
            <button type="button" onclick="setCantLigas(1)" class="sol-liga-cnt" id="sl-1" style="flex:1;padding:10px;border-radius:10px;border:1.5px solid rgba(249,115,22,0.5);background:rgba(249,115,22,0.12);color:#f97316;font-family:'Archivo Black',sans-serif;font-size:14px;cursor:pointer">1</button>
            <button type="button" onclick="setCantLigas(2)" class="sol-liga-cnt" id="sl-2" style="flex:1;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.1);background:#1a1a1a;color:rgba(255,255,255,.6);font-family:'Archivo Black',sans-serif;font-size:14px;cursor:pointer">2</button>
            <button type="button" onclick="setCantLigas(3)" class="sol-liga-cnt" id="sl-3" style="flex:1;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.1);background:#1a1a1a;color:rgba(255,255,255,.6);font-family:'Archivo Black',sans-serif;font-size:14px;cursor:pointer">3</button>
            <button type="button" onclick="setCantLigas(4)" class="sol-liga-cnt" id="sl-4" style="flex:1;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.1);background:#1a1a1a;color:rgba(255,255,255,.6);font-family:'Archivo Black',sans-serif;font-size:14px;cursor:pointer">4</button>
            <button type="button" onclick="setCantLigas(5)" class="sol-liga-cnt" id="sl-5" style="flex:1;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.1);background:#1a1a1a;color:rgba(255,255,255,.6);font-family:'Archivo Black',sans-serif;font-size:14px;cursor:pointer">5+</button>
          </div>
        </div>
        <input type="hidden" id="sol-cant-ligas" value="1">

        <!-- Campos dinámicos por liga -->
        <div id="sol-ligas-detalle" style="display:flex;flex-direction:column;gap:10px;margin-bottom:4px"></div>

        <!-- Info de precios — sin selector, el super admin asigna -->
        <div style="height:1px;background:rgba(255,255,255,.06);margin:16px 0"></div>
        <div style="background:rgba(249,115,22,0.08);border:1px solid rgba(249,115,22,0.15);border-radius:12px;padding:14px 16px;margin-bottom:16px">
          <div style="font-size:10px;font-weight:700;color:#f97316;letter-spacing:1px;text-transform:uppercase;margin-bottom:10px">Precios por ligas activas</div>
          <div style="display:flex;flex-direction:column;gap:6px">
            <div style="display:flex;justify-content:space-between;font-size:12px">
              <span style="color:rgba(255,255,255,.6)">1 liga activa</span>
              <span style="font-weight:700;color:#fff">$4.990/mes</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:12px">
              <span style="color:rgba(255,255,255,.6)">2 a 4 ligas activas</span>
              <span style="font-weight:700;color:#fff">$9.990/mes</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:12px">
              <span style="color:rgba(255,255,255,.6)">5 o más ligas activas</span>
              <span style="font-weight:700;color:#fff">$14.990/mes</span>
            </div>
          </div>
          <div style="font-size:10px;color:rgba(255,255,255,.3);margin-top:10px">El administrador te contactará para coordinar el pago y activar tu acceso.</div>
        </div>
        <input type="hidden" id="sol-plan" value="por_ligas">

        <div id="sol-error" style="display:none;color:#ef4444;font-size:12px;margin-bottom:10px;padding:8px 12px;background:rgba(239,68,68,.1);border-radius:8px;border:1px solid rgba(239,68,68,.2)"></div>

        <button type="submit" id="sol-btn" style="width:100%;padding:14px;border-radius:12px;background:#f97316;border:none;color:#fff;font-family:'Archivo Black',sans-serif;font-size:15px;letter-spacing:.5px;cursor:pointer;transition:opacity .2s" onmouseover="this.style.opacity='.9'" onmouseout="this.style.opacity='1'">
          ENVIAR SOLICITUD
        </button>
        <div style="font-size:11px;color:rgba(255,255,255,.25);text-align:center;margin-top:10px">Tu solicitud quedará pendiente hasta que el administrador la apruebe</div>
      </form>
    </div>
  </div>
</div>

<div id="demo-banner">Modo Demo — Conecta Supabase para datos reales</div>
<header id="app-header">
  <button id="hamburger-btn" onclick="openDrawer()">
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
  <a href="./index.html" style="position:absolute;left:50%;transform:translateX(-50%);display:flex;align-items:center;text-decoration:none;font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:900;letter-spacing:1px;color:#fff">
    ACTIVA<span style="display:inline-block;width:4px;height:4px;border-radius:50%;background:#f97316;margin:0 4px;margin-bottom:2px"></span><span style="color:#f97316">PLAY</span>
  </a>
  <div style="display:flex;align-items:center;gap:8px">
    <div id="header-city-chip" onclick="volverSplash()" style="display:none;background:rgba(249,115,22,0.15);color:#f97316;border:1px solid rgba(249,115,22,0.3);border-radius:100px;padding:5px 12px;font-size:11px;font-weight:700;letter-spacing:.5px;cursor:pointer;align-items:center;gap:5px;font-family:Archivo,sans-serif"><span id="header-city-label"></span> ✕</div>
    <button id="theme-btn" onclick="toggleTheme()" style="width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;cursor:pointer;color:rgba(255,255,255,.8)" aria-label="Cambiar tema" title="Cambiar tema"><svg id="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg></button>
    <button id="refresh-btn" onclick="forceRefresh()" style="width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;cursor:pointer;color:rgba(255,255,255,.8)">
      <svg id="refresh-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
    </button>
    <button id="admin-btn">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M6 20v-2a6 6 0 0112 0v2"/></svg>
    </button>
  </div>
</header>

<!-- DRAWER HAMBURGUESA -->
<div id="drawer-overlay" onclick="closeDrawer()">
  <div id="drawer" onclick="event.stopPropagation()">
    <div class="drawer-top">
      <div class="logo-arba" style="color:#f97316;font-size:18px">ACTIVA PLAY</div>
      <div class="logo-sub" style="color:var(--muted2)" id="drawer-city-label">Selecciona tu ciudad</div>
    </div>
    <div class="drawer-nav">
      <div class="drawer-section">Torneo</div>
      <button class="drawer-item" onclick="showSectionDrawer('sec-agenda')">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        Fixture
      </button>
      <button class="drawer-item" onclick="showSectionDrawer('sec-resultados')">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        Resultados
      </button>
      <button class="drawer-item" onclick="showSectionDrawer('sec-posiciones')">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Puntaje
      </button>
      <button class="drawer-item" onclick="showSectionDrawer('sec-sanciones')">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0112 2a8 8 0 018 8.2c0 7.3-8 11.8-8 11.8z"/></svg>
        Sanciones
      </button>
      <div class="drawer-section">Comunidad</div>
      <button class="drawer-item" onclick="showSectionDrawer('sec-noticias')">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/></svg>
        Noticias
      </button>
      <button class="drawer-item" onclick="showSectionDrawer('sec-jugadores')">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
        Jugadores
      </button>
      <button class="drawer-item" onclick="showSectionDrawer('sec-reportes')">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg>
        Reportes
      </button>
      <div class="drawer-section">Documentos</div>
      <button class="drawer-item" onclick="abrirReglamento()">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="16 17 12 21 8 17"/><line x1="12" y1="12" x2="12" y2="21"/></svg>
        Reglamento Torneo
      </button>
    </div>
  </div>
</div>

<div id="content">
