// ── AUTH ──────────────────────────────────────────────────────────────────────
async function loginAdmin(e) {
  e.preventDefault();
  const errEl = document.getElementById('admin-error');
  const btn = document.getElementById('admin-btn');
  errEl.style.display = 'none';
  btn.disabled = true; btn.textContent = 'Ingresando...';
  const json = await api('checkLogin', {
    email:    document.getElementById('admin-email').value.trim(),
    password: document.getElementById('admin-pass').value,
  });
  btn.disabled = false; btn.textContent = 'INGRESAR';
  if (json.success) {
    SESSION = { rol: 'admin', token: json.token, nombre: json.nombre, email: json.email };
    closeModal('modal-login-admin');
    initPanel();
  } else {
    errEl.textContent = json.message || 'Error al ingresar';
    errEl.style.display = 'block';
  }
}

async function loginOrg(e) {
  e.preventDefault();
  const errEl = document.getElementById('org-error');
  const btn = document.getElementById('org-btn');
  errEl.style.display = 'none';
  btn.disabled = true; btn.textContent = 'Ingresando...';
  const json = await api('checkLogin', {
    email:    document.getElementById('org-email').value.trim(),
    password: document.getElementById('org-pass').value,
  });
  btn.disabled = false; btn.textContent = 'INGRESAR';
