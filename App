<script>
// ── CONFIG ────────────────────────────────────────────────────────────────────
const SUPA_URL  = 'https://bhnmdkfvfpvvddqalazl.supabase.co';
const SUPA_ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJobm1ka2Z2ZnB2dmRkcWFsYXpsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg4NDQ0NDUsImV4cCI6MjA5NDQyMDQ0NX0.6KSs8JsZG2Dt70XePy2bOrTnWazju3Y--d7OXIZg9xw';
const FN = '/.netlify/functions/admin';

// Estado de sesión
let SESSION = null; // { rol, token, nombre, org_id, ciudad }
let TORNEO_ACTUAL = null;
let CATEGORIAS = [];
let EQUIPOS = {};

// ── SUPABASE FETCH ────────────────────────────────────────────────────────────
async function supa(table, params = '') {
  const res = await fetch(`${SUPA_URL}/rest/v1/${table}${params}`, {
    headers: { apikey: SUPA_ANON, Authorization: 'Bearer ' + SUPA_ANON }
  });
  return res.json();
}

// ── API CALL ──────────────────────────────────────────────────────────────────
async function api(action, data = {}) {
  const body = { action, ...data };
  if (SESSION?.token) body.token = SESSION.token;
  const res = await fetch(FN, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  return res.json();
}

// ── TOAST ─────────────────────────────────────────────────────────────────────
function toast(msg, type = '') {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = 'toast show ' + type;
  setTimeout(() => el.classList.remove('show'), 3000);
}

// ── MODALES ───────────────────────────────────────────────────────────────────
function openModal(id) {
  document.getElementById(id).classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeModal(id) {
  document.getElementById(id).classList.remove('open');
  document.body.style.overflow = '';
}
function handleOverlay(e, id) {
  if (e.target === document.getElementById(id)) closeModal(id);
}
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.open').forEach(m => m.classList.remove('open'));
});

// ── TEMA ──────────────────────────────────────────────────────────────────────
function toggleTheme() {
  const dark = document.documentElement.getAttribute('data-theme') === 'dark';
  document.documentElement.setAttribute('data-theme', dark ? 'light' : 'dark');
  try { localStorage.setItem('ap_theme', dark ? 'light' : 'dark'); } catch(e) {}
}
(function() {
  try { const t = localStorage.getItem('ap_theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch(e) {}
})();

// ── VISTAS ────────────────────────────────────────────────────────────────────
function showView(id) {
  document.getElementById('pub-view').style.display   = id === 'pub-view'    ? 'flex'  : 'none';
  document.getElementById('torneo-view').style.display = id === 'torneo-view' ? 'flex'  : 'none';
  document.getElementById('panel-view').style.display  = id === 'panel-view'  ? 'flex'  : 'none';
}

// ── VISTA PÚBLICA — TORNEOS ───────────────────────────────────────────────────
async function loadTorneos() {
  const list = document.getElementById('torneos-list');
  try {
    const torneos = await supa('torneos', '?select=id,nombre,ciudad,deporte,temporada,descripcion,visible&visible=eq.true&estado=neq.eliminado&order=created_at.desc');
    if (!torneos || torneos.error || !torneos.length) {
      list.innerHTML = `<div style="text-align:center;padding:48px 20px">
        <div style="font-size:48px;margin-bottom:16px;opacity:.2">🏀</div>
        <div style="font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:900;color:var(--text);margin-bottom:8px">Sin torneos activos aún</div>
        <div style="font-size:13px;color:var(--text2);margin-bottom:20px">Sé el primero en publicar tu torneo</div>
        <button class="btn-solid btn-orange" onclick="openModal('modal-solicitud')" style="padding:12px 28px;font-size:14px;border-radius:12px">PUBLICAR MI LIGA →</button>
      </div>`;
      return;
    }
    list.innerHTML = torneos.map(t => `
      <div class="torneo-card" onclick="abrirTorneo('${t.id}','${esc(t.nombre)}','${esc(t.ciudad)}','${esc(t.temporada||'')}')">
        <div class="torneo-card-header">
          <div>
            <div class="torneo-nombre">${t.nombre}</div>
            <div class="torneo-ciudad">📍 ${t.ciudad} ${t.temporada ? '· ' + t.temporada : ''}</div>
          </div>
          <span class="badge badge-active">● Activo</span>
        </div>
        ${t.descripcion ? `<div style="font-size:13px;color:var(--text2);margin-bottom:10px">${t.descripcion}</div>` : ''}
        <div style="font-size:11px;color:var(--text3)">${t.deporte || 'Básquetbol'} · Toca para ver tabla y fixture →</div>
      </div>
    `).join('');
  } catch(e) {
    list.innerHTML = '<div style="text-align:center;padding:32px;color:var(--text2);font-size:13px">Error al cargar torneos</div>';
  }
}

function esc(str) { return (str||'').replace(/'/g, "\\'").replace(/"/g, '&quot;'); }

// ── VISTA TORNEO ──────────────────────────────────────────────────────────────
async function abrirTorneo(id, nombre, ciudad, temporada) {
  TORNEO_ACTUAL = { id, nombre, ciudad, temporada };
  document.getElementById('tv-nombre').textContent = nombre;
  document.getElementById('tv-temporada-lbl').textContent = (temporada ? temporada.toUpperCase() : '') + (ciudad ? ' · ' + ciudad.toUpperCase() : '');
  showView('torneo-view');
  // Reset
  document.querySelectorAll('.tv-nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('tnav-fixture').classList.add('active');
  ['tab-fixture','tab-resultados','tab-posiciones','tab-clubes','tab-noticias','tab-sanciones'].forEach(t => {
    const el = document.getElementById(t);
    if (el) { el.style.display = t === 'tab-fixture' ? 'block' : 'none'; el.innerHTML = ''; }
  });
  CAT_ACTUAL = null;
  await loadCategorias(id);
}

function volverPublico() {
  TORNEO_ACTUAL = null;
  showView('pub-view');
  loadTorneos();
}

function showTab(tabId, btn) {
  document.querySelectorAll('.tv-nav-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  ['tab-fixture','tab-resultados','tab-posiciones','tab-clubes','tab-noticias','tab-sanciones'].forEach(t => {
    const el = document.getElementById(t);
    if (el) el.style.display = t === tabId ? 'block' : 'none';
  });
  if (!TORNEO_ACTUAL) return;
  const tab = tabId.replace('tab-','');
  if (tab === 'fixture')    renderFixture();
  if (tab === 'resultados') renderResultados();
  if (tab === 'posiciones') renderPosiciones();
  if (tab === 'clubes')     renderClubes();
  if (tab === 'noticias')   renderNoticias();
  if (tab === 'sanciones')  renderSanciones();
}

var CAT_ACTUAL = null;

async function loadCategorias(torneo_id) {
  CATEGORIAS = [];
  EQUIPOS    = {};
  const cats = await supa('categorias', '?torneo_id=eq.' + torneo_id + '&activo=eq.true&order=orden');
  CATEGORIAS = cats || [];
  // Renderizar grid de ligas
  const grid = document.getElementById('tv-ligas-grid');
  if (!grid) return;
  if (!CATEGORIAS.length) {
    grid.innerHTML = '<div style="color:rgba(255,255,255,.4);font-size:12px;padding:8px">Sin categorías registradas.</div>';
  } else {
    grid.innerHTML = CATEGORIAS.map((c, i) =>
      '<button class="tv-liga-btn' + (i===0?' active':'') + '" onclick="selCat(this,'' + c.id + '')">'
      + '<div class="tv-liga-btn-name">' + c.nombre + '</div>'
      + '</button>'
    ).join('');
    CAT_ACTUAL = CATEGORIAS[0].id;
    // Precargar equipos
    const eqs = await supa('equipos', '?categoria_id=eq.' + CATEGORIAS[0].id + '&activo=eq.true&order=nombre');
    EQUIPOS[CATEGORIAS[0].id] = eqs || [];
  }
  renderFixture();
}

function selCat(btn, catId) {
  document.querySelectorAll('.tv-liga-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  CAT_ACTUAL = catId;
  renderTabActual();
}

function getCatActual() {
  if (CAT_ACTUAL) return CATEGORIAS.find(c => c.id === CAT_ACTUAL) || CATEGORIAS[0] || null;
  return CATEGORIAS[0] || null;
}

function renderTabActual() {
  const activeBtn = document.querySelector('.tv-nav-btn.active');
  if (!activeBtn) { renderFixture(); return; }
  const onclick = activeBtn.getAttribute('onclick') || '';
  const tab = onclick.match(/tab-(\w+)/);
  if (tab) showTab('tab-' + tab[1], null);
  else renderFixture();
}

// ── Partido Card ──────────────────────────────────────────────────────
function buildPartidoCard(p, finalizado) {
  const local  = p.local  || { nombre: '?' };
  const visita = p.visita || { nombre: '?' };
  const lWin = finalizado && (p.pts_local > p.pts_visita);
  const vWin = finalizado && (p.pts_visita > p.pts_local);
  const enVivo = p.estado === 'en_vivo';
  const liga = getCatActual();
  const fechaLbl = p.fecha ? formatFecha(p.fecha) : '';
  const hora  = p.hora ? ' · ' + p.hora : '';
  const cancha = p.cancha ? ' · ' + p.cancha : '';

  let h = '<div class="mc">';
  // Top bar
  h += '<div class="mc-top">';
  h += '<span class="mc-top-info">' + (fechaLbl + hora) + '</span>';
  if (finalizado)   h += '<span class="mc-badge mc-badge-final">Final</span>';
  else if (enVivo)  h += '<span class="mc-badge mc-badge-live"><span style="display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--red);margin-right:3px;animation:pulse 1s infinite;vertical-align:middle"></span>En Vivo</span>';
  else              h += '<span class="mc-badge mc-badge-prox">Próximo</span>';
  h += '</div>';
  // Teams + score
  h += '<div class="mc-teams">';
  h += '<div class="mc-team' + (lWin?' win':'') + '">' + local.nombre + '</div>';
  if (finalizado) {
    h += '<div class="mc-score">' + (p.pts_local||0) + '–' + (p.pts_visita||0) + '</div>';
  } else {
    h += '<div class="mc-vs">VS</div>';
  }
  h += '<div class="mc-team right' + (vWin?' win':'') + '">' + visita.nombre + '</div>';
  h += '</div>';
  // Footer
  h += '<div class="mc-footer">';
  h += '<div class="mc-meta">';
  h += '<span>N° ' + (p.nro_fecha||'') + '</span>';
  if (p.fase && p.fase !== 'Fase Regular') h += '<span class="mc-meta-sep">·</span><span style="color:var(--orange);font-weight:700">' + p.fase + '</span>';
  if (cancha) h += '<span class="mc-meta-sep">·</span><span>' + p.cancha + '</span>';
  h += '</div>';
  if (p.url_transmision) {
    h += '<a href="' + p.url_transmision + '" target="_blank" class="mc-yt">';
    h += '<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.25 8.25 0 004.83 1.56V6.81a4.85 4.85 0 01-1.06-.12z"/></svg>';
    h += 'Ver en vivo</a>';
  }
  h += '</div></div>';
  return h;
}

// ── FIXTURE ───────────────────────────────────────────────────────────
async function renderFixture() {
  const el = document.getElementById('tab-fixture');
  const cat = getCatActual();
  if (!cat) { el.innerHTML = '<div style="padding:20px;color:var(--text2);text-align:center">Sin categorías.</div>'; return; }
  el.innerHTML = '<div style="padding:20px;text-align:center;color:var(--text2);font-size:13px">Cargando...</div>';
  const partidos = await supa('partidos',
    '?categoria_id=eq.' + cat.id
    + '&select=*,local:equipo_local(nombre),visita:equipo_visita(nombre)'
    + '&estado=neq.finalizado&order=nro_fecha,fecha,hora');
  if (!partidos || !partidos.length) {
    el.innerHTML = '<div style="padding:20px;color:var(--text2);font-size:13px;text-align:center">Sin partidos programados en ' + cat.nombre + '.</div>';
    return;
  }
  let h = '<div class="tv-sec-label">Próximos partidos</div>';
  partidos.forEach(function(p) { h += buildPartidoCard(p, false); });
  el.innerHTML = h;
}

