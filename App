window.updateDelPanelEquipo = function() { updateDelCupo(); };

function updateDelCupo() {
  const eqId = document.getElementById('del-eq-sel')?.value;
  const cat   = document.getElementById('del-cat')?.value;
  const el    = document.getElementById('del-cupo');
  if (!el || !cat || !eqId) return;
  const count   = D.personas.filter(p => p.id_equipo === eqId && p.rol === 'jugador' && p.categoria === cat).length;
  const restantes = 15 - count;
  const eqNom = D.equipos.find(e => e.ID === eqId)?.NombreEquipo || '';
  el.textContent = `${eqNom} · ${count}/15 · ${restantes > 0 ? restantes + ' cupos disponibles' : '⚠ Cupo completo'}`;
  el.style.color = restantes <= 0 ? 'var(--red)' : restantes <= 3 ? 'var(--orange)' : 'var(--muted)';
}

function renderNominaDelList(eqId) {
  const el = document.getElementById('del-nomina-' + eqId) || document.getElementById('del-nomina-list');
  if (!el) return;
  const personas = D.personas.filter(p => p.id_equipo === eqId);
  if (!personas.length) {
    el.innerHTML = '<div style="font-size:13px;color:var(--muted);padding:4px 0">Sin jugadores registrados.</div>';
    return;
  }
  const cats = {};
  personas.forEach(p => {
    const cat = p.rol === 'jugador' ? p.categoria : p.rol === 'cuerpo_tecnico' ? 'Cuerpo técnico' : 'Delegados';
    if (!cats[cat]) cats[cat] = [];
    cats[cat].push(p);
  });
  el.innerHTML = Object.entries(cats).map(([cat, ps]) => `
    <div style="margin-bottom:8px">
      <div style="font-size:10px;font-weight:700;color:var(--muted2);letter-spacing:.8px;text-transform:uppercase;padding:4px 0">${cat}</div>
      <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--r);overflow:hidden">
        ${ps.map(p => {
          const anio = p.fecha_nacimiento ? new Date(p.fecha_nacimiento).getFullYear() : '—';
          const fed  = p.federado ? '<span style="font-size:9px;color:var(--green);font-weight:700;margin-left:4px">• Federado</span>' : '';
          return `<div style="display:flex;align-items:center;gap:10px;padding:9px 14px;border-bottom:1px solid var(--border)">
