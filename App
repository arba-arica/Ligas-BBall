// ─── AGENDA ──────────────────────────────────────────────────────────────────
function bloqueHorario(hora) {
  if (!hora) return 'Día';
  const h = parseInt(String(hora).split(':')[0]) || 0;
  if (h < 13) return 'Mañana';
  if (h < 19) return 'Tarde';
  return 'Noche';
}

function renderAgenda() {
  const el = document.getElementById('agenda-list');
  const badge = document.getElementById('badge-ag');
  const ahora = new Date();
  const partidos = D.partidos.filter(p => p.Estado === 'Programado')
    .sort((a,b) => {
      const ja = parseInt(a.Partidos) || 9999;
      const jb = parseInt(b.Partidos) || 9999;
      if (ja !== jb) return ja - jb;
      const fa = new Date(cleanFecha(a.Fecha)+'T12:00:00');
      const fb = new Date(cleanFecha(b.Fecha)+'T12:00:00');
      if (fa - fb !== 0) return fa - fb;
      return (a.Hora||'').localeCompare(b.Hora||'');
    });
  badge.textContent = partidos.length + ' partidos';
  if (!partidos.length) { el.innerHTML = empty('📅','Sin partidos programados'); return; }

  // Encontrar el partido más próximo
  let proximoIdx = 0;
  let menorDif = Infinity;
  partidos.forEach((p, i) => {
    const f = cleanFecha(p.Fecha);
    const h = fmtTime(p.Hora).replace(' hrs','') || '00:00';
    const dt = new Date(f + 'T' + h + ':00');
    const dif = dt - ahora;
    if (dif >= 0 && dif < menorDif) { menorDif = dif; proximoIdx = i; }
  });

  // Agrupar por fecha + bloque horario
  const grupos = {};
  partidos.forEach(p => {
    const f = cleanFecha(p.Fecha);
    const bloque = bloqueHorario(p.Hora);
    const key = f + '||' + bloque;
    if (!grupos[key]) grupos[key] = { fecha: f, bloque, partidos: [] };
    grupos[key].partidos.push(p);
  });

  // Ordenar grupos por fecha luego bloque
  const bloqueOrd = { 'Mañana':0, 'Tarde':1, 'Noche':2, 'Día':3 };
  const gruposOrdenados = Object.values(grupos).sort((a,b) => {
    const fa = new Date(a.fecha+'T12:00:00');
    const fb = new Date(b.fecha+'T12:00:00');
    if (fa-fb !== 0) return fa-fb;
    return (bloqueOrd[a.bloque]||0) - (bloqueOrd[b.bloque]||0);
