    const eqKey   = p.id_equipo || 'sin';
    const eqNom   = eq ? eq.NombreEquipo : '?';
    if (!porLiga[ligaKey]) porLiga[ligaKey] = { nombre: ligaNom, equipos: {} };
    if (!porLiga[ligaKey].equipos[eqKey]) porLiga[ligaKey].equipos[eqKey] = { nombre: eqNom, personas: [] };
    porLiga[ligaKey].equipos[eqKey].personas.push(p);
  });
  el.innerHTML = Object.entries(porLiga).map(([, liga]) =>
    `<div style="margin-bottom:14px">
