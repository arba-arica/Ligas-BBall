async function aprobarSolicitud(id) {
  if (!confirm('¿Aprobar esta solicitud y generar acceso al organizador?')) return;
  toast('Procesando...', '');
  const json = await api('aprobarSolicitud', { id });
  if (json.success) {
    toast('✓ Aprobada — ' + json.org_id, 'ok');
    // Mostrar modal con credenciales
    mostrarCredenciales(json.org_id, json.clave_acceso, json.email);
    renderPanel('p-solicitudes');
  } else {
    toast(json.message || 'Error', 'err');
  }
}

