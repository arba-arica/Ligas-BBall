// ── SANCIONES ─────────────────────────────────────────────────────────
async function renderSanciones() {
  const el = document.getElementById('tab-sanciones');
  const cat = getCatActual();
  if (!cat) { el.innerHTML = '<div style="padding:20px;color:var(--text2)">Sin categorías.</div>'; return; }
  el.innerHTML = '<div style="padding:20px;text-align:center;color:var(--text2);font-size:13px">Cargando...</div>';
  const sancs = await supa('sanciones', '?categoria_id=eq.' + cat.id + '&order=created_at.desc');
  let h = '<div class="tv-sec-label">Sanciones</div>';
  if (!sancs || !sancs.length) {
    h += '<div style="padding:16px;color:var(--text2);font-size:13px;text-align:center">Sin sanciones en ' + cat.nombre + '.</div>';
  } else {
    sancs.forEach(function(s, i) {
      h += '<div class="san-card" onclick="toggleSanAcc(' + i + ')">';
      h += '<div class="san-header">';
      h += '<span class="san-type">' + (s.tipo||'Sanción') + '</span>';
      h += '<span style="background:rgba(239,68,68,.12);color:var(--red);font-size:10px;font-weight:700;padding:2px 8px;border-radius:100px">Sancionado</span>';
      h += '</div>';
      h += '<div class="san-player">' + (s.jugador_nombre||'Sin nombre') + '</div>';
      h += '<div class="san-detail" id="san-body-' + i + '" style="display:none">';
      if (s.descripcion) h += s.descripcion + '<br>';
      if (s.fecha_fin)   h += '<span style="color:var(--orange);font-size:11px">Hasta: ' + formatFecha(s.fecha_fin,'corto') + '</span>';
      if (s.fecha_apelacion) h += '<br><span style="color:var(--blue);font-size:11px">Apelación: ' + formatFecha(s.fecha_apelacion,'corto') + '</span>';
      h += '</div>';
      h += '</div>';
    });
  }
  el.innerHTML = h;
  window.toggleSanAcc = function(i) {
    const el2 = document.getElementById('san-body-' + i);
    if (el2) el2.style.display = el2.style.display === 'none' ? 'block' : 'none';
  };
}

function compartirTorneo() {
  const url = window.location.href;
  if (navigator.share) {
    navigator.share({ title: TORNEO_ACTUAL ? TORNEO_ACTUAL.nombre : 'ACTIVA PLAY', url: url });
  } else if (navigator.clipboard) {
    navigator.clipboard.writeText(url).then(function() { toast('Link copiado', 'ok'); });
  }
}
