  var h='<div class="tv-sec-label">Tabla de posiciones</div>';
  if(!rows||!rows.length){h+='<div style="padding:16px;color:var(--text2);font-size:13px;text-align:center">Sin partidos finalizados aún.</div>';}
  else{
    rows.sort(function(a,b){var da=Number(a.gf||0)-Number(a.gc||0),db=Number(b.gf||0)-Number(b.gc||0);return(Number(b.pts)||0)-(Number(a.pts)||0)||db-da||(Number(b.gf||0))-(Number(a.gf||0));});
    h+='<div class="st-wrap"><table class="st-table"><thead><tr><th>#</th><th>Equipo</th><th>PJ</th><th>G</th><th>E</th><th>P</th><th>GF</th><th>GC</th><th>Dif</th><th>Pts</th></tr></thead><tbody>';
    rows.forEach(function(r,i){var dg=Number(r.gf||0)-Number(r.gc||0),rc=i===0?'rk-1':i===1?'rk-2':i===2?'rk-3':'';h+='<tr><td><span class="rk '+rc+'">'+(i+1)+'</span></td><td><span class="color-dot" style="background:'+(r.color||'#475569')+'"></span>'+r.equipo_nombre+'</td><td>'+r.pj+'</td><td>'+r.pg+'</td><td>'+r.pe+'</td><td>'+r.pp+'</td><td>'+r.gf+'</td><td>'+r.gc+'</td><td class="'+(dg>0?'dif-pos':dg<0?'dif-neg':'')+'">'+(dg>0?'+':'')+dg+'</td><td><span class="pts-cell">'+r.pts+'</span></td></tr>';});
    h+='</tbody></table></div>';
  }
  h+='<div class="tv-sec-label">Reportes y documentos</div>';
  h+='<button class="pdf-btn-dark" onclick="generarPDFFixture()"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>Descargar Programación PDF</button>';
  h+='<button class="pdf-btn-dark" onclick="generarPDFTabla()"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>Descargar Tabla de Posiciones PDF</button>';
  h+='<button class="pdf-btn-dark pdf-btn-ghost" onclick="generarPDFResultados()"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>Descargar Resultados PDF</button>';
  h+='<div style="text-align:center;padding:8px 0"><button class="tv-admin-btn" onclick="pdfopenAdmin()">⚙ Acceso administrador</button></div>';
  el.innerHTML=h;
