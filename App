function toggleAllVal(chk) {
  document.querySelectorAll('.val-chk').forEach(c => c.checked = chk.checked);
  updateValBar();
}

function updateValBar() {
  const sel = document.querySelectorAll('.val-chk:checked');
  const bar = document.getElementById('val-bar');
  const cnt = document.getElementById('val-bar-count');
  bar.classList.toggle('show', sel.length > 0);
  if (cnt) cnt.textContent = `${sel.length} seleccionado${sel.length !== 1 ? 's' : ''}`;
  const chkAll = document.getElementById('chk-all-val');
  if (chkAll) chkAll.checked = sel.length > 0 && sel.length === document.querySelectorAll('.val-chk').length;
}

window.validarSeleccion = function(accion) {
  const ids = [...document.querySelectorAll('.val-chk:checked')].map(c => c.value);
  if (!ids.length) return toast('Selecciona al menos uno','err');
  showConfirmV3(
    accion === 'aprobar' ? `¿Aprobar ${ids.length} jugador(es)?` : `¿Rechazar ${ids.length} jugador(es)?`,
    accion === 'aprobar' ? 'Pasarán a estado Oficial en la app.' : 'Se notificará a cada delegado.',
    async () => {
      const res = await gasCall('validatePersona', { accion, ids });
      closeConfirmV3();
      if (res && res.success) {
        toast(`✓ ${res.message}`, 'ok');
        await refreshData();
        renderValidarAdm();
        renderJugadores();
      } else {
        toast(res?.message || 'Error', 'err');
      }
    },
    accion === 'aprobar' ? 'ok' : 'danger'
  );
};

