  try{
    var params=new URLSearchParams(window.location.search);
    var ligaId=params.get('liga');
    if(ligaId){
      var r=await fetch(SUPA_URL+'/rest/v1/torneos?id=eq.'+ligaId+'&select=id,nombre,ciudad,temporada&visible=eq.true&limit=1',
        {headers:{apikey:SUPA_ANON,Authorization:'Bearer '+SUPA_ANON}});
      var data=await r.json();
      if(Array.isArray(data)&&data.length){
        var t=data[0];
        await abrirTorneo(t.id,t.nombre,t.ciudad||'',t.temporada||'');
      }
    }
  }catch(e){}
})();
</script>
