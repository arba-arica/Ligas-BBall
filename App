            eqHtml += '<button class="btn-sm" onclick="editarEquipoModal(this)" data-id="' + e.id + '" data-nombre="' + e.nombre.replace(/"/g,'&quot;') + '" data-color="' + (e.color_local||'#1d4ed8') + '">Editar</button>';
            eqHtml += '<button class="btn-sm btn-sm-danger" onclick="eliminarEquipo(this)" data-id="' + e.id + '">Eliminar</button>';
            eqHtml += '</div></div>';
          });
        }
        eqHtml += '</div>';
      }
      main.innerHTML = '<div class="panel-content"><div class="panel-title">Equipos</div>'
        + '<div class="panel-sub">Torneo: ' + torneo2.nombre + '</div>'
        + (!catsEq.length ? '<div style="padding:20px;color:var(--text2)">Primero crea las categorías.</div>' : eqHtml)
        + '</div>';
      break;
    }

    case 'p-fixture': {
      const jtf = await api('getMiTorneo');
      const torneoFix = jtf.data;
      if (!torneoFix) { main.innerHTML = '<div class="panel-content"><div class="panel-title">Fixture</div><div style="padding:20px;color:var(--text2)">Primero crea un torneo.</div></div>'; break; }
      const jcf = await api('getMisCategorias', { torneo_id: torneoFix.id });
      const catsFix = jcf.data || [];
      const catOpts = catsFix.map(c => '<option value="' + c.id + '">' + c.nombre + '</option>').join('');
      main.innerHTML = '<div class="panel-content">'
        + '<div class="panel-title">Fixture</div>'
        + '<div class="panel-sub">Programa los partidos manualmente</div>'
        + '<div class="p-card" style="margin-bottom:16px">'
        + '<div class="f-row"><div class="f-group"><label class="f-label">N° Partido</label><input class="f-input" id="fix-nro" type="number" value="1" min="1" placeholder="1"></div>'
        + '<div class="f-group"><label class="f-label">Categoría</label><select class="f-select" id="fix-cat" onchange="loadEquiposFixture(this.value)">' + catOpts + '</select></div></div>'
        + '<div class="f-row"><div class="f-group"><label class="f-label">Equipo local</label><select class="f-select" id="fix-local"></select></div>'
        + '<div class="f-group"><label class="f-label">Equipo visita</label><select class="f-select" id="fix-visita"></select></div></div>'
        + '<div class="f-row"><div class="f-group"><label class="f-label">Fecha</label><input class="f-input" id="fix-fecha" type="date"></div>'
        + '<div class="f-group"><label class="f-label">Hora</label><input class="f-input" id="fix-hora" type="time"></div></div>'
        + '<div class="f-row"><div class="f-group"><label class="f-label">Cancha</label><input class="f-input" id="fix-cancha" type="text" placeholder="Nombre de la cancha"></div>'
        + '<div class="f-group"><label class="f-label">Fase</label><input class="f-input" id="fix-fase" type="text" value="Fase Regular"></div></div>'
        + '<div class="f-group"><label class="f-label">URL Transmisión en vivo (opcional)</label><input class="f-input" id="fix-url" type="url" placeholder="https://youtube.com/..."></div>'
        + '<button class="btn-sm btn-sm-primary" onclick="crearPartido()">+ Programar partido</button>'
