  var catId = document.getElementById('fix-cat') ? document.getElementById('fix-cat').value : null;
  if (res.success && catId) cargarPartidosFixture(catId);
}

async function guardarResultado(btn) {
  var id = btn.dataset.id;
  var loc = parseInt(document.getElementById('r-loc-'+id).value);
  var vis = parseInt(document.getElementById('r-vis-'+id).value);
  if (isNaN(loc) || isNaN(vis)) { toast('Ingresa los puntos', 'err'); return; }
  var data = { id: id, pts_local: loc, pts_visita: vis };
  ['1','2','3','4'].forEach(function(q) {
    var ql = parseInt((document.getElementById('q'+q+'-loc-'+id)||{}).value);
    var qv = parseInt((document.getElementById('q'+q+'-vis-'+id)||{}).value);
    if (!isNaN(ql)) { data['q'+q+'_local'] = ql; data['q'+q+'_visita'] = isNaN(qv) ? 0 : qv; }
  });
  var res = await api('actualizarResultado', data);
  toast(res.success ? 'Resultado guardado' : res.message, res.success ? 'ok' : 'err');
  if (res.success) renderPanel('p-resultados');
}

