// ── PANEL ─────────────────────────────────────────────────────────────────────
function initPanel() {
  showView('panel-view');
  document.getElementById('panel-user-name').textContent = SESSION.nombre;
  const badge = document.getElementById('panel-role-badge');
  if (SESSION.rol === 'admin') {
    badge.textContent = 'Admin';
    badge.style.cssText = 'background:rgba(29,78,216,.2);color:#93c5fd;border:1px solid rgba(29,78,216,.3);font-size:10px;padding:2px 8px;border-radius:100px';
    document.getElementById('sidebar-admin').style.display = 'flex';
    document.getElementById('sidebar-org').style.display = 'none';
    showPanel('p-solicitudes', document.querySelector('#sidebar-admin .sb-btn'));
  } else {
