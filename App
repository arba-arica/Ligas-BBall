  showConfirmV3(`¿Crear liga "${nombre}"?`,'',async()=>{
    const ciudad = document.getElementById('lg-ciudad')?.value.trim() || '';
    await _origGasCall('createLeague',{
      nombreDeporte:  'Básquetbol',
      categoria:      document.getElementById('lg-cat').value,
      nombreFantasia: nombre,
      estadoTorneo:   document.getElementById('lg-estado').value,
      ciudadNombre:   ciudad,
      orgId:          (document.getElementById('lg-orgid')?.value.trim().toUpperCase()) || null,
      nroEquipos:     parseInt(document.getElementById('lg-equipos')?.value) || null,
    });
    if (document.getElementById('lg-ciudad'))  document.getElementById('lg-ciudad').value = '';
    if (document.getElementById('lg-orgid'))   document.getElementById('lg-orgid').value = '';
    if (document.getElementById('lg-equipos')) document.getElementById('lg-equipos').value = '';
    document.getElementById('lg-nombre').value='';
  },'ok');
};
