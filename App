async function crearEquipo(btn) {
  const categoria_id = btn ? btn.dataset.cat : null;
  if (!categoria_id) { toast('Error al obtener categoría', 'err'); return; }
  const nombre = document.getElementById('eq-nom-' + categoria_id)?.value.trim();
  const color  = document.getElementById('eq-col-' + categoria_id)?.value || '#1d4ed8';
  if (!nombre) { toast('Ingresa el nombre del equipo', 'err'); return; }
  const json = await api('crearEquipo', { categoria_id, nombre, color_local: color });
  toast(json.success ? '✓ Equipo creado' : json.message, json.success ? 'ok' : 'err');
  if (json.success) renderPanel('p-equipos');
}

async function eliminarEquipo(btn) {
