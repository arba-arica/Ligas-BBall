async function renderSancionesPanel(){var cats=await getCats();var h='<div class="panel-content"><div class="panel-title">Sanciones</div>';if(!cats.length){setMain(h+'<div class="panel-sub">Crea categorías primero</div></div>');return;}h+='<div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap"><select class="f-select" id="san-cat-sel" onchange="cargarSancionesPanel(this.value)" style="max-width:220px">';cats.forEach(function(c){h+='<option value="'+c.id+'">'+c.nombre+'</option>';});h+='</select><button class="btn-sm btn-sm-primary" onclick="abrirCrearSancion()">+ Nueva sanción</button></div><div id="sanciones-panel-list"></div></div>';setMain(h);cargarSancionesPanel(cats[0].id);}
async function cargarSancionesPanel(catId){var el=document.getElementById('sanciones-panel-list');if(!el)return;el.innerHTML='<div style="color:var(--text2);font-size:13px;padding:12px">Cargando...</div>';var r=await api('getSancionesCategoria',{categoria_id:catId});if(!r.success||!r.data.length){el.innerHTML='<div class="p-card" style="text-align:center;padding:24px;color:var(--text2)">Sin sanciones.</div>';return;}var h='';r.data.forEach(function(s){h+='<div class="san-card" style="cursor:default"><div class="san-header"><span class="san-type">'+(s.tipo||'Sanción')+'</span><div class="p-card-actions" style="margin:0"><button class="btn-sm" onclick="abrirEditarSancion(\''+s.id+'\','+encodeURIComponent(JSON.stringify(s))+')">Editar</button><button class="btn-sm btn-sm-danger" onclick="eliminarSancion(\''+s.id+'\')">✕</button></div></div><div class="san-player">'+(s.jugador_nombre||'Sin nombre')+'</div>'+(s.descripcion?'<div class="san-detail" style="display:block">'+s.descripcion+'</div>':'')+(s.fecha_fin?'<div style="font-size:11px;color:var(--orange);margin-top:4px">Hasta: '+s.fecha_fin+'</div>':'')+'</div>';});el.innerHTML=h;}
async function abrirCrearSancion(){var catId=document.getElementById('san-cat-sel')?document.getElementById('san-cat-sel').value:'';var re=await api('getEquiposCategoria',{categoria_id:catId});var eqs=(re.success&&re.data)?re.data:[];var optsEq='<option value="">Sin equipo</option>'+eqs.map(function(e){return'<option value="'+e.id+'">'+e.nombre+'</option>';}).join('');openInlineModal('<div class="modal-title">Nueva sanción</div><div class="f-group"><label class="f-label">Jugador / Persona</label><input class="f-input" id="ns-jugador" placeholder="Nombre del sancionado"></div><div class="f-group"><label class="f-label">Equipo</label><select class="f-select" id="ns-equipo">'+optsEq+'</select></div><div class="f-group"><label class="f-label">Tipo</label><select class="f-select" id="ns-tipo"><option>Amonestación</option><option>Suspensión</option><option>Expulsión</option><option>Multa</option><option>Otra</option></select></div><div class="f-group"><label class="f-label">Descripción</label><textarea class="f-input" id="ns-desc" rows="2" placeholder="Detalle..."></textarea></div><div class="f-group"><label class="f-label">Fecha de término</label><input class="f-input" id="ns-fin" type="date"></div><button class="f-submit" onclick="guardarNuevaSancion(\''+catId+'\')">REGISTRAR</button>');}
async function guardarNuevaSancion(catId){
  var j=document.getElementById('ns-jugador').value.trim();
  if(!j){toast('Nombre obligatorio','err');return;}
  var r=await api('crearSancion',{categoria_id:catId,jugador_nombre:j,equipo_id:document.getElementById('ns-equipo').value||null,tipo:document.getElementById('ns-tipo').value,descripcion:document.getElementById('ns-desc').value.trim()||null,fecha_fin:document.getElementById('ns-fin').value||null,fecha_apelacion:document.getElementById('ns-apelacion')?document.getElementById('ns-apelacion').value||null:null});
