}

function getCatActual() {
  if (CAT_ACTUAL) return CATEGORIAS.find(c => c.id === CAT_ACTUAL) || CATEGORIAS[0] || null;
  return CATEGORIAS[0] || null;
}

function renderTabActual() {
  const activeBtn = document.querySelector('.tv-nav-btn.active');
  if (!activeBtn) { renderFixture(); return; }
  const onclick = activeBtn.getAttribute('onclick') || '';
  const tab = onclick.match(/tab-(\w+)/);
  if (tab) showTab('tab-' + tab[1], null);
  else renderFixture();
}

