    var badge = document.getElementById('sb-badge-sol');
    if (badge) { badge.textContent = pendientes.length; badge.style.display = pendientes.length ? 'inline' : 'none'; }
    var h = '<div class="panel-content"><div class="panel-title">Solicitudes</div>'
          + '<div class="panel-sub">' + sols.length + ' total · ' + pendientes.length + ' pendientes</div>';
    if (!sols.length) {
      h += '<div class="p-card" style="text-align:center;padding:28px;color:var(--text2)">Sin solicitudes aún.</div>';
