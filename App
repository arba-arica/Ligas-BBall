async function enviarSolicitud(e) {
  e.preventDefault();
  const errEl = document.getElementById('sol-error');
  const btn   = document.getElementById('sol-btn');
  errEl.style.display = 'none';
  btn.disabled = true; btn.textContent = 'Enviando...';
  const json = await api('crearSolicitud', {
    nombre:          document.getElementById('sol-nombre').value.trim(),
    email:           document.getElementById('sol-email').value.trim(),
    telefono:        document.getElementById('sol-tel').value.trim(),
    ciudad:          document.getElementById('sol-ciudad').value.trim(),
    deporte:         document.getElementById('sol-deporte').value.trim() || 'Básquetbol',
    descripcion:     document.getElementById('sol-desc').value.trim(),
    cant_categorias: parseInt(document.getElementById('sol-cats').value) || 1,
  });
  btn.disabled = false; btn.textContent = 'ENVIAR SOLICITUD';
  if (json.success) {
    document.getElementById('sol-email-confirm').textContent = document.getElementById('sol-email').value;
    document.getElementById('sol-form-wrap').style.display = 'none';
    document.getElementById('sol-success').style.display = 'block';
  } else {
    errEl.textContent = json.message || 'Error al enviar';
    errEl.style.display = 'block';
  }
}

// ── UTILIDADES ────────────────────────────────────────────────────────────────
function formatFecha(str, tipo = 'normal') {
  if (!str) return '—';
  try {
    const d = new Date(str);
    if (tipo === 'corto') return d.toLocaleDateString('es-CL', { day:'2-digit', month:'short' });
    if (tipo === 'fecha') return d.toLocaleDateString('es-CL', { day:'2-digit', month:'short', year:'numeric' });
    return d.toLocaleDateString('es-CL', { weekday:'short', day:'2-digit', month:'short' });
  } catch(e) { return str; }
}


function compartirTorneo() {
  const url = window.location.href;
  if (navigator.share) {
    navigator.share({ title: TORNEO_ACTUAL ? TORNEO_ACTUAL.nombre : 'ACTIVA PLAY', url: url });
  } else if (navigator.clipboard) {
    navigator.clipboard.writeText(url).then(function() { toast('Link copiado', 'ok'); });
  }
}
