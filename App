// ─── NOTICIAS ────────────────────────────────────────────────────────────────
function fmtFechaNoticia(raw) {
  if (!raw) return '';
  const clean = cleanFecha(raw);
  if (!clean) return '';
  const d = new Date(clean + 'T12:00:00');
  if (isNaN(d)) return '';
  return d.toLocaleDateString('es-CL', { day:'numeric', month:'long', year:'numeric' });
}

