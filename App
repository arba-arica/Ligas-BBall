/**
 * Maneja el envío del formulario de solicitud de publicación de liga.
 * @param {Event} e El evento de envío del formulario.
 */
async function enviarSolicitud(e) {
  e.preventDefault();
  const errEl = document.getElementById('sol-error');
  const btn   = document.getElementById('sol-btn');
  errEl.style.display = 'none';
  btn.disabled = true; btn.textContent = 'Enviando...';

  const nombre = document.getElementById('sol-nombre').value.trim();
  const email = document.getElementById('sol-email').value.trim();
  const tel = document.getElementById('sol-tel').value.trim();
  const ciudad = document.getElementById('sol-ciudad').value.trim();
  const deporte = document.getElementById('sol-deporte').value.trim();
  const desc = document.getElementById('sol-desc').value.trim();
  const categorias = document.getElementById('sol-cats').value;

  if (!nombre || !email || !ciudad || !deporte) {
    errEl.textContent = 'Por favor, completa todos los campos requeridos.';
    errEl.style.display = 'block';
    btn.disabled = false; btn.textContent = 'ENVIAR SOLICITUD';
    return;
  }

  try {
    // Simular envío a la API. En un caso real, esto enviaría los datos a tu backend.
    // const json = await api('enviarSolicitud', { nombre, email, tel, ciudad, deporte, desc, categorias });
    // if (json.success) { ... } else { ... }

    // Simulación de éxito
    await new Promise(resolve => setTimeout(resolve, 1000)); // Simular retardo de red
    document.getElementById('sol-form-wrap').style.display = 'none';
    document.getElementById('sol-email-confirm').textContent = email;
    document.getElementById('sol-success').style.display = 'block';
    toast('Solicitud enviada con éxito', 'ok');

  } catch(err) {
    errEl.textContent = 'Error al enviar la solicitud. Intenta de nuevo.';
    errEl.style.display = 'block';
  } finally {
    btn.disabled = false; btn.textContent = 'ENVIAR SOLICITUD';
  }
}


