async function loadTorneos(){
  var list=document.getElementById('torneos-list');
  try{
    var torneos=await supa('torneos','?select=id,nombre,ciudad,deporte,temporada,descripcion,visible&visible=eq.true&estado=neq.eliminado&order=created_at.desc');
    if(!torneos||torneos.error||!torneos.length){list.innerHTML='<div style="text-align:center;padding:48px 20px"><div style="font-size:48px;margin-bottom:16px;opacity:.2">🏀</div><div style="font-family:\'Oswald\',sans-serif;font-size:22px;font-weight:900;color:var(--text);margin-bottom:8px">Sin torneos activos aún</div><div style="font-size:13px;color:var(--text2);margin-bottom:20px">Sé el primero en publicar tu torneo</div><button class="btn-solid btn-orange" onclick="openModal(\'modal-solicitud\')" style="padding:12px 28px;font-size:14px;border-radius:12px">PUBLICAR MI LIGA →</button></div>';return;}
    list.innerHTML=torneos.map(function(t){return'<div class="torneo-card" onclick="abrirTorneo(\''+t.id+'\',\''+esc(t.nombre)+'\',\''+esc(t.ciudad)+'\',\''+esc(t.temporada||'')+'\')"><div class="torneo-card-header"><div><div class="torneo-nombre">'+t.nombre+'</div><div class="torneo-ciudad">📍 '+t.ciudad+(t.temporada?' · '+t.temporada:'')+'</div></div><span class="badge badge-active">● Activo</span></div>'+(t.descripcion?'<div style="font-size:13px;color:var(--text2);margin-bottom:10px">'+t.descripcion+'</div>':'')+'<div style="font-size:11px;color:var(--text3)">'+(t.deporte||'Básquetbol')+' · Toca para ver tabla y fixture →</div></div>';}).join('');
  }catch(e){list.innerHTML='<div style="text-align:center;padding:32px;color:var(--text2);font-size:13px">Error al cargar torneos</div>';}
}

async function abrirTorneo(id,nombre,ciudad,temporada){
  TORNEO_ACTUAL={id:id,nombre:nombre,ciudad:ciudad,temporada:temporada};
  document.getElementById('tv-nombre').textContent=nombre;
  document.getElementById('tv-temporada-lbl').textContent=(temporada?temporada.toUpperCase():'')+(ciudad?' · '+ciudad.toUpperCase():'');
  showView('torneo-view');
  document.querySelector('.tv-navbar').style.display='flex';
  document.querySelectorAll('.tv-nav-btn').forEach(function(b){b.classList.remove('active');});
  document.getElementById('tnav-fixture').classList.add('active');
  ['tab-fixture','tab-resultados','tab-posiciones','tab-clubes','tab-noticias','tab-sanciones','tab-programacion'].forEach(function(t){var el=document.getElementById(t);if(el){el.style.display=t==='tab-fixture'?'block':'none';el.innerHTML='';}});
  CAT_ACTUAL=null;
  await loadCategorias(id);
}

function volverPublico(){TORNEO_ACTUAL=null;document.querySelector('.tv-navbar').style.display='none';showView('pub-view');loadTorneos();}

function showTab(tabId,btn){
  document.querySelectorAll('.tv-nav-btn').forEach(function(b){b.classList.remove('active');});
  if(btn)btn.classList.add('active');
  ['tab-fixture','tab-resultados','tab-posiciones','tab-clubes','tab-noticias','tab-sanciones','tab-programacion'].forEach(function(t){var el=document.getElementById(t);if(el)el.style.display=t===tabId?'block':'none';});
  if(!TORNEO_ACTUAL)return;
  var tab=tabId.replace('tab-','');
  if(tab==='fixture')renderFixture();
  if(tab==='resultados')renderResultados();
  if(tab==='posiciones')renderPosiciones();
  if(tab==='clubes')renderClubes();
  if(tab==='noticias')renderNoticias();
  if(tab==='sanciones')renderSanciones();
  if(tab==='programacion')renderProgramacion();
}

async function loadCategorias(torneo_id){
  CATEGORIAS=[];EQUIPOS={};
  var cats=await supa('categorias','?torneo_id=eq.'+torneo_id+'&activo=eq.true&order=orden');
  CATEGORIAS=cats||[];
  var grid=document.getElementById('tv-ligas-grid');
  if(!grid)return;
  if(!CATEGORIAS.length){grid.innerHTML='<div style="color:rgba(255,255,255,.4);font-size:12px;padding:8px">Sin categorías registradas.</div>';}
  else{
    grid.innerHTML=CATEGORIAS.map(function(c,i){return'<button class="tv-liga-btn'+(i===0?' active':'')+'" data-id="'+c.id+'" onclick="selCat(this,this.dataset.id)"><div class="tv-liga-btn-name">'+c.nombre+'</div></button>';}).join('');
    CAT_ACTUAL=CATEGORIAS[0].id;
    var eqs=await supa('equipos','?categoria_id=eq.'+CATEGORIAS[0].id+'&activo=eq.true&order=nombre');
    EQUIPOS[CATEGORIAS[0].id]=eqs||[];
  }
  renderFixture();
}

function selCat(btn,catId){document.querySelectorAll('.tv-liga-btn').forEach(function(b){b.classList.remove('active');});btn.classList.add('active');CAT_ACTUAL=catId;renderTabActual();}
function getCatActual(){if(CAT_ACTUAL)return CATEGORIAS.find(function(c){return c.id===CAT_ACTUAL;})||CATEGORIAS[0]||null;return CATEGORIAS[0]||null;}
function renderTabActual(){var ab=document.querySelector('.tv-nav-btn.active');if(!ab){renderFixture();return;}var m=(ab.getAttribute('onclick')||'').match(/tab-(\w+)/);if(m)showTab('tab-'+m[1],null);else renderFixture();}

function formatFecha(str,tipo){if(!str)return'';try{var d=new Date(str);if(isNaN(d))return str;if(tipo==='corto')return d.toLocaleDateString('es-CL',{day:'2-digit',month:'short'});if(tipo==='fecha')return d.toLocaleDateString('es-CL',{day:'2-digit',month:'short',year:'numeric'});return d.toLocaleDateString('es-CL',{weekday:'short',day:'2-digit',month:'short'});}catch(e){return str;}}

function buildPartidoCard(p,finalizado){
  var local=p.local||{nombre:'?'},visita=p.visita||{nombre:'?'};
  var lWin=finalizado&&(p.pts_local>p.pts_visita),vWin=finalizado&&(p.pts_visita>p.pts_local),enVivo=p.estado==='en_vivo';
  // Fecha completa
  var fechaCompleta='';
  if(p.fecha){try{fechaCompleta=new Date(p.fecha+'T12:00:00').toLocaleDateString('es-CL',{weekday:'long',day:'2-digit',month:'long'});}catch(e){fechaCompleta=p.fecha;}}
  var hora=p.hora||'';
  var h='<div class="mc">';
  // Top: fecha + badge estado
  h+='<div class="mc-top">';
  h+='<span class="mc-top-info">'+(fechaCompleta+(hora?' · '+hora:''))+'</span>';
  if(finalizado)h+='<span class="mc-badge mc-badge-final">Final</span>';
  else if(enVivo)h+='<span class="mc-badge mc-badge-live">● En Vivo</span>';
  else h+='<span class="mc-badge mc-badge-prox">Próximo</span>';
  h+='</div>';
  // Labels Local / Visita
  h+='<div style="display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:4px;margin-bottom:4px;padding:0 2px">';
  h+='<div style="font-size:9px;font-weight:700;color:var(--blue);letter-spacing:1px;text-transform:uppercase">🏠 Local</div>';
  h+='<div></div>';
  h+='<div style="font-size:9px;font-weight:700;color:var(--orange);letter-spacing:1px;text-transform:uppercase;text-align:right">Visita ✈️</div>';
  h+='</div>';
  // Equipos + marcador
  h+='<div class="mc-teams">';
  h+='<div class="mc-team'+(lWin?' win':'')+'">'+(local.nombre)+'</div>';
  if(finalizado)h+='<div class="mc-score">'+(p.pts_local||0)+'–'+(p.pts_visita||0)+'</div>';
  else h+='<div class="mc-vs">VS</div>';
  h+='<div class="mc-team right'+(vWin?' win':'')+'">'+(visita.nombre)+'</div>';
  h+='</div>';
  // Footer centrado: nro fecha, fase, cancha
  h+='<div style="padding-top:8px;border-top:1px solid var(--border);text-align:center">';
  h+='<div class="mc-meta" style="justify-content:center">';
  h+='<span>Partido N° '+(p.nro_fecha||'—')+'</span>';
  if(p.fase&&p.fase!=='Fase Regular')h+='<span class="mc-meta-sep">·</span><span style="color:var(--orange);font-weight:700">'+p.fase+'</span>';
  if(p.cancha)h+='<span class="mc-meta-sep">·</span><span>📍 '+p.cancha+'</span>';
  h+='</div>';
  if(p.url_transmision)h+='<div style="margin-top:6px"><a href="'+p.url_transmision+'" target="_blank" class="mc-yt" style="justify-content:center">▶ Ver en vivo</a></div>';
  h+='</div></div>';
  return h;
}

async function renderFixture(){
  var el=document.getElementById('tab-fixture'),cat=getCatActual();
  if(!cat){el.innerHTML='<div style="padding:20px;color:var(--text2);text-align:center">Sin categorías.</div>';return;}
  el.innerHTML='<div style="padding:20px;text-align:center;color:var(--text2);font-size:13px">Cargando...</div>';
  var p=await supa('partidos','?categoria_id=eq.'+cat.id+'&select=*,local:equipo_local(nombre),visita:equipo_visita(nombre)&estado=neq.finalizado&order=nro_fecha,fecha,hora');
  if(!p||!p.length){el.innerHTML='<div style="padding:20px;color:var(--text2);font-size:13px;text-align:center">Sin partidos programados en '+cat.nombre+'.</div>';return;}
  var h='<div class="tv-sec-label">Próximos partidos</div>';
  p.forEach(function(x){h+=buildPartidoCard(x,false);});el.innerHTML=h;
}

