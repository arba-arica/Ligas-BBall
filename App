    </div>
    <div style="background:#111;border:1px solid rgba(249,115,22,.2);border-radius:12px;padding:16px;margin-bottom:16px;text-align:left">
      <div style="font-size:10px;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">Clave de acceso</div>
      <div style="font-family:'Barlow Condensed',sans-serif;font-size:28px;font-weight:900;color:#f97316;letter-spacing:4px">${clave}</div>
      <div style="font-size:11px;color:rgba(255,255,255,.3);margin-top:4px">Enviar al email: ${email}</div>
    </div>
    <div style="font-size:11px;color:rgba(255,255,255,.3);margin-bottom:16px;line-height:1.6">El organizador ingresa con su email y esta clave.<br>Guárdalos antes de cerrar.</div>
    <button onclick="navigator.clipboard?.writeText('ID: ${orgId}\\nClave: ${clave}').then(()=>{this.textContent='✓ Copiado'})" style="width:100%;padding:11px;border-radius:10px;background:#1d4ed8;border:none;color:#fff;font-family:'Barlow Condensed',sans-serif;font-size:15px;font-weight:700;cursor:pointer;margin-bottom:8px;letter-spacing:.5px">COPIAR CREDENCIALES</button>
