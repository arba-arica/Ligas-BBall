    if(s.org_id)h+='<div class="org-id-display"><div><div style="font-size:10px;color:var(--text2);margin-bottom:2px">ORG ID</div><div class="org-id-val">'+s.org_id+'</div></div><div><div style="font-size:10px;color:var(--text2);margin-bottom:2px">Clave</div><div class="org-clave">'+(s.clave_acceso||'—')+'</div></div></div>';
    if(ip)h+='<div style="display:flex;gap:8px;margin-top:8px"><button class="btn-sm btn-sm-primary" style="flex:1;padding:8px" onclick="aprobarSolicitud(\''+s.id+'\',\''+s.nombre.replace(/'/g,"\\'")+'\')">✓ Aprobar</button><button class="btn-sm" style="flex:1;padding:8px" onclick="rechazarSolicitud(\''+s.id+'\')">✕ Rechazar</button></div>';
