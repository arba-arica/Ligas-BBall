    +'3. Deja Equipo Local / Visita en blanco si aún no se define (ej. semifinal/final pendiente) — luego se asigna con el botón "Asignar equipo"<br>'
    +'4. Sube el archivo completado'
    +'</div>'
    +'<div style="margin-bottom:12px"><button class="btn-sm" style="background:var(--green);color:#fff" onclick="descargarPlantillaCSV()">Descargar plantilla XLS</button></div>'
    +'<div class="f-group"><label class="f-label">Subir archivo XLS completado</label>'
    +'<input type="file" id="csv-file" accept=".xlsx,.xls" class="f-input" style="padding:8px"></div>'
    +'<div id="csv-preview" style="margin-top:10px;font-size:12px;color:var(--text2)"></div>'
    +'<button class="f-submit" id="csv-btn" style="display:none;margin-top:12px" onclick="procesarCSV()">IMPORTAR PARTIDOS</button>';
  openInlineModal(html);
  setTimeout(function(){
    var fi=document.getElementById('csv-file');
    if(!fi)return;
    fi.addEventListener('change',function(e){
      var file=e.target.files[0];
      if(!file)return;
      var reader=new FileReader();
      reader.onload=function(ev){
        try{
          // Leer XLSX con SheetJS
          var data=new Uint8Array(ev.target.result);
          var wb=XLSX.read(data,{type:'array',cellDates:true});
          var ws=wb.Sheets[wb.SheetNames[0]];
          var rows=XLSX.utils.sheet_to_json(ws,{header:1,defval:''});
          // Filtrar filas vacías, filas de referencia y quitar header
          var dataRows=rows.slice(1).filter(function(r){
            var c0=String(r[0]||'').trim();
            if(!c0)return false;
            if(c0.indexOf('Equipos ')===0||c0.indexOf('—')===0)return false;
            return r.some(function(v){return String(v||'').trim();});
          });
          window._xlsRows=dataRows;
          var prev=document.getElementById('csv-preview');
          var btn=document.getElementById('csv-btn');
          if(dataRows.length===0){
            if(prev)prev.innerHTML='<div style="color:var(--red);padding:8px">No se encontraron partidos en el archivo.</div>';
            return;
          }
          // Preview primeras 3 filas
          var previewHtml='<div style="background:var(--bg3);border-radius:8px;padding:10px">';
          previewHtml+='<b style="color:var(--text)">'+dataRows.length+' partidos detectados</b>';
          previewHtml+='<div style="margin-top:8px;font-size:11px;color:var(--text2)">';
          dataRows.slice(0,3).forEach(function(r){
            var loc=xlsCellStr(r[7])||'Por definir',vis=xlsCellStr(r[8])||'Por definir',fch=xlsCellStr(r[2]);
            previewHtml+='<div style="padding:2px 0">['+xlsCellStr(r[0])+'] '+loc+' vs '+vis+(fch?' · '+fch:'')+'</div>';
          });
          if(dataRows.length>3)previewHtml+='<div>... y '+(dataRows.length-3)+' más</div>';
          previewHtml+='</div></div>';
          if(prev)prev.innerHTML=previewHtml;
          if(btn)btn.style.display='block';
        }catch(err){
          var prev=document.getElementById('csv-preview');
          if(prev)prev.innerHTML='<div style="color:var(--red);padding:8px">Error al leer el archivo: '+err.message+'</div>';
        }
      };
      reader.readAsArrayBuffer(file);
    });
  },200);
}

async function procesarCSV(){
  var rows=window._xlsRows||[];
  if(!rows.length){toast('Carga un archivo primero','err');return;}
  var btn=document.getElementById('csv-btn');
  if(btn){btn.disabled=true;btn.textContent='Importando...';}
  // Mapa categoria nombre -> id
  var cats=await getCats();
  var cMap={};
  cats.forEach(function(c){cMap[c.nombre.toLowerCase().trim()]=c.id;});
  // Mapa equipos por categoria: catId + '||' + nombre -> id
  var eMap={};
  for(var c=0;c<cats.length;c++){
    var re=await api('getEquiposCategoria',{categoria_id:cats[c].id});
    var eqs=(re.success&&re.data)?re.data:[];
    eqs.forEach(function(e){eMap[cats[c].id+'||'+e.nombre.toLowerCase().trim()]=e.id;});
  }
  var errors=[];
  var imported=0;
  var catsAfectadas={};
  for(var i=0;i<rows.length;i++){
    var cols=rows[i].map(function(v){return xlsCellStr(v);});
    if(cols.length<9)continue;
    // Columnas: 0=Categoria, 1=NroFecha, 2=Fecha, 3=Hora, 4=Cancha, 5=Fase, 6=Grupo, 7=Local, 8=Visita
    var catId=cMap[cols[0].toLowerCase().trim()];
    if(!catId){
      errors.push('Fila '+(i+2)+': categoría no encontrada ("'+cols[0]+'")');
      continue;
    }
    // Equipo local/visita: pueden venir en blanco (partido "por definir", ej. semifinal/final)
    var localId=cols[7]?eMap[catId+'||'+cols[7].toLowerCase().trim()]:null;
    var visitaId=cols[8]?eMap[catId+'||'+cols[8].toLowerCase().trim()]:null;
    if(cols[7]&&!localId){errors.push('Fila '+(i+2)+' ['+cols[0]+']: equipo local no encontrado ("'+cols[7]+'")');continue;}
    if(cols[8]&&!visitaId){errors.push('Fila '+(i+2)+' ['+cols[0]+']: equipo visita no encontrado ("'+cols[8]+'")');continue;}
    if(localId&&visitaId&&localId===visitaId){errors.push('Fila '+(i+2)+': local y visita iguales');continue;}
    var r=await api('crearPartido',{
      categoria_id:catId,
      nro_fecha:parseInt(cols[1])||1,
      fecha:cols[2]||null,
      hora:cols[3]||null,
      cancha:cols[4]||null,
      fase:cols[5]||'Fase Regular',
      grupo:cols[6]||null,
      equipo_local:localId,
      equipo_visita:visitaId
    });
    if(r.success){imported++;catsAfectadas[catId]=true;}
    else errors.push('Fila '+(i+2)+': '+r.message);
  }
  closeInlineModal();
  if(errors.length){toast(imported+' importados, '+errors.length+' errores','err');console.warn(errors);}
  else toast(imported+' partidos importados','ok');
  var catActual=document.getElementById('fx-cat-sel')?document.getElementById('fx-cat-sel').value:'';
  if(catActual)cargarFixturePanel(catActual);
}


async function renderProgramacion(){
  var el=document.getElementById('tab-programacion');
  if(!el)return;
  if(!TORNEO_ACTUAL){el.innerHTML='';return;}
  el.innerHTML='<div style="padding:20px;text-align:center;color:var(--text2);font-size:13px">Cargando programación...</div>';
  // Un solo fetch para todos los partidos del torneo con joins
  var data=[];
  try{
    // Primero cargar categorías si no están
    if(!CATEGORIAS||!CATEGORIAS.length){
      var cr0=await fetch(SUPA_URL+'/rest/v1/categorias?torneo_id=eq.'+TORNEO_ACTUAL.id+'&activo=eq.true&order=orden',
        {headers:{apikey:SUPA_ANON,Authorization:'Bearer '+SUPA_ANON}});
      var cd0=await cr0.json();
