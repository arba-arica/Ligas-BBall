function renderResAdm() {
  const el = document.getElementById('res-adm-list');
  const cuartosA = ['1° Cuarto','2° Cuarto','3° Cuarto','4° Cuarto'];
  const todos = [...D.partidos].sort((a,b) => new Date(cleanFecha(a.Fecha)+'T12:00:00') - new Date(cleanFecha(b.Fecha)+'T12:00:00'));
  if (!todos.length) { el.innerHTML = empty('🏀','Sin partidos cargados'); return; }
  const programados = todos.filter(p => p.Estado === 'Programado' || cuartosA.indexOf(p.Estado) >= 0);
  const finalizados = todos.filter(p => p.Estado === 'Finalizado');
  let html = '';
  if (programados.length) {
    html += '<div style="font-size:10px;font-weight:700;color:var(--muted2);letter-spacing:.6px;text-transform:uppercase;margin-bottom:10px">Programados / En curso</div>';
    html += programados.map(p => {
      const liga = ligaObj(p.ID_Liga);
      return `<div class="result-row">
        <div class="result-label" style="text-align:center;margin-bottom:8px">
          <strong>${teamName(p.ID_EquipoLocal)}</strong> vs <strong>${teamName(p.ID_EquipoVisita)}</strong><br>
          <span style="font-size:11px;color:var(--muted)">${fmtDate(p.Fecha)}${fmtTime(p.Hora)?' · '+fmtTime(p.Hora):''} · ${liga?liga.NombreFantasia:''}</span>
        </div>
        <div class="result-inputs" style="justify-content:center">
          <input class="score-in" type="number" id="gl-${p.ID}" value="${p.GolesLocal||p.PuntosLocal||''}" placeholder="0" min="0">
          <div class="score-dash">—</div>
          <input class="score-in" type="number" id="gv-${p.ID}" value="${p.GolesVisita||p.PuntosVisita||''}" placeholder="0" min="0">
          <select class="st-sel" id="st-${p.ID}">
            <option value="Programado"${p.Estado==='Programado'?' selected':''}>Programado</option>
            <option value="1° Cuarto"${p.Estado==='1° Cuarto'?' selected':''}>1° Cuarto</option>
            <option value="2° Cuarto"${p.Estado==='2° Cuarto'?' selected':''}>2° Cuarto</option>
            <option value="3° Cuarto"${p.Estado==='3° Cuarto'?' selected':''}>3° Cuarto</option>
            <option value="4° Cuarto"${p.Estado==='4° Cuarto'?' selected':''}>4° Cuarto</option>
            <option value="Finalizado"${p.Estado==='Finalizado'?' selected':''}>Finalizado</option>
          </select>
          <button class="save-btn" onclick="saveResult('${p.ID}')">OK</button>
