gasCall = async function(action, data) {
  try {
    const res = await callGAS(action, data);
    if (res && res.success) {
      await refreshData();
      renderAll();
      if (adminPass) {
    renderAdmin();
    // Mostrar solicitudes solo para super_admin
    const esSuper = window._userRol === 'super_admin' || !window._userRol;
    if (esSuper) {
      const btnSol = document.getElementById('btn-solicitudes');
      if (btnSol) btnSol.style.display = 'flex';
      loadSolicitudes();
    }
  }
      closeConfirmV3();
    } else {
      toast(res?.message || 'Error', 'err');
      closeConfirmV3();
    }
    return res;
  } catch(e) {
    toast('Error: ' + e.message, 'err');
    closeConfirmV3();
  }
};

